#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

api_port="${EQUINOX_API_PORT:-8180}"
api_root="http://127.0.0.1:${api_port}"

launch_if_missing() {
  local name="$1"
  local algorithm="$2"
  local width="$3"
  if curl --fail --silent --show-error "${api_root}/v1/runs" |
    python3 -c '
import json, sys
name = sys.argv[1]
raise SystemExit(0 if any(item["name"] == name for item in json.load(sys.stdin)["items"]) else 1)
' "$name"; then
    return
  fi
  curl --fail --silent --show-error \
    --request POST "${api_root}/v1/runs" \
    --header 'Content-Type: application/json' \
    --data "{\"name\":\"${name}\",\"algorithm\":\"${algorithm}\",\"branch\":{\"width\":${width}}}" \
    >/dev/null
}

launch_if_missing "Local independent baseline" "independent_rollout_baseline" 1
launch_if_missing "Local branch-aware CAD proof" "bpo_local_metric" 4

for _ in $(seq 1 180); do
  if response="$(curl --fail --silent --show-error "${api_root}/v1/runs")"; then
    summary="$(
      printf '%s' "$response" | python3 -c '
import json, sys
items = json.load(sys.stdin)["items"]
expected = {
    "Local independent baseline",
    "Local branch-aware CAD proof",
}
selected = [item for item in items if item["name"] in expected]
print(" ".join("{}:{}".format(item["algorithm"], item["status"]) for item in selected))
raise SystemExit(
    0 if len(selected) == 2 and all(item["status"] == "SUCCEEDED" for item in selected) else 1
)
'
    )" && {
      echo "Seeded CAD runs completed: ${summary}"
      echo "Open http://127.0.0.1:${EQUINOX_DASHBOARD_PORT:-3100}/runs"
      exit 0
    }
  fi
  sleep 1
done

echo "Timed out waiting for deterministic CAD runs." >&2
docker compose logs --no-color --tail=120 orchestrator fixture-worker execution >&2
exit 1
