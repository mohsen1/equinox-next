#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$repository_root/.venv/bin/python3" ]]; then
  PATH="$repository_root/.venv/bin:$PATH"
fi
preflight_only=""
if (($# > 1)); then
  echo "Usage: $0 [--preflight-only]" >&2
  exit 64
fi
if (($# == 1)); then
  if [[ "$1" != "--preflight-only" ]]; then
    echo "Usage: $0 [--preflight-only]" >&2
    exit 64
  fi
  preflight_only=1
fi

python3 "$repository_root/research/runpod/larger_model_gate.py" manifest >/dev/null
python3 "$repository_root/research/runpod/larger_model_gate.py" verify-sources >/dev/null
python3 "$repository_root/research/runpod/larger_model_gate.py" verify-model >/dev/null
timeout --kill-after=5 30 runpodctl gpu list --include-unavailable |
  jq '[.[] | select(.gpuId == "NVIDIA H100 80GB HBM3")]' |
  python3 "$repository_root/research/runpod/larger_model_gate.py" inventory - >/dev/null

export EQUINOX_LARGER_MODEL_MODE=screen
export EQUINOX_RL_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
export EQUINOX_RUNPOD_GPU="NVIDIA H100 80GB HBM3"
export EQUINOX_RUNPOD_CLOUD_TYPE=SECURE
export EQUINOX_RUNPOD_CONTAINER_DISK_GB=50
export EQUINOX_RUNPOD_VOLUME_GB=50
export EQUINOX_RUNPOD_MIN_GPU_MEMORY_GB=80
export EQUINOX_RUNPOD_MAX_HOURLY_COST=4.00
export EQUINOX_RUNPOD_MAX_TOTAL_COST=3.35
export EQUINOX_RUNPOD_MAX_LIFETIME_MINUTES=48
export EQUINOX_RUNPOD_BOOT_TIMEOUT_SECONDS=600
export EQUINOX_RUNPOD_MODEL_LOAD_TIMEOUT_SECONDS=1200
export EQUINOX_RUNPOD_STALE_PROGRESS_SECONDS=600
export EQUINOX_RUNPOD_MAX_WORKLOAD_ATTEMPTS=1
export EQUINOX_RL_SEED=137
export EQUINOX_RL_TARGET_SECONDS=1500
export EQUINOX_RL_MAX_UPDATES=1
export EQUINOX_RL_VALIDATION_EXAMPLES=8
export EQUINOX_RL_TEST_EXAMPLES=0
export EQUINOX_RL_MASTERY_WINDOWS=1
export EQUINOX_RL_TRAINING_TASKS_PER_UPDATE=8
export EQUINOX_RL_REPLAY_TASKS_PER_LEVEL=1
export EQUINOX_RUNPOD_RETRY_RESERVE_SECONDS=300
export EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS=300
export EQUINOX_LARGER_MODEL_LIVE_STAGE_REVISION=authenticated-proxy-stage-activation@2
export EQUINOX_RUNPOD_CAMPAIGN_BASELINE_BALANCE_USD=45.2834247943
export EQUINOX_RUNPOD_CAMPAIGN_AUTHORIZED_BUDGET_USD=25.00
export EQUINOX_RUNPOD_CAMPAIGN_FUTURE_PILOT_RESERVE_USD=13.00
export EQUINOX_RUNPOD_CAMPAIGN_STORAGE_RESERVE_USD=0.30
if [[ "$preflight_only" == "1" ]]; then
  export EQUINOX_RUNPOD_PREFLIGHT_ONLY=1
fi

exec "$repository_root/scripts/runpod-rl-proof"
