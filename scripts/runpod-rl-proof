  if ! confirm_managed_network_volume_deletion; then
    echo "Pilot storage teardown is unknown or spend remains nonzero; refusing confirmed teardown." >&2
    exit 1
  fi
  if [[ "$volume_expiry_guard_active" == true ]]; then
    write_volume_expiry_guard_state \
      "volume-deletion-confirmed" 0 "$proof_id" ""
  fi
  last_progress="$(
    jq -c \
      --argjson deletion_required "$network_volume_deletion_required" \
      --arg deletion_deadline "$network_volume_deletion_deadline" \
      --argjson deletion_attempted "$network_volume_deletion_attempted" \
      --argjson deletion_confirmed "$network_volume_deletion_confirmed" \
      --argjson deletion_deadline_met "$network_volume_deletion_deadline_met" \
      --arg deleted_at "$network_volume_deleted_at" \
