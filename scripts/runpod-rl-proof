if ! jq -e \
  --arg expected_model "$model_id" \
  --arg expected_workload_revision "$expected_workload_revision" \
  --arg expected_objective_id "$expected_objective_id" \
  --arg expected_environment_revision "$expected_environment_revision" \
  --arg expected_algorithm "$expected_algorithm" \
  --arg expected_study_condition "$study_condition" \
  --arg expected_study_revision "$study_revision" \
  --arg expected_study_id "$expected_study_id" \
  --arg expected_complexity_strategy "$expected_complexity_strategy" \
  --arg expected_mastery_window_basis "$expected_mastery_window_basis" \
  --arg expected_frontier_probe_routing "$expected_frontier_probe_routing" \
  --arg expected_training_level_allocation "$expected_training_level_allocation" \
  --arg expected_action_protocol_revision "$expected_action_protocol_revision" \
  --arg expected_shared_prefix_checkpoint "$expected_shared_prefix_checkpoint" \
  --arg expected_authorization_digest "$larger_model_authorization_digest" \
  --arg expected_snapshot_digest "$larger_model_expected_snapshot_digest" \
  --arg expected_source_contract_digest "$larger_model_source_contract_digest" \
  --arg expected_network_volume_id "$network_volume_id" \
  --argjson expected_branch_width "$expected_branch_width" \
  --argjson expected_optimization_seed "$optimization_seed" \
  --argjson expected_validation_seed_base "${study_validation_seed_base:-null}" \
  --argjson expected_test_seed_base "${study_test_seed_base:-null}" \
  --argjson expected_completion_budget "${study_completion_budget:-null}" \
  --argjson expected_validation_examples "$validation_examples" \
  --argjson expected_test_examples "$test_examples" \
  --argjson expected_mastery_windows "$mastery_windows" \
  --argjson expected_training_tasks_per_update "$training_tasks_per_update" \
  --argjson expected_replay_tasks_per_level "$replay_tasks_per_level" \
  --argjson expected_maximum_updates "$maximum_updates" \
  --argjson expected_final_evaluation_reserve "$maximum_final_evaluation_reserve_seconds" \
  "$proof_assertion" >/dev/null <<<"$metrics"; then
  failure_message="The remote result did not satisfy the declared proof contract."
  echo "The remote workload completed but did not meet the proof assertions." >&2
  jq . <<<"$metrics" >&2
  exit 1
fi
if [[ "$experiment" == "repository-repair" &&
  "$study_eligibility_only" != "1" &&
  "$larger_model_mode" != "screen" ]] &&
  [[ "$(jq -r '.stop_reason' <<<"$metrics")" == "final_evaluation_reserve_ceiling" ]]; then
  if [[ "$(jq -r '.probative_post_training' <<<"$metrics")" == "true" ]]; then
    echo \
      "Remote result is probative: training stopped early after the evaluation reserve exceeded its ceiling." \
      >&2
  else
    if [[ "$(jq -r '.updates_completed' <<<"$metrics")" == "0" ]]; then
      echo \
        "Remote result is valid but non-probative: evaluation reserve exceeded its ceiling before training." \
        >&2
    else
      echo \
        "Remote result is valid but non-probative: reserve ceiling stopped training before enough learning evidence accrued." \
        >&2
    fi
  fi
fi

if [[ "$larger_model_mode" == "screen" ]]; then
  last_progress="$(
    jq -cn \
      --argjson result "$metrics" \
      '{
        phase: "finalizing",
        message: "Eligibility recorded; confirming teardown.",
        branch_width: $result.branch_width,
        complexity_strategy: "adaptive",
        elapsed_seconds: $result.elapsed_seconds,
        eligible: $result.eligible,
        profile_id: $result.profile_id,
        model_revision: $result.model_revision,
        branch_checkpoint_rate: $result.branch_checkpoint_rate,
        informative_group_rate: $result.informative_group_rate,
        peak_reserved_vram_fraction: $result.peak_reserved_vram_fraction,
        policy_mutation_detected: $result.policy_mutation_detected,
        gate_results: $result.gate_results,
        ineligibility_reasons: $result.ineligibility_reasons,
        test_split_accessed: false
      }'
  )"
elif [[ "$study_eligibility_only" == "1" ]]; then
  last_progress="$(
    jq -cn \
      --argjson result "$metrics" \
      '{
        phase: "finalizing",
        message: "Protocol eligibility recorded; confirming RunPod teardown.",
        branch_width: $result.branch_width,
        complexity_strategy: "adaptive",
        current_level: 0,
        elapsed_seconds: $result.elapsed_seconds,
        study_id: $result.study_id,
        study_condition: $result.condition,
        optimization_seed: $result.optimization_seed,
        action_protocol_validity_rate: $result.action_protocol_validity_rate,
        minimum_protocol_validity_rate: $result.minimum_protocol_validity_rate,
        protocol_eligible: $result.protocol_eligible,
        training_started: false,
        test_split_accessed: false
      }'
  )"
else
  last_progress="$(
    jq -c \
      --argjson result "$metrics" \
      '
        ($result.reached_complexity_level // .current_level // 0) as $level
        | . + {
            phase: "finalizing",
            message: "Result persisted; confirming RunPod teardown.",
            update: ($result.updates_completed // .update // 0),
            current_level: $level,
            promotion_count: ($result.promotion_count // .promotion_count // 0),
            sampled_completions: (
              $result.total_sampled_completions
              // $result.total_sampled_actions
              // .sampled_completions
              // 0
            ),
            exact_rate: (
              $result.final_by_level[($level | tostring)].exact_rate
              // $result.final_reward
              // .exact_rate
            ),
            elapsed_seconds: ($result.elapsed_seconds // .elapsed_seconds),
            stop_reason: ($result.stop_reason // .stop_reason),
            hypothesis_passed: (
              $result.hypothesis_passed // .hypothesis_passed
            )
          }
      ' <<<"$last_progress"
  )"
fi
if ! publish_execution "FINALIZING" "$last_progress"; then
  echo "Observer finalizing publish failed; persisting teardown evidence locally." >&2
fi

echo "Remote loop passed; terminating worker $pod_id." >&2
failure_message="RunPod teardown could not be confirmed."
if ! confirm_provider_teardown; then
  echo "RunPod teardown is unknown or spend remains nonzero; refusing confirmed teardown." >&2
  exit 1
fi
provider_teardown_confirmed=true
completed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
pod_id=""

receipt_path="$receipt_directory/$proof_id.json"
result_digest="$(
  python3 - "$result_path" "$repository_root" <<'PY'
import json
import sys

repository_root = sys.argv[2]
sys.path.insert(0, repository_root)
from research.runpod.larger_model_gate import result_digest

with open(sys.argv[1], encoding="utf-8") as handle:
    result = json.load(handle)
print(result_digest(result))
PY
)"
jq -n \
  --arg provider_name "RunPod" \
  --arg provider "runpod" \
  --arg provider_handle "$provider_handle" \
  --arg provider_cli_version "$(run_provider_command 15 runpodctl version | awk '{print $2}')" \
  --arg gpu_id "$gpu_id" \
  --arg image "$image" \
  --arg cloud_type "$cloud_type" \
  --arg data_center_ids "$data_center_ids" \
  --arg network_volume_id "$network_volume_id" \
  --arg network_volume_data_center_id "$network_volume_data_center_id" \
  --arg volume_readiness_receipt_digest "$volume_readiness_receipt_digest" \
  --argjson persistent_volume_in_gb "$persistent_volume_in_gb" \
  --argjson hourly_cost "$hourly_cost" \
  --arg started_at "$started_at" \
  --arg completed_at "$completed_at" \
  --arg result_digest "$result_digest" \
  --argjson result "$metrics" \
  '{
    provider: $provider,
    provider_name: $provider_name,
    provider_handle: $provider_handle,
    provider_cli_version: $provider_cli_version,
    resource_profile: {
      gpu_id: $gpu_id,
      gpu_count: 1,
      image: $image,
      hourly_cost_usd: $hourly_cost,
      cloud_type: $cloud_type,
      data_center_ids: (
        if $data_center_ids == ""
        then null
        else ($data_center_ids | split(","))
        end
      ),
      persistent_volume_in_gb: $persistent_volume_in_gb,
      network_volume_id: (
        if $network_volume_id == "" then null else $network_volume_id end
      ),
      network_volume_data_center_id: (
        if $network_volume_data_center_id == ""
        then null
        else $network_volume_data_center_id
        end
      ),
      volume_readiness_receipt_digest: (
        if $volume_readiness_receipt_digest == ""
        then null
        else $volume_readiness_receipt_digest
        end
      )
    },
    profile_id: ($result.profile_id // null),
    model_id: ($result.model_id // null),
    model_revision: ($result.model_revision // null),
    screen_workload_revision: (
      if $result.workload == "repository-repair-larger-model-eligibility-screen"
      then $result.workload_revision
      else null
      end
    ),
    gpu_id: $gpu_id,
    result_digest: $result_digest,
    workload: {
      id: $result.workload,
      revision: $result.workload_revision,
      algorithm: $result.algorithm,
      static_branch_width: $result.branch_width,
      complexity_strategy: $result.complexity_strategy,
      scale_case_count: ($result.test_case_count // null),
      maximum_horizon: ($result.maximum_horizon // null),
      total_action_decisions: ($result.total_action_decisions // null),
      model_id: ($result.model_id // null),
      model_revision: ($result.model_revision // null),
      task_domains: ($result.task_domains // null),
      maximum_complexity_level: ($result.maximum_complexity_level // null),
      reached_complexity_level: ($result.reached_complexity_level // null),
      total_sampled_completions: ($result.total_sampled_completions // null),
      total_sampled_actions: ($result.total_sampled_actions // null),
      multi_step: ($result.multi_step // null),
      restored_continuations: ($result.restored_continuations // null),
      snapshot_fidelity: ($result.snapshot_fidelity // null),
      replay_enabled: ($result.replay_enabled // null)
    },
    result: $result,
    started_at: $started_at,
    completed_at: $completed_at,
    teardown_confirmed: true
  }' >"$receipt_path"

if [[ "$larger_model_mode" == "screen" ]]; then
  last_progress="$(
    jq -c \
      '. + {
        phase: "complete",
        message: "Eligibility recorded and teardown confirmed.",
        error: null
      }' <<<"$last_progress"
  )"
  failure_message="The completed larger-model eligibility screen could not be published."
  publish_execution "SUCCEEDED" "$last_progress" "$completed_at" "true"
elif [[ "$study_eligibility_only" == "1" ]]; then
  last_progress="$(
    jq -c \
      '. + {
        phase: "complete",
        message: "Protocol eligibility recorded and provider teardown confirmed.",
        error: null
      }' <<<"$last_progress"
  )"
  failure_message="The completed eligibility screen could not be published."
  publish_execution "SUCCEEDED" "$last_progress" "$completed_at" "true"
else
  failure_message="A verified local proof receipt is pending ingestion."
  proof_ingested=false
  proof_payload="$(
    jq '{
      provider_name,
      provider_handle,
      provider_cli_version,
      resource_profile,
      workload,
      result,
      started_at,
      completed_at,
      teardown_confirmed
    }' "$receipt_path"
  )"
  for attempt in 1 2 3; do
    if proof_response="$(
      curl --fail --silent --show-error --max-time 60 \
        -X POST "$api_root/internal/research-compute-proofs" \
        -H "Authorization: Bearer $internal_token" \
        -H 'Content-Type: application/json' \
        --data-binary @- <<<"$proof_payload"
    )"; then
      jq . <<<"$proof_response"
      proof_ingested=true
      break
    fi
    if ((attempt < 3)); then
      sleep 2
    fi
  done
  if [[ "$proof_ingested" != true ]]; then
    exit 1
  fi
fi
terminal_published=true
echo "Sanitized receipt: $receipt_path" >&2
