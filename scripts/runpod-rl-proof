stale_progress_timeout_seconds="${EQUINOX_RUNPOD_STALE_PROGRESS_SECONDS:-$default_stale_progress_timeout_seconds}"
maximum_workload_attempts="${EQUINOX_RUNPOD_MAX_WORKLOAD_ATTEMPTS:-$default_maximum_workload_attempts}"
larger_model_authorization_digest="${EQUINOX_LARGER_MODEL_AUTHORIZATION_DIGEST:-}"
larger_model_screen_result="${EQUINOX_LARGER_MODEL_SCREEN_RESULT:-}"
larger_model_screen_receipt="${EQUINOX_LARGER_MODEL_SCREEN_RECEIPT:-}"
larger_model_screen_result_digest=""
larger_model_expected_snapshot_digest=""
larger_model_source_contract_digest=""
volume_readiness_receipt="${EQUINOX_LARGER_MODEL_VOLUME_RECEIPT:-}"
volume_readiness_receipt_digest=""
maximum_lifetime_minutes="${EQUINOX_RUNPOD_MAX_LIFETIME_MINUTES:-$default_maximum_lifetime_minutes}"
boot_timeout_seconds="${EQUINOX_RUNPOD_BOOT_TIMEOUT_SECONDS:-360}"
container_disk_in_gb="${EQUINOX_RUNPOD_CONTAINER_DISK_GB:-$default_container_disk_in_gb}"
persistent_volume_in_gb="${EQUINOX_RUNPOD_VOLUME_GB:-$default_persistent_volume_in_gb}"
network_volume_id="${EQUINOX_RUNPOD_NETWORK_VOLUME_ID:-}"
network_volume_data_center_id=""
