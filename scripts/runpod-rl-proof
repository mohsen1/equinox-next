receipt_directory="${EQUINOX_RESEARCH_PROOF_DIR:-$repository_root/var/research-proofs}"
if [[ "$receipt_directory" != /* || "$receipt_directory" == *$'\n'* ]]; then
  echo "EQUINOX_RESEARCH_PROOF_DIR must be an absolute single-line path." >&2
  exit 1
fi
api_root="${EQUINOX_API_ROOT:-http://127.0.0.1:8180}"
