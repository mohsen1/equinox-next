    bundle_stage_receipt_digest=sys.argv[5],
    bootstrap_source_digest=sys.argv[6],
    volume_readiness_receipt_digest=sys.argv[7],
    torch_retention_evidence_digest=sys.argv[8],
    dependency_lock_digest=sys.argv[9],
    dependency_quarantine_evidence_digest=sys.argv[10],
    dependency_private_tree_digest=sys.argv[11],
