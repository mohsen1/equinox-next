run_provider_command() {
  local duration="$1"
  shift
  timeout --kill-after=5 "$duration" "$@"
}

verify_pinned_image_tag() {
  local registry_image_index
  local verified_image_identity
  local observed_image
  local observed_digest
  if ! registry_image_index="$(
    run_provider_command 60 \
      docker buildx imagetools inspect "$image" --format '{{json .Manifest}}'
  )"; then
    echo "The pinned container image could not be inspected in its registry." >&2
    return 1
  fi
  if ! verified_image_identity="$(
    python3 "$repository_root/research/runpod/larger_model_gate.py" \
      verify-image-index - <<<"$registry_image_index"
  )"; then
    echo "The container registry did not return the exact pinned image manifest." >&2
    return 1
  fi
  observed_image="$(jq -r '.image // empty' <<<"$verified_image_identity")"
  observed_digest="$(jq -r '.image_digest // empty' <<<"$verified_image_identity")"
  if [[ "$observed_image" != "$image" ||
    "$observed_digest" != "$expected_image_digest" ]]; then
    echo "The verified container image identity does not match the immutable profile." >&2
    return 1
  fi
  verified_image_digest="$observed_digest"
}

seconds_until_deadline() {
  local deadline_epoch="$1"
  local maximum_seconds="$2"
  local current_epoch
  local remaining_seconds
  current_epoch="$(date +%s)"
  remaining_seconds=$((deadline_epoch - current_epoch))
  if ((remaining_seconds <= 0)); then
    return 1
  fi
  if ((remaining_seconds < maximum_seconds)); then
    printf '%s\n' "$remaining_seconds"
  else
    printf '%s\n' "$maximum_seconds"
  fi
}

finalize_larger_model_screen_progress() {
  local result="$1"
  jq -c \
    --argjson result "$result" \
    '
      . + {
        phase: "finalizing",
        message: "Eligibility recorded; confirming teardown.",
        branch_width: $result.branch_width,
        complexity_strategy: "adaptive",
        elapsed_seconds: $result.elapsed_seconds,
        eligible: $result.eligible,
        profile_id: $result.profile_id,
        model_revision: $result.model_revision,
        branch_checkpoint_rate: $result.branch_checkpoint_rate,
        informative_group_rate: $result.informative_group_rate,
        peak_reserved_vram_fraction: $result.peak_reserved_vram_fraction,
        policy_mutation_detected: $result.policy_mutation_detected,
        gate_results: $result.gate_results,
        ineligibility_reasons: $result.ineligibility_reasons,
        test_split_accessed: false
      }
    '
}

fsync_directory() {
  python3 - "$1" <<'PY'
import os
import sys

path = os.path.abspath(sys.argv[1])
descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
}

durable_write_stdin() {
  python3 -c '
import os
import pathlib
import sys
import tempfile

destination = pathlib.Path(sys.argv[1])
payload = sys.stdin.buffer.read()
descriptor, pending = tempfile.mkstemp(prefix=".pending-", dir=destination.parent)
try:
    os.fchmod(descriptor, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(pending, destination)
    directory = os.open(destination.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
except BaseException:
    try:
        os.unlink(pending)
    except FileNotFoundError:
        pass
    raise
' "$1"
}

durably_promote_bounded_file() {
  python3 - "$1" "$2" "$3" <<'PY'
import os
import pathlib
import stat
import sys

source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
maximum_bytes = int(sys.argv[3])
flags = (
    os.O_RDONLY
    | getattr(os, "O_CLOEXEC", 0)
    | getattr(os, "O_NOFOLLOW", 0)
    | getattr(os, "O_NONBLOCK", 0)
)
descriptor = os.open(source, flags)
try:
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_size <= 0
        or metadata.st_size > maximum_bytes
    ):
        raise SystemExit("downloaded artifact is not a bounded nonempty regular file")
    os.fsync(descriptor)
finally:
    os.close(descriptor)
os.replace(source, destination)
directory = os.open(
    destination.parent,
    os.O_RDONLY | getattr(os, "O_DIRECTORY", 0),
)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY
}

verify_remote_integrity_manifest() {
  local verification_mode="${1:-final}"
  python3 - \
    "$integrity_path" \
    "$result_path" \
    "$adapter_path" \
    "$proof_id" \
    "$workload_file" \
    "$model_id" \
    "$optimization_seed" \
    "$study_condition" \
    "$bundle_digest" \
    "$bundle_activation_digest" \
    "$larger_model_source_contract_digest" \
    "$code_private_tree_digest" \
    "$dependency_private_tree_digest" \
    "$dependency_lock_digest" \
    "$verification_mode" \
    3<<<"$transport_token" <<'PY'
import hashlib
import hmac
import json
import os
import re
import stat
import sys

(
    integrity_path,
    result_path,
    adapter_path,
    proof_id,
    workload_file,
    model_id,
    optimization_seed,
    study_condition,
    bundle_digest,
    bundle_activation_digest,
    source_contract_digest,
    code_private_tree_digest,
    dependency_private_tree_digest,
    dependency_lock_digest,
    verification_mode,
) = sys.argv[1:]
if verification_mode not in {"manifest", "final"}:
    raise SystemExit("unknown local integrity verification mode")
token = os.read(3, 4096).strip()
if re.fullmatch(rb"[0-9a-f]{64}", token) is None:
    raise SystemExit("local result authentication key is malformed")


def canonical_json(value):
    return json.dumps(
        value,
        allow_nan=False,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode()


def stable_file(path, maximum_bytes, *, capture=False):
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_size <= 0
            or before.st_size > maximum_bytes
        ):
            raise ValueError(f"{path} is not a bounded nonempty regular file")
        digest = hashlib.sha256()
        payload = bytearray() if capture else None
        observed_size = 0
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            observed_size += len(chunk)
            if observed_size > maximum_bytes:
                raise ValueError(f"{path} exceeded its size bound")
            digest.update(chunk)
            if payload is not None:
                payload.extend(chunk)
        after = os.fstat(descriptor)
        stable_fields = (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
        if (
            observed_size != before.st_size
            or any(getattr(before, key) != getattr(after, key) for key in stable_fields)
        ):
            raise ValueError(f"{path} changed while it was verified")
        return (
            "sha256:" + digest.hexdigest(),
            observed_size,
            bytes(payload) if payload is not None else None,
        )
    finally:
        os.close(descriptor)


def artifact_domain(path):
    if path == "progress.json":
        return "equinox/progress/v1"
    if path in {"result.json", "result.pending.json"}:
        return "equinox/result/v1"
    if path == "adapter.tgz" or path == "adapter" or path.startswith("adapter/"):
        return "equinox/checkpoint/v1"
    if (
        path in {"workload-attempt-count", "attempts"}
        or re.fullmatch(r"error[.]attempt-[12][.]log", path) is not None
    ):
        return "equinox/attempt/v1"
    return "equinox/journal/v1"


identity = {
    "proof_id": proof_id,
    "workload_file": workload_file,
    "model_id": model_id,
    "optimization_seed": optimization_seed,
    "study_condition": study_condition,
    "bundle_digest": bundle_digest,
    "bundle_activation_digest": bundle_activation_digest,
    "source_contract_digest": source_contract_digest,
    "code_private_tree_digest": code_private_tree_digest,
    "dependency_private_tree_digest": dependency_private_tree_digest,
    "dependency_lock_digest": dependency_lock_digest,
}
identity_digest = "sha256:" + hashlib.sha256(canonical_json(identity)).hexdigest()
_, _, manifest_payload = stable_file(
    integrity_path,
    64 * 1024 * 1024,
    capture=True,
)
try:
    manifest = json.loads(manifest_payload)
except (UnicodeDecodeError, json.JSONDecodeError) as error:
    raise SystemExit("remote integrity manifest is not valid JSON") from error
manifest_fields = {
    "schema_version",
    "revision",
    "workload_file",
    "launch_identity_digest",
    "generation",
    "parent_manifest_sha256",
    "directories",
    "artifacts",
    "hmac",
}
if (
    not isinstance(manifest, dict)
    or set(manifest) != manifest_fields
    or manifest_payload != canonical_json(manifest) + b"\n"
    or manifest.get("schema_version") != 1
    or manifest.get("revision") != "token-bound-runner-resume@1"
    or manifest.get("workload_file") != workload_file
    or manifest.get("launch_identity_digest") != identity_digest
    or not isinstance(manifest.get("generation"), int)
    or isinstance(manifest.get("generation"), bool)
    or manifest["generation"] < 0
    or (
        manifest.get("parent_manifest_sha256") is not None
        and re.fullmatch(
            r"sha256:[0-9a-f]{64}",
            str(manifest.get("parent_manifest_sha256")),
        )
        is None
    )
    or (
        manifest["generation"] == 0
        and manifest.get("parent_manifest_sha256") is not None
    )
    or (
        manifest["generation"] > 0
        and manifest.get("parent_manifest_sha256") is None
    )
    or not isinstance(manifest.get("directories"), list)
    or any(
        not isinstance(path, str)
        or path in {"", ".", ".."}
        or path.startswith("/")
        or "/../" in f"/{path}/"
        for path in manifest["directories"]
    )
    or len(set(manifest["directories"])) != len(manifest["directories"])
    or not isinstance(manifest.get("artifacts"), list)
):
    raise SystemExit("remote integrity manifest contract mismatch")
supplied_manifest_hmac = manifest["hmac"]
manifest_material = {
    key: value for key, value in manifest.items() if key != "hmac"
}
expected_manifest_hmac = (
    "hmac-sha256:"
    + hmac.new(
        token,
        b"equinox/runner-resume-manifest/v1\0"
        + canonical_json(manifest_material),
        hashlib.sha256,
    ).hexdigest()
)
if (
    not isinstance(supplied_manifest_hmac, str)
    or not hmac.compare_digest(supplied_manifest_hmac, expected_manifest_hmac)
):
    raise SystemExit("remote integrity manifest authentication failed")

artifact_fields = {
    "domain",
    "launch_identity_digest",
    "path",
    "sha256",
    "size_bytes",
    "hmac",
}
entries = {}
for entry in manifest["artifacts"]:
    if not isinstance(entry, dict) or set(entry) != artifact_fields:
        raise SystemExit("remote integrity artifact schema mismatch")
    path = entry.get("path")
    if (
        not isinstance(path, str)
        or path in {"", ".", ".."}
        or path.startswith("/")
        or "/../" in f"/{path}/"
        or path in entries
        or not isinstance(entry.get("size_bytes"), int)
        or isinstance(entry.get("size_bytes"), bool)
        or entry["size_bytes"] < 0
        or re.fullmatch(r"sha256:[0-9a-f]{64}", str(entry.get("sha256"))) is None
        or entry.get("domain") != artifact_domain(path)
        or entry.get("launch_identity_digest") != identity_digest
    ):
        raise SystemExit("remote integrity artifact contract mismatch")
    entry_material = {key: value for key, value in entry.items() if key != "hmac"}
    expected_entry_hmac = (
        "hmac-sha256:"
        + hmac.new(
            token,
            (str(entry["domain"]) + "\0").encode()
            + canonical_json(entry_material),
            hashlib.sha256,
        ).hexdigest()
    )
    if not isinstance(entry.get("hmac"), str) or not hmac.compare_digest(
        entry["hmac"],
        expected_entry_hmac,
    ):
        raise SystemExit("remote integrity artifact authentication failed")
    entries[path] = entry

required = []
if verification_mode == "final":
    required.append(("result.json", result_path, 64 * 1024 * 1024))
    if adapter_path:
        required.append(("adapter.tgz", adapter_path, 4 * 1024 * 1024 * 1024))
for remote_path, local_path, maximum_bytes in required:
    entry = entries.get(remote_path)
    if entry is None:
        raise SystemExit(f"integrity manifest omitted {remote_path}")
    digest, size, _ = stable_file(local_path, maximum_bytes)
    if entry["sha256"] != digest or entry["size_bytes"] != size:
        raise SystemExit(f"authenticated {remote_path} did not match fetched bytes")
print(
    json.dumps(
        {
            "generation": manifest["generation"],
            "manifest_sha256": "sha256:"
            + hashlib.sha256(manifest_payload).hexdigest(),
            "parent_manifest_sha256": manifest["parent_manifest_sha256"],
        },
        allow_nan=False,
        separators=(",", ":"),
        sort_keys=True,
    )
)
PY
}

accept_integrity_floor() {
  local verification="$1"
  if ! printf '%s' "$verification" |
    python3 - "$integrity_floor_path" "$proof_id" <<'PY'
import json
import os
import pathlib
import re
import stat
import sys
import tempfile

path = pathlib.Path(sys.argv[1])
proof_id = sys.argv[2]
candidate_payload = sys.stdin.buffer.read()
candidate = json.loads(candidate_payload)
fields = {"generation", "manifest_sha256", "parent_manifest_sha256"}
digest_pattern = re.compile(r"^sha256:[0-9a-f]{64}$")
if (
    not isinstance(candidate, dict)
    or set(candidate) != fields
    or not isinstance(candidate.get("generation"), int)
    or isinstance(candidate.get("generation"), bool)
    or candidate["generation"] < 0
    or digest_pattern.fullmatch(str(candidate.get("manifest_sha256"))) is None
    or (
        candidate.get("parent_manifest_sha256") is not None
        and digest_pattern.fullmatch(str(candidate["parent_manifest_sha256"])) is None
    )
):
    raise SystemExit("candidate integrity floor is malformed")


def read_existing():
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    try:
        descriptor = os.open(path, flags)
    except FileNotFoundError:
        if os.path.lexists(path):
            raise SystemExit("integrity floor path is unsafe")
        return None
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or not 0 < metadata.st_size <= 4096:
            raise SystemExit("integrity floor is not a bounded regular file")
        payload = b""
        while len(payload) < metadata.st_size:
            chunk = os.read(descriptor, metadata.st_size - len(payload))
            if not chunk:
                raise SystemExit("integrity floor was truncated")
            payload += chunk
    finally:
        os.close(descriptor)
    value = json.loads(payload)
    if (
        not isinstance(value, dict)
        or set(value)
        != {
            "schema_version",
            "revision",
            "proof_id",
            "generation",
            "manifest_sha256",
            "parent_manifest_sha256",
        }
        or value.get("schema_version") != 1
        or value.get("revision") != "launcher-integrity-floor@1"
        or value.get("proof_id") != proof_id
    ):
        raise SystemExit("persisted integrity floor contract mismatch")
    return value


existing = read_existing()
if existing is not None:
    if candidate["generation"] < existing["generation"]:
        raise SystemExit("integrity generation regressed")
    if (
        candidate["generation"] == existing["generation"]
        and candidate["manifest_sha256"] != existing["manifest_sha256"]
    ):
        raise SystemExit("integrity generation forked")
    if (
        candidate["generation"] == existing["generation"]
        and candidate["manifest_sha256"] == existing["manifest_sha256"]
    ):
        raise SystemExit(0)
    if (
        candidate["generation"] == existing["generation"] + 1
        and candidate["parent_manifest_sha256"] != existing["manifest_sha256"]
    ):
        raise SystemExit("integrity parent forked")

value = {
    "schema_version": 1,
    "revision": "launcher-integrity-floor@1",
    "proof_id": proof_id,
    **candidate,
}
payload = (
    json.dumps(
        value,
        allow_nan=False,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode()
    + b"\n"
)
path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
os.chmod(path.parent, 0o700)
descriptor, pending_name = tempfile.mkstemp(prefix=".pending-", dir=path.parent)
pending = pathlib.Path(pending_name)
try:
    os.fchmod(descriptor, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(pending, path)
    directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
finally:
    try:
        pending.unlink()
    except FileNotFoundError:
        pass
PY
  then
    return 1
  fi
  integrity_generation="$(jq -r '.generation' <<<"$verification")"
  integrity_manifest_sha256="$(jq -r '.manifest_sha256' <<<"$verification")"
  integrity_parent_manifest_sha256="$(
    jq -r '.parent_manifest_sha256 // empty' <<<"$verification"
  )"
  last_progress="$(
    jq -c \
      --argjson generation "$integrity_generation" \
      --arg manifest_sha256 "$integrity_manifest_sha256" \
      --arg parent_manifest_sha256 "$integrity_parent_manifest_sha256" \
      '. + {
        runner_integrity: {
          generation: $generation,
          manifest_sha256: $manifest_sha256,
          parent_manifest_sha256: (
            if $parent_manifest_sha256 == ""
            then null
            else $parent_manifest_sha256
            end
          )
        }
      }' <<<"$last_progress"
  )"
}

poll_remote_integrity_floor() {
  local previous_integrity_path="$integrity_path"
  local verification
  integrity_path="$remote_integrity_poll_path"
  if ! curl --fail --silent --show-error --max-time 10 \
      --max-filesize "$((64 * 1024 * 1024))" \
      -H "$remote_authorization" \
      "$proxy_root/integrity.json" 2>/dev/null |
    durable_write_stdin "$integrity_path"; then
    integrity_path="$previous_integrity_path"
    return 1
  fi
  if ! verification="$(verify_remote_integrity_manifest manifest)" ||
    ! accept_integrity_floor "$verification"; then
    integrity_path="$previous_integrity_path"
    return 1
  fi
  integrity_path="$previous_integrity_path"
}

accept_monotonic_remote_progress() {
  local observed_progress="$1"
  if ! remote_progress_freshness="$(
      python3 - \
        "$progress_floor_path" \
        "$proof_id" \
        "$integrity_generation" \
        "$maximum_workload_attempts" \
        "$maximum_updates" \
        "$((maximum_lifetime_minutes * 60))" \
        "$maximum_observed_branch_groups" \
        "$maximum_observed_sampled_completions" \
        3<<<"$observed_progress" <<'PY'
import hashlib
import json
import os
import pathlib
import stat
import sys
import tempfile

path = pathlib.Path(sys.argv[1])
proof_id = sys.argv[2]
integrity_generation = int(sys.argv[3])
maximum_attempts = int(sys.argv[4])
maximum_updates = int(sys.argv[5])
maximum_elapsed_seconds = int(sys.argv[6])
maximum_branch_groups = int(sys.argv[7])
maximum_sampled_completions = int(sys.argv[8])
with os.fdopen(3, "rb", closefd=True) as progress_stream:
    payload = progress_stream.read()
progress = json.loads(payload)
if not isinstance(progress, dict):
    raise SystemExit("remote progress must be an object")
canonical = json.dumps(
    progress,
    allow_nan=False,
    ensure_ascii=False,
    separators=(",", ":"),
    sort_keys=True,
).encode()
payload_digest = "sha256:" + hashlib.sha256(canonical).hexdigest()


def counter(*names):
    for name in names:
        if name not in progress or progress[name] is None:
            continue
        value = progress[name]
        if (
            not isinstance(value, int)
            or isinstance(value, bool)
            or value < 0
            or value > 1_000_000_000_000
        ):
            raise SystemExit(f"remote progress {name} is not a nonnegative integer")
        return value
    return None


def elapsed():
    if "elapsed_seconds" not in progress or progress["elapsed_seconds"] is None:
        return None
    value = progress["elapsed_seconds"]
    if (
        not isinstance(value, (int, float))
        or isinstance(value, bool)
        or value < 0
    ):
        raise SystemExit("remote progress elapsed_seconds is invalid")
    return value


phase = progress.get("phase")
phase_rank = {
    "container_starting": 0,
    "resuming": 0,
    "dependency_setup": 1,
    "model_loading": 2,
    "baseline_evaluation": 3,
    "protocol_evaluation": 4,
    "checkpoint_baseline_evaluation": 5,
    "checkpoint_validation_evaluation": 5,
    "training": 5,
    "eligibility_branch_collection": 5,
    "retention_guard_baseline_evaluation": 5,
    "validation_evaluation": 5,
    "checkpointing": 5,
    "finalizing": 6,
    "baseline_test_evaluation": 6,
    "final_test_evaluation": 6,
    "test_split_isolation_violation": 6,
    "complete": 7,
    "failed": 7,
}
if not isinstance(phase, str) or phase not in phase_rank:
    raise SystemExit("remote progress phase is missing")
candidate = {
    "attempt": counter("attempt"),
    "update": counter("update", "updates_completed"),
    "elapsed_seconds": elapsed(),
    "branch_groups_completed": counter("branch_groups_completed"),
    "sampled_completions": counter(
        "sampled_completions",
        "total_sampled_completions",
        "total_sampled_actions",
    ),
}
if candidate["attempt"] is None:
    raise SystemExit("remote progress attempt is missing")
if not 1 <= candidate["attempt"] <= maximum_attempts:
    raise SystemExit("remote progress attempt exceeds its launch bound")
if candidate["update"] is not None and candidate["update"] > maximum_updates:
    raise SystemExit("remote progress update exceeds its launch bound")
if (
    candidate["elapsed_seconds"] is not None
    and candidate["elapsed_seconds"] > maximum_elapsed_seconds
):
    raise SystemExit("remote progress elapsed time exceeds its provider bound")
if (
    candidate["branch_groups_completed"] is not None
    and candidate["branch_groups_completed"] > maximum_branch_groups
):
    raise SystemExit("remote progress branch groups exceed the immutable workload bound")
if (
    candidate["sampled_completions"] is not None
    and candidate["sampled_completions"] > maximum_sampled_completions
):
    raise SystemExit("remote progress sampled actions exceed the immutable workload bound")
terminal = phase in {"failed", "complete"}

same_attempt_transitions = {
    "container_starting": {"container_starting", "dependency_setup", "failed"},
    "resuming": {
        "resuming",
        "dependency_setup",
        "baseline_evaluation",
        "protocol_evaluation",
        "failed",
    },
    "dependency_setup": {"dependency_setup", "model_loading", "failed"},
    "model_loading": {"model_loading", "baseline_evaluation", "resuming", "failed"},
    "baseline_evaluation": {
        "baseline_evaluation",
        "protocol_evaluation",
        "failed",
    },
    "protocol_evaluation": {
        "protocol_evaluation",
        "training",
        "eligibility_branch_collection",
        "finalizing",
        "test_split_isolation_violation",
        "failed",
    },
    "training": {
        "training",
        "checkpoint_baseline_evaluation",
        "checkpoint_validation_evaluation",
        "retention_guard_baseline_evaluation",
        "validation_evaluation",
        "checkpointing",
        "finalizing",
        "failed",
    },
    "eligibility_branch_collection": {
        "eligibility_branch_collection",
        "finalizing",
        "failed",
    },
    "checkpoint_baseline_evaluation": {
        "checkpoint_baseline_evaluation",
        "checkpoint_validation_evaluation",
        "retention_guard_baseline_evaluation",
        "validation_evaluation",
        "checkpointing",
        "training",
        "finalizing",
        "failed",
    },
    "checkpoint_validation_evaluation": {
        "checkpoint_validation_evaluation",
        "retention_guard_baseline_evaluation",
        "validation_evaluation",
        "checkpointing",
        "training",
        "finalizing",
        "failed",
    },
    "retention_guard_baseline_evaluation": {
        "retention_guard_baseline_evaluation",
        "checkpoint_validation_evaluation",
        "validation_evaluation",
        "checkpointing",
        "training",
        "finalizing",
        "failed",
    },
    "validation_evaluation": {
        "validation_evaluation",
        "checkpoint_baseline_evaluation",
        "checkpoint_validation_evaluation",
        "retention_guard_baseline_evaluation",
        "checkpointing",
        "training",
        "finalizing",
        "failed",
    },
    "checkpointing": {
        "checkpointing",
        "training",
        "checkpoint_baseline_evaluation",
        "checkpoint_validation_evaluation",
        "retention_guard_baseline_evaluation",
        "validation_evaluation",
        "finalizing",
        "failed",
    },
    "finalizing": {
        "finalizing",
        "baseline_test_evaluation",
        "final_test_evaluation",
        "complete",
        "failed",
    },
    "baseline_test_evaluation": {
        "baseline_test_evaluation",
        "final_test_evaluation",
        "finalizing",
        "complete",
        "failed",
    },
    "final_test_evaluation": {
        "final_test_evaluation",
        "finalizing",
        "complete",
        "failed",
    },
    "test_split_isolation_violation": {
        "test_split_isolation_violation",
        "failed",
    },
    "complete": {"complete"},
    "failed": {"failed"},
}


def read_existing():
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    try:
        descriptor = os.open(path, flags)
    except FileNotFoundError:
        if os.path.lexists(path):
            raise SystemExit("progress floor path is unsafe")
        return None
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or not 0 < metadata.st_size <= 1024 * 1024:
            raise SystemExit("progress floor is not a bounded regular file")
        stored = b""
        while len(stored) < metadata.st_size:
            chunk = os.read(descriptor, metadata.st_size - len(stored))
            if not chunk:
                raise SystemExit("progress floor was truncated")
            stored += chunk
    finally:
        os.close(descriptor)
    value = json.loads(stored)
    if (
        not isinstance(value, dict)
        or set(value)
        != {
            "schema_version",
            "revision",
            "proof_id",
            "attempt",
            "update",
            "elapsed_seconds",
            "branch_groups_completed",
            "sampled_completions",
            "integrity_generation",
            "phase",
            "terminal",
            "last_payload_digest",
            "seen_payload_digests",
        }
        or value.get("schema_version") != 1
        or value.get("revision") != "launcher-progress-floor@1"
        or value.get("proof_id") != proof_id
        or not isinstance(value.get("seen_payload_digests"), list)
    ):
        raise SystemExit("persisted progress floor contract mismatch")
    return value


existing = read_existing()
freshness = "advanced"
attempt_advanced = False
if existing is not None:
    if payload_digest == existing["last_payload_digest"]:
        print("same")
        raise SystemExit(0)
    if payload_digest in existing["seen_payload_digests"]:
        raise SystemExit("remote progress replayed an older snapshot")
    if integrity_generation < existing["integrity_generation"]:
        raise SystemExit("remote progress integrity generation regressed")
    previous_attempt = existing["attempt"]
    current_attempt = candidate["attempt"]
    if current_attempt < previous_attempt or current_attempt > previous_attempt + 1:
        raise SystemExit("remote progress attempt regressed or skipped")
    attempt_advanced = current_attempt > previous_attempt
    for name, value in candidate.items():
        prior = existing[name]
        if (
            value is not None
            and prior is not None
            and value < prior
            and not (name == "elapsed_seconds" and attempt_advanced)
        ):
            raise SystemExit(f"remote progress {name} regressed")
    if existing["phase"] == "complete" and phase != "complete":
        raise SystemExit("remote progress regressed from a terminal phase")
    if attempt_advanced:
        if existing["phase"] != "failed":
            raise SystemExit("remote progress advanced attempts before a failed terminal phase")
        if phase not in {"resuming", "dependency_setup", "failed"}:
            raise SystemExit("remote progress retry did not begin at an allowed phase")
    elif phase not in same_attempt_transitions[existing["phase"]]:
        raise SystemExit("remote progress phase transition is not allowed")
    advanced = any(
        value is not None
        and (existing[name] is None or value > existing[name])
        for name, value in candidate.items()
    )
    if attempt_advanced or phase_rank[phase] > phase_rank[existing["phase"]]:
        advanced = True
    if not advanced:
        freshness = "cosmetic"
    merged = {
        name: candidate[name] if candidate[name] is not None else existing[name]
        for name in candidate
    }
    seen = [*existing["seen_payload_digests"], payload_digest]
else:
    merged = candidate
    seen = [payload_digest]
value = {
    "schema_version": 1,
    "revision": "launcher-progress-floor@1",
    "proof_id": proof_id,
    **merged,
    "integrity_generation": integrity_generation,
    "phase": phase,
    "terminal": terminal or bool(existing and existing["terminal"] and not attempt_advanced),
    "last_payload_digest": payload_digest,
    "seen_payload_digests": seen,
}
encoded = (
    json.dumps(
        value,
        allow_nan=False,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode()
    + b"\n"
)
path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
os.chmod(path.parent, 0o700)
descriptor, pending_name = tempfile.mkstemp(prefix=".pending-", dir=path.parent)
pending = pathlib.Path(pending_name)
try:
    os.fchmod(descriptor, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(encoded)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(pending, path)
    directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
finally:
    try:
        pending.unlink()
    except FileNotFoundError:
        pass
print(freshness)
PY
  )"; then
    return 1
  fi
  [[ "$remote_progress_freshness" =~ ^(advanced|cosmetic|same)$ ]]
}

fetch_and_verify_remote_integrity() {
  if [[ -n "$larger_model_mode" ]]; then
    integrity_path="$artifact_staging_directory/runner-integrity.json"
  else
    integrity_path="$receipt_directory/$proof_id.integrity.json"
  fi
  if ! curl --fail --silent --show-error --max-time 60 \
      --max-filesize "$((64 * 1024 * 1024))" \
      -H "$remote_authorization" \
      "$proxy_root/integrity.json" |
    durable_write_stdin "$integrity_path"; then
    failure_message="The authenticated remote integrity manifest could not be persisted."
    echo "The worker did not return a durable authenticated integrity manifest." >&2
    return 1
  fi
  if ! integrity_verification="$(verify_remote_integrity_manifest)"; then
    failure_message="The remote result artifacts failed launch-bound authentication."
    echo "The result or adapter did not match its launch-bound integrity manifest." >&2
    return 1
  fi
  if ! accept_integrity_floor "$integrity_verification"; then
    failure_message="The authenticated remote integrity history regressed or forked."
    echo "The worker returned a regressed or forked integrity generation." >&2
    return 1
  fi
}

durable_create_stdin() {
  python3 -c '
import os
import pathlib
import sys

destination = pathlib.Path(sys.argv[1])
payload = sys.stdin.buffer.read()
descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    directory = os.open(destination.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
except BaseException:
    try:
        os.unlink(destination)
    except FileNotFoundError:
        pass
    raise
' "$1"
}

persist_operational_failure_receipt() {
  local execution_id="$1"
  local receipt="$2"
  if [[ ! "$execution_id" =~ ^runpod-proof-[a-zA-Z0-9_-]+$ ]]; then
    echo "Operational failure receipt execution id is invalid." >&2
    return 1
  fi
  if ! python3 - \
      "$repository_root" \
      "$receipt_directory" \
      "$execution_id" 3<<<"$receipt" <<'PY'
import hashlib
import json
import os
import pathlib
import stat
import sys
import tempfile

repository_root, receipt_directory, execution_id = sys.argv[1:]
sys.path.insert(0, str(pathlib.Path(repository_root) / "packages"))
from equinox_core import canonical_bytes

with os.fdopen(3, encoding="utf-8") as receipt_stream:
    receipt = json.load(receipt_stream)
operator_error = receipt.get("operator_error") if isinstance(receipt, dict) else None
remote_error = receipt.get("remote_error") if isinstance(receipt, dict) else None
provider = receipt.get("provider") if isinstance(receipt, dict) else None
workload = receipt.get("workload") if isinstance(receipt, dict) else None
cost = receipt.get("cost") if isinstance(receipt, dict) else None
if (
    not isinstance(receipt, dict)
    or receipt.get("receipt_kind") != "operational_failure@1"
    or receipt.get("scientific_proof") is not False
    or receipt.get("proof_id") is not None
    or receipt.get("execution_id") != execution_id
    or not isinstance(receipt.get("execution_name"), str)
    or not isinstance(provider, dict)
    or provider.get("name") != "RunPod"
    or (
        provider.get("handle") is not None
        and not isinstance(provider.get("handle"), str)
    )
    or not isinstance(provider.get("cli_version"), str)
    or not isinstance(receipt.get("resource_profile"), dict)
    or not isinstance(receipt.get("handoff"), dict)
    or not isinstance(workload, dict)
    or not isinstance(workload.get("id"), str)
    or workload.get("static_branch_width") not in {1, 4}
    or workload.get("complexity_strategy") != "adaptive"
    or not isinstance(receipt.get("last_observed_progress"), dict)
    or not isinstance(operator_error, dict)
    or not isinstance(operator_error.get("code"), str)
    or not isinstance(operator_error.get("message"), str)
    or (
        remote_error is not None
        and (
            not isinstance(remote_error, dict)
            or not isinstance(remote_error.get("code"), str)
            or not isinstance(remote_error.get("message"), str)
        )
    )
    or not isinstance(cost, dict)
    or not isinstance(cost.get("estimated"), bool)
    or not isinstance(receipt.get("started_at"), str)
    or not isinstance(receipt.get("completed_at"), str)
    or not isinstance(receipt.get("teardown_confirmed"), bool)
):
    raise SystemExit("operational failure receipt did not satisfy its local contract")
payload = canonical_bytes(receipt)
path = pathlib.Path(receipt_directory) / f"{execution_id}.failure.json"
path.parent.mkdir(parents=True, exist_ok=True)


def read_existing_payload():
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0),
        )
    except FileNotFoundError:
        if os.path.lexists(path):
            raise SystemExit("operational failure receipt path is not a regular file")
        return None
    except OSError as error:
        if os.path.lexists(path):
            raise SystemExit(
                "operational failure receipt path is not a regular file"
            ) from error
        raise
    with os.fdopen(descriptor, "rb") as handle:
        existing_stat = os.fstat(handle.fileno())
        if not stat.S_ISREG(existing_stat.st_mode):
            raise SystemExit("operational failure receipt path is not a regular file")
        return handle.read()


existing_payload = read_existing_payload()
if existing_payload is not None:
    if existing_payload != payload:
        raise SystemExit("operational failure receipt conflicts with existing evidence")
else:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{execution_id}.failure.",
        suffix=".tmp",
        dir=path.parent,
    )
    temporary_path = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temporary_path, path, follow_symlinks=False)
        except FileExistsError:
            existing_payload = read_existing_payload()
            if existing_payload is None:
                raise SystemExit("operational failure receipt path is not a regular file")
            if existing_payload != payload:
                raise SystemExit(
                    "operational failure receipt conflicts with existing evidence"
                )
        directory_fd = os.open(
            path.parent,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0),
        )
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass
        directory_fd = os.open(
            path.parent,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0),
        )
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
print(f"sha256:{hashlib.sha256(payload).hexdigest()}")
PY
  then
    echo "Operational failure evidence could not be created atomically." >&2
    return 1
  fi
}

cleanup_artifact_staging() {
  if [[ -z "$artifact_staging_directory" ||
    ! -d "$artifact_staging_directory" ||
    -L "$artifact_staging_directory" ]]; then
    return
  fi
  rm -f -- \
    "$bundle_stage_receipt_path" \
    "$remote_volume_receipt_path" \
    "$torch_retention_evidence_path" \
    "$dependency_quarantine_evidence_path" \
    "$code_materialization_evidence_path" \
    "$activation_path" \
    "$result_path" \
    "$integrity_path" \
    "$integrity_pending_path" \
    "$receipt_path" \
    "$attempt_record_path" \
    "$publication_plan_path" \
    "$adapter_path" \
    "$adapter_pending_path"
  fsync_directory "$artifact_staging_directory" || true
  rmdir "$artifact_staging_directory" || true
  fsync_directory "$operator_lock_directory" || true
}

release_operator_lock() {
  if [[ "$operator_lock_acquired" != true ]]; then
    return
  fi
  rm -f -- \
    "$operator_lock_directory/lease.json" \
    "$remote_integrity_poll_path"
  fsync_directory "$operator_lock_directory" || true
  if rmdir "$operator_lock_directory"; then
    operator_lock_acquired=false
    fsync_directory "$operator_state_root" || true
  fi
}
