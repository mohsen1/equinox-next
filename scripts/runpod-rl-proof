if [[ "$larger_model_mode" == "screen" ]]; then
  default_maximum_hourly_cost="4.00"
  default_maximum_total_cost="3.35"
  default_minimum_gpu_memory_gb="80"
  default_maximum_workload_attempts="1"
  default_container_disk_in_gb="50"
