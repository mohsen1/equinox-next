  maximum_updates="$default_maximum_updates"
  validation_examples="$default_validation_examples"
  test_examples="$default_test_examples"
  mastery_windows="$default_mastery_windows"
  training_tasks_per_update="$default_training_tasks_per_update"
  replay_tasks_per_level="$default_replay_tasks_per_level"
  retry_reserve_seconds="$default_retry_reserve_seconds"
  maximum_final_evaluation_reserve_seconds="$default_maximum_final_evaluation_reserve_seconds"
else
  model_id="${EQUINOX_RL_MODEL_ID:-$default_model_id}"
  target_runtime_seconds="${EQUINOX_RL_TARGET_SECONDS:-$default_target_runtime_seconds}"
  optimization_seed="${EQUINOX_RL_SEED:-73}"
  maximum_updates="${EQUINOX_RL_MAX_UPDATES:-$default_maximum_updates}"
  validation_examples="${EQUINOX_RL_VALIDATION_EXAMPLES:-$default_validation_examples}"
