        model_artifact_size_bytes: $model_artifact_size_bytes
      }
      else {}
      end
    )' |
    durable_write_stdin "$attempt_record_path"; then
    failure_message="The post-teardown attempt record could not be persisted."
    echo "The post-teardown attempt record could not be persisted." >&2
    exit 1
  fi

  prior_profile_id_json=null
  prior_receipts_json='{}'
  source_screen_json=null
  if [[ "$larger_model_mode" == "screen" ]]; then
    prior_bundle_receipt="$receipt_directory/larger-model-bundle-stage-$network_volume_id.json"
    if [[ "$volume_readiness_receipt" == "$receipt_directory/"* &&
      "$prior_bundle_receipt" == "$receipt_directory/"* &&
      -f "$volume_readiness_receipt" &&
      -f "$prior_bundle_receipt" ]] &&
      jq -e \
        --arg profile_id "qwen2.5-coder-7b-runpod-h100@6" \
        '.profile_id == $profile_id' \
        "$volume_readiness_receipt" >/dev/null 2>&1 &&
      jq -e \
        --arg profile_id "qwen2.5-coder-7b-runpod-h100@6" \
        '.profile_id == $profile_id' \
        "$prior_bundle_receipt" >/dev/null 2>&1; then
      prior_profile_id_json='"qwen2.5-coder-7b-runpod-h100@6"'
      prior_receipts_json="$(
        jq -cn \
          --arg readiness_receipt "$volume_readiness_receipt" \
          --arg bundle_receipt "$prior_bundle_receipt" \
          '{
            readiness_receipt: $readiness_receipt,
            bundle_receipt: $bundle_receipt
          }'
      )"
    fi
    publication_artifacts="$(
      jq -cn \
        --arg readiness_receipt "$remote_volume_receipt_path" \
        --arg bundle_receipt "$bundle_stage_receipt_path" \
        --arg torch_evidence "$torch_retention_evidence_path" \
        --arg run_result "$result_path" \
        --arg provider_receipt "$receipt_path" \
        --arg attempt_record "$attempt_record_path" \
        '{
          readiness_receipt: $readiness_receipt,
          bundle_receipt: $bundle_receipt,
          torch_evidence: $torch_evidence,
          run_result: $run_result,
          provider_receipt: $provider_receipt,
          attempt_record: $attempt_record
        }'
    )"
    expected_publication_roles='[
      "attempt_record",
      "bundle_receipt",
      "provider_receipt",
      "readiness_receipt",
      "run_result",
      "torch_evidence"
    ]'
  else
    source_screen_json="$(
      jq -cn \
        --arg publication_id "$source_screen_publication_id" \
        --arg manifest_digest "$source_screen_manifest_digest" \
        '{
          publication_id: $publication_id,
          artifact_set_manifest_digest: $manifest_digest
        }'
    )"
    publication_artifacts="$(
      jq -cn \
        --arg run_result "$result_path" \
        --arg provider_receipt "$receipt_path" \
        --arg attempt_record "$attempt_record_path" \
        --arg model_artifact "$adapter_path" \
        '{
          run_result: $run_result,
          provider_receipt: $provider_receipt,
          attempt_record: $attempt_record,
          model_artifact: $model_artifact
        }'
    )"
    expected_publication_roles='[
      "attempt_record",
      "model_artifact",
      "provider_receipt",
      "run_result"
    ]'
  fi

  publication_plan_path="$artifact_staging_directory/publication-plan.json"
  if ! jq -nS \
    --arg publication_id "$proof_id" \
    --arg publication_type "$larger_model_mode" \
    --arg profile_id "$larger_model_profile_id" \
    --arg proof_directory "$receipt_directory" \
    --arg state_directory "$operator_state_root" \
    --argjson artifacts "$publication_artifacts" \
    --argjson source_screen "$source_screen_json" \
    --argjson prior_profile_id "$prior_profile_id_json" \
    --argjson prior_receipts "$prior_receipts_json" \
    '{
      schema_version: 2,
      publication_id: $publication_id,
      publication_type: $publication_type,
      profile_id: $profile_id,
      proof_directory: $proof_directory,
      state_directory: $state_directory,
      teardown_confirmed: true,
      artifacts: $artifacts,
      source_screen: $source_screen,
      prior_profile_id: $prior_profile_id,
      prior_receipts: $prior_receipts
    }' |
    durable_write_stdin "$publication_plan_path"; then
    failure_message="The complete post-teardown artifact publication plan could not be persisted."
    echo "The complete post-teardown artifact publication plan could not be persisted." >&2
    exit 1
  fi

  if [[ "$larger_model_mode" == "screen" &&
    "$volume_expiry_guard_active" == true ]]; then
    # Transfer the volume to its bounded handoff lease before entering the
    # publication commit. A host crash after the atomic manifest rename can
    # then be recovered without deleting a valid screen's private artifacts.
    write_volume_expiry_guard_state \
      "awaiting-pilot" 0 "$proof_id" ""
  fi

  failure_message="The complete post-teardown larger-model artifact set was not committed atomically."
  if ! publication_result="$(
    PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
      python3 -m research.runpod.artifact_publication \
      publish \
      --plan "$publication_plan_path"
  )"; then
    publication_result="$(
      PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m research.runpod.artifact_publication \
        recover \
        --proof-directory "$receipt_directory" \
        --state-directory "$operator_state_root" \
        --publication-id "$proof_id"
    )" || {
      echo "The post-teardown larger-model artifact set could not be recovered." >&2
      exit 1
    }
  fi
  if ! jq -e \
      --arg publication_id "$proof_id" \
      --arg publication_type "$larger_model_mode" \
      --arg profile_id "$larger_model_profile_id" \
      --arg source_publication_id "$source_screen_publication_id" \
      --arg source_manifest_digest "$source_screen_manifest_digest" \
      --argjson expected_roles "$expected_publication_roles" \
      '
        .publication_id == $publication_id
        and .publication_type == $publication_type
        and .profile_id == $profile_id
        and .artifact_set_committed == true
        and (.set_digest | test("^sha256:[0-9a-f]{64}$"))
        and (
          .artifact_set_manifest_digest
          | test("^sha256:[0-9a-f]{64}$")
        )
        and (.artifacts | keys | sort) == ($expected_roles | sort)
        and (
          if $publication_type == "pilot"
          then (
            .source_screen.publication_id == $source_publication_id
            and .source_screen.artifact_set_manifest_digest
              == $source_manifest_digest
          )
          else .source_screen == null
          end
        )
      ' >/dev/null 2>&1 <<<"$publication_result"; then
    echo "The post-teardown larger-model artifact set did not commit atomically." >&2
    exit 1
  fi
  artifact_set_committed=true
  if [[ "$larger_model_mode" == "screen" ]]; then
    failure_message="The completed larger-model eligibility screen could not be published."
  else
    failure_message="A verified local proof receipt is pending ingestion."
  fi
  artifact_set_manifest_digest="$(
    jq -r '.artifact_set_manifest_digest' <<<"$publication_result"
  )"
  published_receipt_path="$(jq -r '.artifacts.provider_receipt' <<<"$publication_result")"
  artifact_publication="$(
    jq -cn \
      --arg publication_id "$proof_id" \
      --arg publication_type "$larger_model_mode" \
      --arg profile_id "$larger_model_profile_id" \
      --arg manifest_digest "$artifact_set_manifest_digest" \
      --arg set_digest "$(jq -r '.set_digest' <<<"$publication_result")" \
      --arg run_result_digest "$(
        jq -r '.artifact_descriptors.run_result.canonical_json_sha256' \
          <<<"$publication_result"
      )" \
      --arg provider_receipt_digest "$(
        jq -r '.artifact_descriptors.provider_receipt.canonical_json_sha256' \
          <<<"$publication_result"
      )" \
      --arg source_publication_id "$source_screen_publication_id" \
      --arg source_manifest_digest "$source_screen_manifest_digest" \
      --arg model_artifact_digest "$(
        jq -r '.artifact_descriptors.model_artifact.sha256 // empty' \
          <<<"$publication_result"
      )" \
      --argjson model_artifact_size "$(
        jq -r '.artifact_descriptors.model_artifact.size_bytes // null' \
          <<<"$publication_result"
      )" \
      '{
        schema_version: 2,
        publication_id: $publication_id,
        publication_type: $publication_type,
        profile_id: $profile_id,
        artifact_set_manifest_digest: $manifest_digest,
        set_digest: $set_digest,
        run_result_canonical_json_sha256: $run_result_digest,
        provider_receipt_canonical_json_sha256: $provider_receipt_digest
      }
      + (
        if $publication_type == "pilot"
        then {
          source_screen_publication_id: $source_publication_id,
          source_screen_manifest_digest: $source_manifest_digest,
          model_artifact_sha256: $model_artifact_digest,
          model_artifact_size_bytes: $model_artifact_size
        }
        else {}
        end
      )'
  )"
fi

if [[ "$larger_model_mode" == "screen" ]]; then
  last_progress="$(
    jq -c \
      '
        del(.error, .remote_error, .operator_error)
        | . + {
            phase: "complete",
            message: "Eligibility recorded and teardown confirmed."
          }
      ' <<<"$last_progress"
  )"
  failure_message="The completed larger-model eligibility screen could not be published."
  publish_execution "SUCCEEDED" "$last_progress" "$completed_at" "true"
  if [[ "$volume_expiry_guard_active" == true ]]; then
    write_volume_expiry_guard_state \
      "awaiting-pilot" 0 "$proof_id" ""
  fi
  terminal_published=true
elif [[ "$study_eligibility_only" == "1" ]]; then
  last_progress="$(
    jq -c \
      '
        del(.error, .remote_error, .operator_error)
        | . + {
            phase: "complete",
            message: "Protocol eligibility recorded and provider teardown confirmed."
          }
      ' <<<"$last_progress"
  )"
  failure_message="The completed eligibility screen could not be published."
  publish_execution "SUCCEEDED" "$last_progress" "$completed_at" "true"
  terminal_published=true
else
  failure_message="A verified local proof receipt is pending ingestion."
  proof_ingested=false
  if [[ -n "$larger_model_mode" ]]; then
    if [[ -z "$published_receipt_path" ]]; then
      echo "The committed larger-model provider receipt could not be resolved." >&2
      exit 1
    fi
    proof_payload="$(
      jq -c \
        --argjson artifact_publication "$artifact_publication" \
        '. + {artifact_publication: $artifact_publication}' \
        "$published_receipt_path"
    )"
  else
    proof_payload="$(
      jq '{
        provider_name,
        provider_handle,
        provider_cli_version,
        resource_profile,
        workload,
        result,
        started_at,
        completed_at,
        teardown_confirmed
      }' "$receipt_path"
    )"
  fi
  for attempt in 1 2 3; do
    if proof_response="$(
      curl --fail --silent --show-error --max-time 60 \
        -X POST "$api_root/internal/research-compute-proofs" \
        -H "Authorization: Bearer $internal_token" \
        -H 'Content-Type: application/json' \
        --data-binary @- <<<"$proof_payload"
    )"; then
      terminal_published=true
      jq . <<<"$proof_response"
      proof_ingested=true
      break
    fi
    if ((attempt < 3)); then
      sleep 2
    fi
  done
  if [[ "$proof_ingested" != true ]]; then
    exit 1
  fi
fi
terminal_published=true
if [[ -n "$published_receipt_path" ]]; then
  echo "Committed artifact set: $receipt_directory/$proof_id.artifact-set.json" >&2
else
  echo "Sanitized receipt: $receipt_path" >&2
fi
