read_python_string_constant() {
  python3 - "$1" "$2" <<'PY'
import ast
import pathlib
import sys

path, name = sys.argv[1:]
tree = ast.parse(pathlib.Path(path).read_text(encoding="utf-8"), filename=path)
matches = [
    node.value
    for node in tree.body
    if isinstance(node, ast.Assign)
    and any(isinstance(target, ast.Name) and target.id == name for target in node.targets)
]
if len(matches) != 1:
    raise SystemExit(f"{path} must assign {name} exactly once")
value = ast.literal_eval(matches[0])
if not isinstance(value, str) or not value:
    raise SystemExit(f"{path} must assign {name} to a non-empty string")
print(value)
PY
}
