if ! jq -e \
  --argjson result "$metrics" \
  --arg larger_model_mode "$larger_model_mode" \
  --arg profile_id "$larger_model_profile_id" \
  '
    (keys | sort) == (
      [
        "completed_at",
        "provider_cli_version",
        "provider_handle",
        "provider_name",
        "resource_profile",
        "result",
        "started_at",
        "teardown_confirmed",
        "workload"
      ] | sort
    )
    and .provider_name == "RunPod"
    and (.provider_handle | test("^runpod://pods/[a-zA-Z0-9_-]+$"))
    and .result == $result
    and .teardown_confirmed == true
    and (
      if $larger_model_mode == ""
      then true
      else (
        .resource_profile.profile_id == $profile_id
        and (
          .resource_profile.dependency_lock_digest
          | test("^sha256:[0-9a-f]{64}$")
        )
        and (
          .resource_profile.dependency_quarantine_evidence_digest
          | test("^sha256:[0-9a-f]{64}$")
        )
        and (
          .resource_profile.dependency_private_tree_digest
          | test("^sha256:[0-9a-f]{64}$")
        )
        and (
          .resource_profile.code_materialization_evidence_digest
          | test("^sha256:[0-9a-f]{64}$")
        )
        and (
