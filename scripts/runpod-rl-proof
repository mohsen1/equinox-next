  --docker-args "$docker_args"
  --terminate-after "$terminate_after"
)
if [[ -n "$network_volume_id" ]]; then
  create_arguments+=(--network-volume-id "$network_volume_id")
else
  create_arguments+=(--volume-in-gb "$persistent_volume_in_gb")
