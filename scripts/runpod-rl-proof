#!/usr/bin/env bash
set -euo pipefail
umask 077

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$repository_root/.venv/bin/python3" ]]; then
  PATH="$repository_root/.venv/bin:$PATH"
fi
"$repository_root/scripts/ensure-local-env"
internal_token="${EQUINOX_INTERNAL_TOKEN:-$(
  sed -n 's/^EQUINOX_INTERNAL_TOKEN=//p' "$repository_root/.env" | tail -n 1
)}"
if [[ ${#internal_token} -lt 32 ]]; then
  echo "EQUINOX_INTERNAL_TOKEN must contain at least 32 characters." >&2
  exit 1
fi
experiment="${EQUINOX_RUNPOD_EXPERIMENT:-repository-repair}"
support_files=()
study_condition="${EQUINOX_STUDY_CONDITION:-}"
study_revision="${EQUINOX_STUDY_REVISION:-30}"
study_validation_seed_base="${EQUINOX_STUDY_VALIDATION_SEED_BASE:-}"
study_test_seed_base="${EQUINOX_STUDY_TEST_SEED_BASE:-}"
study_completion_budget="${EQUINOX_STUDY_COMPLETION_BUDGET:-}"
study_eligibility_only="${EQUINOX_STUDY_ELIGIBILITY_ONLY:-}"
larger_model_mode="${EQUINOX_LARGER_MODEL_MODE:-}"
expected_study_id="repository-repair-confirmatory-study@1"
expected_complexity_strategy="adaptive"
expected_mastery_window_basis="retained_zero_regression_checkpoints"
expected_frontier_probe_routing="mixed_correctness_branch_contrast_feedback"
expected_training_level_allocation="current_and_adaptive_probe_even_split"
expected_branch_width=4
expected_algorithm="verified-fix-group-conditioned-policy-gradient"
case "$experiment" in
