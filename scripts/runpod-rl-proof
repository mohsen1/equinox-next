    --arg network_volume_data_center_id "$network_volume_data_center_id" \
    --arg volume_readiness_receipt_digest "$volume_readiness_receipt_digest" \
    --argjson persistent_volume_in_gb "$persistent_volume_in_gb" \
    --argjson maximum_hourly_cost "$maximum_hourly_cost" \
    --argjson maximum_total_cost "$maximum_total_cost" \
    --argjson minimum_gpu_memory_gb "$minimum_gpu_memory_gb" \
    --argjson model_load_timeout_seconds "$model_load_timeout_seconds" \
    --argjson stale_progress_timeout_seconds "$stale_progress_timeout_seconds" \
    '{
      gpu_id: $gpu_id,
      gpu_count: 1,
      image: $image,
      cloud_type: $cloud_type,
      data_center_ids: (
        if $data_center_ids == ""
        then null
        else ($data_center_ids | split(","))
        end
      ),
      persistent_volume_in_gb: $persistent_volume_in_gb,
      network_volume_id: (
        if $network_volume_id == "" then null else $network_volume_id end
      ),
      network_volume_data_center_id: (
        if $network_volume_data_center_id == ""
        then null
        else $network_volume_data_center_id
        end
      ),
      volume_readiness_receipt_digest: (
        if $volume_readiness_receipt_digest == ""
        then null
        else $volume_readiness_receipt_digest
        end
      ),
      maximum_hourly_cost_usd: $maximum_hourly_cost,
      maximum_total_cost_usd: $maximum_total_cost,
      minimum_gpu_memory_gb: $minimum_gpu_memory_gb,
      model_load_timeout_seconds: $model_load_timeout_seconds,
      stale_progress_timeout_seconds: $stale_progress_timeout_seconds
    }'
)"

publish_execution() {
  local status="$1"
  local progress="$2"
  local completed_at="${3:-}"
  local teardown_confirmed="${4:-false}"
  local deadline_epoch="${5:-}"
  local payload
  local attempt
  local request_timeout
  local retry_delay
  payload="$(
    jq -cn \
      --arg name "$execution_name" \
      --arg workload_id "$workload_id" \
      --arg model_id "$model_id" \
      --arg status "$status" \
      --arg provider_handle "$provider_handle" \
      --argjson resource_profile "$resource_profile" \
      --argjson progress "$progress" \
      --arg started_at "$started_at" \
      --arg completed_at "$completed_at" \
      --argjson branch_width "$expected_branch_width" \
      --argjson teardown_confirmed "$teardown_confirmed" \
      '{
        name: $name,
        workload_id: $workload_id,
        model_id: (if $model_id == "" then null else $model_id end),
        branch_width: $branch_width,
        complexity_strategy: "adaptive",
        status: $status,
        provider_name: "RunPod",
        provider_handle: (
          if $provider_handle == "" then null else $provider_handle end
        ),
        resource_profile: $resource_profile,
        progress: $progress,
        started_at: $started_at,
        completed_at: (if $completed_at == "" then null else $completed_at end),
        teardown_confirmed: $teardown_confirmed
      }'
  )"
  for attempt in 1 2 3; do
    request_timeout=15
    if [[ -n "$deadline_epoch" ]] &&
      ! request_timeout="$(seconds_until_deadline "$deadline_epoch" 15)"; then
      return 1
    fi
    if curl --fail --silent --show-error --max-time "$request_timeout" \
      -X PUT "$api_root/internal/research-compute-executions/$proof_id" \
      -H "Authorization: Bearer $internal_token" \
      -H 'Content-Type: application/json' \
      --data-binary "$payload" >/dev/null; then
      return 0
    fi
    if ((attempt < 3)); then
      retry_delay=1
      if [[ -n "$deadline_epoch" ]] &&
        ! retry_delay="$(seconds_until_deadline "$deadline_epoch" 1)"; then
        return 1
      fi
      sleep "$retry_delay"
    fi
  done
  return 1
}

reconcile_pod_id_by_name() {
  local pods
  local matches
  if ! pods="$(provider_pods 2>/dev/null)"; then
    return 2
  fi
  matches="$(jq -r --arg name "$pod_name" '[.[] | select(.name == $name) | .id] | .[]' <<<"$pods")"
  if [[ -z "$matches" ]]; then
    return 1
  fi
  if [[ "$(wc -l <<<"$matches" | tr -d ' ')" != "1" ]] ||
    [[ ! "$matches" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    return 2
  fi
  pod_id="$matches"
  provider_handle="runpod://pods/$pod_id"
  ambiguous_create_unresolved=false
}

pod_presence_state() {
  local pods
  if ! pods="$(provider_pods 2>/dev/null)"; then
    printf '%s\n' "unknown"
  elif [[ -n "$pod_id" ]] &&
    jq -e --arg id "$pod_id" 'any(.[]; .id == $id)' >/dev/null <<<"$pods"; then
    printf '%s\n' "present"
  elif jq -e --arg name "$pod_name" 'any(.[]; .name == $name)' >/dev/null <<<"$pods"; then
    printf '%s\n' "present"
  else
    printf '%s\n' "absent"
  fi
}

confirm_provider_teardown() {
  local consecutive_absent=0
  local reconciliation_seconds="$cleanup_reserve_seconds"
  if [[ "$ambiguous_create_unresolved" == true ]]; then
    reconciliation_seconds="$ambiguous_create_reconciliation_seconds"
  fi
  local cleanup_deadline_epoch="$(( $(date +%s) + reconciliation_seconds ))"
  local current_epoch
  local remaining_seconds
  local state
  local spend
  while (( $(date +%s) < cleanup_deadline_epoch )); do
    if [[ -z "$pod_id" ]]; then
      reconcile_pod_id_by_name || true
    fi
    if [[ -n "$pod_id" ]]; then
      run_provider_command 15 runpodctl pod delete "$pod_id" >/dev/null 2>&1 || true
    fi
    state="$(pod_presence_state)"
    if [[ "$state" == "absent" ]]; then
      consecutive_absent=$((consecutive_absent + 1))
    else
      consecutive_absent=0
    fi
    current_epoch="$(date +%s)"
    if ((consecutive_absent >= 3)) &&
      {
        [[ "$ambiguous_create_unresolved" != true ]] ||
          ((current_epoch >= ambiguous_create_safe_after_epoch))
      } &&
      spend="$(provider_current_spend 2>/dev/null)" &&
      [[ "$spend" == "0" ]]; then
      return 0
    fi
    remaining_seconds=$((cleanup_deadline_epoch - current_epoch))
    if ((remaining_seconds <= 0)); then
      break
    fi
    if ((remaining_seconds < 5)); then
      sleep "$remaining_seconds"
    else
      sleep 5
    fi
  done
  return 1
}

cleanup() {
  local exit_code="$?"
  local teardown_confirmed="$provider_teardown_confirmed"
  local completed_at
  local failed_progress
  trap - EXIT
  trap '' INT TERM HUP
  set +e

  if [[ -n "$bundle_source_path" ]]; then
    rm -f -- "$bundle_source_path"
    bundle_source_path=""
  fi

  if [[ "$pod_create_attempted" == true && -z "$pod_id" ]]; then
    reconcile_pod_id_by_name || true
  fi
  if [[ "$pod_create_attempted" == true && "$teardown_confirmed" != true ]]; then
    if confirm_provider_teardown; then
      teardown_confirmed=true
      provider_teardown_confirmed=true
    fi
  else
    teardown_confirmed=true
  fi

  if [[ "$execution_registered" == true && "$terminal_published" != true ]]; then
    completed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    failed_progress="$(
      jq -c \
        --arg message "Run stopped before proof ingestion." \
        --arg error "$failure_message" \
        '. + {message: $message, error: $error}' \
        <<<"$last_progress"
    )"
    publish_execution \
      "FAILED" \
      "$failed_progress" \
      "$completed_at" \
      "$teardown_confirmed" || true
  fi
  if [[ "$teardown_confirmed" == true ]]; then
    release_operator_lock
  else
    echo "RunPod teardown is unresolved; retaining $operator_lock_directory." >&2
  fi
  exit "$exit_code"
}
trap cleanup EXIT
trap 'failure_message="The operator interrupted the RunPod harness."; exit 130' INT TERM HUP

if ! current_spend="$(provider_current_spend)" || [[ "$current_spend" != "0" ]]; then
  echo "Refusing to start: the RunPod account already has active hourly spend." >&2
  exit 1
fi

if ! current_pods="$(provider_pods)" || [[ "$(jq 'length' <<<"$current_pods")" != "0" ]]; then
  echo "Refusing to start: the RunPod account already contains a pod." >&2
  exit 1
fi

curl --fail --silent --show-error --max-time 10 "$api_root/healthz" >/dev/null
curl --fail --silent --show-error --max-time 10 "$dashboard_root/runs" >/dev/null
research_executions="$(
  curl --fail --silent --show-error --max-time 10 \
    "$api_root/v1/research-compute-executions"
)"
while IFS= read -r stale_execution; do
  stale_id="$(jq -r '.execution_id' <<<"$stale_execution")"
  reconciled_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  jq -c \
    --arg completed_at "$reconciled_at" \
    '{
      name,
      workload_id,
      model_id,
      branch_width,
      complexity_strategy,
      status: "FAILED",
      provider_name,
      provider_handle,
      resource_profile,
      progress: (
        .progress + {
          message: "Reconciled after the operator process stopped.",
          error: "No RunPod pod or active hourly spend remained."
        }
      ),
      started_at,
      completed_at: $completed_at,
      teardown_confirmed: true
    }' <<<"$stale_execution" |
    curl --fail --silent --show-error --max-time 15 \
      -X PUT "$api_root/internal/research-compute-executions/$stale_id" \
      -H "Authorization: Bearer $internal_token" \
      -H 'Content-Type: application/json' \
      --data-binary @- >/dev/null
  echo "Reconciled stale observer record $stale_id; no RunPod worker remained." >&2
done < <(
  jq -c \
    '.items[] | select(
      .status == "PROVISIONING"
      or .status == "RUNNING"
      or .status == "FINALIZING"
    )' \
    <<<"$research_executions"
)

failure_message="The observer API did not accept the provisioning record."
publish_execution "PROVISIONING" "$last_progress"
execution_registered=true

echo "Creating one bounded RunPod worker; provider deadline: $terminate_after" >&2
failure_message="RunPod pod creation failed before a provider handle was returned."
create_arguments=(
  pod create
  --name "$pod_name"
  --image "$image"
  --gpu-id "$gpu_id"
  --gpu-count 1
  --cloud-type "$cloud_type"
  --container-disk-in-gb "$container_disk_in_gb"
