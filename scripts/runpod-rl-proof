    '
      $manifest.runtime.template_id == $template_id
      and $manifest.runtime.image == $image
      and $manifest.hardware.cloud_type == $cloud_type
      and $manifest.hardware.gpu_id == $gpu_id
      and $manifest.hardware.container_disk_gb == $container_disk
      and $manifest.hardware.volume_disk_gb == $volume_disk
      and $manifest.hardware.minimum_gpu_memory_gb == $minimum_gpu_memory
      and $manifest[$limit_key].maximum_hourly_cost_usd == $maximum_hourly
      and $manifest[$limit_key].maximum_total_cost_usd == $maximum_total
      and $manifest[$limit_key].maximum_lifetime_seconds == $maximum_lifetime_seconds
      and $manifest[$limit_key].boot_timeout_seconds == $boot_timeout
      and $manifest[$limit_key].model_load_timeout_seconds == $model_load_timeout
      and $manifest[$limit_key].stale_progress_timeout_seconds == $stale_progress_timeout
      and $manifest[$limit_key].maximum_workload_attempts == $maximum_attempts
      and $manifest[$limit_key].target_runtime_seconds == $target_runtime
      and $manifest[$limit_key].retry_reserve_seconds == $retry_reserve
      and $manifest[$limit_key].maximum_final_evaluation_reserve_seconds
        == $final_evaluation_reserve
      and $manifest[$limit_key].optimization_seed == $optimization_seed
      and (
        if $limit_key == "screen_limits"
        then (
          $manifest[$limit_key].artifact_retrieval_reserve_seconds
            == $artifact_retrieval_reserve
          and $manifest[$limit_key].conservative_billing_seconds
            == $conservative_billing
        )
        else true
        end
      )
    ' >/dev/null; then
    echo "The larger-model provider settings do not exactly match the immutable profile." >&2
    exit 1
  fi
  expected_image_digest="$(jq -r '.runtime.image_digest' <<<"$larger_model_manifest")"
  if ! jq -e \
    '
      .materialization == {
        code: {
          revision: "private-code-materialization@1",
          evidence_schema_version: 1
        },
        dependency_lock: {
          path: "larger-model-dependencies.lock",
          digest: "sha256:bb143bf631b6509c07881a606dc96cd244099debdca09f8f700abc90dad2e34f",
          size_bytes: 30866,
          revision: "hash-locked-private-dependencies@1",
          evidence_schema_version: 2,
          installer_revision: "isolated-pip-binary-hash-lock@1",
          python_version: "3.12",
          platform_tag: "manylinux_2_28_x86_64",
          index_url: "https://pypi.org/simple",
          network_policy:
            "hash-locked-binary-wheels-during-authenticated-preparation-only"
        }
      }
    ' >/dev/null <<<"$larger_model_manifest"; then
    echo "The larger-model private-materialization contract is not the frozen hash lock." >&2
    exit 1
  fi
  if [[ "$larger_model_mode" == "screen" ]]; then
    if [[ "$live_stage_requested_revision" != "$live_stage_activation_revision" ||
      "$live_stage_activation_revision" != "authenticated-proxy-stage-activation@2" ]]; then
      echo "The larger-model eligibility screen requires the immutable authenticated live-stage activation." >&2
      exit 1
    fi
    if ! jq -en \
      --arg baseline "$campaign_baseline_balance_usd" \
      --arg budget "$campaign_authorized_budget_usd" \
      --arg pilot "$campaign_future_pilot_reserve_usd" \
      --arg storage "$campaign_storage_reserve_usd" \
      --argjson conservative_seconds "$conservative_billing_seconds" \
      --argjson hourly "$maximum_hourly_cost" \
      --argjson screen_cap "$maximum_total_cost" \
      '
        ($baseline | tonumber) == 45.2834247943
        and ($budget | tonumber) == 25
        and ($pilot | tonumber) == 13
        and ($storage | tonumber) == 0.30
        and $conservative_seconds == 3000
        and $screen_cap == 3.35
        and (($hourly * $conservative_seconds / 3600) <= $screen_cap)
      ' >/dev/null 2>&1; then
      echo "The live-stage campaign ledger settings do not match the authorized screen envelope." >&2
      exit 1
    fi
    live_stage_enabled=true
  elif [[ -n "$live_stage_requested_revision" ]]; then
    echo "Authenticated live staging is permitted only for the larger-model screen." >&2
    exit 1
  fi
  if [[ "$larger_model_mode" == "screen" ]]; then
    expected_future_pilot_reserve_usd=13
  else
    expected_future_pilot_reserve_usd=0
  fi
  if ! jq -en \
    --arg baseline "$campaign_baseline_balance_usd" \
    --arg budget "$campaign_authorized_budget_usd" \
    --arg future_pilot "$campaign_future_pilot_reserve_usd" \
    --arg storage "$campaign_storage_reserve_usd" \
    --argjson expected_future_pilot "$expected_future_pilot_reserve_usd" \
    '
      ($baseline | tonumber) == 45.2834247943
      and ($budget | tonumber) == 25
      and ($future_pilot | tonumber) == $expected_future_pilot
      and ($storage | tonumber) == 0.30
    ' >/dev/null 2>&1; then
    echo "The larger-model campaign ledger settings do not match the authorized envelope." >&2
    exit 1
  fi
  if ! verify_pinned_image_tag; then
    exit 1
  fi
fi
if [[ "$cloud_type" != "COMMUNITY" && "$cloud_type" != "SECURE" ]]; then
  echo "EQUINOX_RUNPOD_CLOUD_TYPE must be COMMUNITY or SECURE." >&2
  exit 1
fi
if [[ -n "$data_center_ids" ]] &&
  [[ ! "$data_center_ids" =~ ^[A-Z0-9-]+(,[A-Z0-9-]+)*$ ]]; then
  echo "EQUINOX_RUNPOD_DATA_CENTER_IDS must be a comma-separated list of RunPod datacenter ids." >&2
  exit 1
fi
if [[ -n "$network_volume_id" ]] &&
  [[ ! "$network_volume_id" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "EQUINOX_RUNPOD_NETWORK_VOLUME_ID is invalid." >&2
  exit 1
fi
if ! jq -en \
  --argjson hourly "$maximum_hourly_cost" \
  --argjson total "$maximum_total_cost" \
  --argjson lifetime "$maximum_lifetime_minutes" \
  '$hourly > 0
    and $total > 0
    and $lifetime > 0
    and (($hourly * $lifetime / 60) <= $total)' >/dev/null 2>&1; then
  echo "Hourly cost, total cost, and lifetime must be positive and the lifetime cost bound must fit the total-cost ceiling." >&2
  exit 1
fi
if [[ ! "$minimum_gpu_memory_gb" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_MIN_GPU_MEMORY_GB must be a positive integer." >&2
  exit 1
fi
if [[ ! "$model_load_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_MODEL_LOAD_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 1
fi
if [[ ! "$stale_progress_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_STALE_PROGRESS_SECONDS must be a positive integer." >&2
  exit 1
fi
if [[ "$maximum_workload_attempts" != "1" && "$maximum_workload_attempts" != "2" ]]; then
  echo "EQUINOX_RUNPOD_MAX_WORKLOAD_ATTEMPTS must be 1 or 2." >&2
  exit 1
fi
if [[ -n "$larger_model_mode" ]]; then
  if [[ "$model_id" != "Qwen/Qwen2.5-Coder-7B-Instruct" ]]; then
    echo "The larger-model profile pins Qwen/Qwen2.5-Coder-7B-Instruct." >&2
    exit 1
  fi
  if [[ "$gpu_id" != "NVIDIA H100 80GB HBM3" || "$minimum_gpu_memory_gb" -lt 80 ]]; then
    echo "The larger-model profile requires exactly one NVIDIA H100 80GB HBM3 with at least 80 GB." >&2
    exit 1
  fi
  if [[ -z "$network_volume_id" ]]; then
    echo "Larger-model runs require EQUINOX_RUNPOD_NETWORK_VOLUME_ID with the pinned offline snapshot." >&2
    exit 1
  fi
  if ! network_volume="$(
    run_provider_command 30 runpodctl network-volume get "$network_volume_id" 2>/dev/null
  )"; then
    echo "The configured RunPod network volume could not be verified." >&2
    exit 1
  fi
  if [[ -z "$network_volume" ]] ||
    ! jq -e \
      --arg volume_id "$network_volume_id" \
      --argjson minimum_size "$persistent_volume_in_gb" \
      '
      (.networkVolume // .) as $volume
      | ($volume.id // $volume.networkVolumeId // "") == $volume_id
        and ($volume.size | type) == "number"
        and $volume.size >= $minimum_size
        and ($volume.dataCenterId | type) == "string"
        and ($volume.dataCenterId | length) > 0
    ' >/dev/null <<<"$network_volume"; then
    echo "The configured RunPod network volume identity, size, or data center is invalid." >&2
    exit 1
  fi
  network_volume_data_center_id="$(
    jq -r '(.networkVolume // .).dataCenterId' <<<"$network_volume"
  )"
  if [[ -z "$volume_readiness_receipt" ]]; then
    volume_readiness_receipt="$receipt_directory/larger-model-volume-$network_volume_id.json"
  fi
  if [[ ! -f "$volume_readiness_receipt" ]]; then
    echo "The configured network volume has no local CPU-prewarm readiness receipt." >&2
    exit 1
  fi
  if [[ "$live_stage_enabled" == true ]]; then
    predecessor_manifest_path="$(
      mktemp "${TMPDIR:-/tmp}/equinox-predecessor-manifest.XXXXXX"
    )"
    if ! git -C "$repository_root" show \
      "f0b83d62591b9b2a43ca1aa29a554b23e1a31300:research/studies/larger-model-eligibility.json" \
      >"$predecessor_manifest_path"; then
      rm -f -- "$predecessor_manifest_path"
      echo "The exact historical readiness-seed manifest could not be materialized." >&2
      exit 1
    fi
    set +e
    verified_volume_seed_bridge="$(
      printf '%s' "$network_volume" |
        python3 "$repository_root/research/runpod/larger_model_gate.py" \
          --manifest "$repository_root/research/studies/larger-model-eligibility.json" \
          bridge-predecessor-volume-receipt \
          "$volume_readiness_receipt" \
          - \
          --predecessor-manifest "$predecessor_manifest_path"
    )"
    bridge_exit_code="$?"
    set -e
    rm -f -- "$predecessor_manifest_path"
    if [[ "$bridge_exit_code" != "0" ]] ||
      ! jq -e \
        --arg current_profile_id "$larger_model_profile_id" \
        --arg volume_id "$network_volume_id" \
        --arg data_center_id "$network_volume_data_center_id" \
        --argjson volume_size "$persistent_volume_in_gb" \
        '
          .schema_version == 1
          and .bridge_revision == "exact-predecessor-readiness-seed@1"
          and .current_profile_id == $current_profile_id
          and .predecessor_profile_id == "qwen2.5-coder-7b-runpod-h100@6"
          and .predecessor_manifest_commit
            == "f0b83d62591b9b2a43ca1aa29a554b23e1a31300"
          and .network_volume_id == $volume_id
          and .network_volume_data_center_id == $data_center_id
          and .network_volume_size_gb == $volume_size
          and .seed_only == true
          and .remote_current_attestation_required == true
          and (.predecessor_receipt_digest | test("^sha256:[0-9a-f]{64}$"))
          and (.bridge_digest | test("^sha256:[0-9a-f]{64}$"))
        ' >/dev/null 2>&1 <<<"$verified_volume_seed_bridge"; then
      echo "The local receipt is not the exact verified historical readiness seed." >&2
      exit 1
    fi
    volume_readiness_receipt_digest="$(
      jq -r '.predecessor_receipt_digest' <<<"$verified_volume_seed_bridge"
    )"
    volume_readiness_seed_bridge_digest="$(
      jq -r '.bridge_digest' <<<"$verified_volume_seed_bridge"
    )"
    larger_model_expected_snapshot_digest="$(
      PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -c '
from research.runpod.larger_model_gate import expected_snapshot_digest, load_manifest

print(expected_snapshot_digest(load_manifest()))
'
    )"
    network_volume_verified_size_gb="$persistent_volume_in_gb"
  else
    verified_volume_readiness="$(
      printf '%s' "$network_volume" |
        python3 "$repository_root/research/runpod/larger_model_gate.py" \
          verify-volume-receipt \
          "$volume_readiness_receipt" \
          -
    )"
    larger_model_expected_snapshot_digest="$(
      jq -r '.snapshot_digest' <<<"$verified_volume_readiness"
    )"
    volume_readiness_receipt_digest="$(
      jq -r '.receipt_digest' <<<"$verified_volume_readiness"
    )"
    network_volume_verified_size_gb="$(
      jq -r '.network_volume_size_gb' <<<"$verified_volume_readiness"
    )"
    dependency_quarantine_evidence_digest="$(
      jq -r '.dependency_quarantine_evidence_digest' <<<"$verified_volume_readiness"
    )"
    dependency_lock_digest="$(
      jq -r '.dependency_lock_digest' <<<"$verified_volume_readiness"
    )"
    dependency_private_tree_digest="$(
      jq -r '.dependency_private_tree_digest' <<<"$verified_volume_readiness"
    )"
    code_materialization_evidence_digest="$(
      jq -r '.code_materialization_evidence_digest' <<<"$verified_volume_readiness"
    )"
    code_private_tree_digest="$(
      jq -r '.code_private_tree_digest' <<<"$verified_volume_readiness"
    )"
  fi
  if [[ -n "$data_center_ids" ]] &&
    ! jq -en \
      --arg configured "$data_center_ids" \
      --arg required "$network_volume_data_center_id" \
      '$configured | split(",") | index($required) != null' >/dev/null; then
    echo "The configured data centers do not include the network volume data center." >&2
    exit 1
  fi
  data_center_inventory="$(run_provider_command 30 runpodctl datacenter list)"
  if [[ -z "$data_center_inventory" ]] ||
    ! jq -e \
      --arg data_center_id "$network_volume_data_center_id" \
      --arg gpu_id "$gpu_id" \
      '
      any(.[];
        .id == $data_center_id
        and any(.gpuAvailability[];
          .gpuId == $gpu_id
          and .stockStatus != "Unavailable"
        )
      )
    ' >/dev/null <<<"$data_center_inventory"; then
    echo "The network volume data center does not currently report a profile-matching H100 80GB HBM3." >&2
    exit 1
  fi
  if [[ "$larger_model_mode" == "pilot" ]]; then
    if [[ ! -f "$larger_model_screen_result" || ! -f "$larger_model_screen_receipt" ]]; then
      echo "The pilot requires an existing screen result and provider receipt." >&2
      exit 1
    fi
    verified_authorization="$(
      python3 "$repository_root/research/runpod/larger_model_gate.py" \
        authorize \
        "$larger_model_screen_result" \
        "$larger_model_screen_receipt"
    )"
    larger_model_authorization_digest="$(jq -r '.digest' <<<"$verified_authorization")"
    larger_model_screen_result_digest="$(
      jq -r '.screen_result_digest' <<<"$verified_authorization"
    )"
    authorized_network_volume_id="$(
      jq -r '.network_volume_id' <<<"$verified_authorization"
    )"
    authorized_network_volume_data_center_id="$(
      jq -r '.network_volume_data_center_id' <<<"$verified_authorization"
    )"
    authorized_network_volume_size_gb="$(
      jq -r '.network_volume_size_gb' <<<"$verified_authorization"
    )"
    authorized_snapshot_digest="$(
      jq -r '.pinned_snapshot_digest' <<<"$verified_authorization"
    )"
    authorized_source_contract_digest="$(
      jq -r '.source_contract_digest' <<<"$verified_authorization"
    )"
    authorized_optimization_seed="$(
      jq -r '.optimization_seed' <<<"$verified_authorization"
    )"
    authorized_bundle_handoff_revision="$(
      jq -r '.bundle_handoff_revision' <<<"$verified_authorization"
    )"
    authorized_workload_bundle_digest="$(
      jq -r '.workload_bundle_digest' <<<"$verified_authorization"
    )"
    authorized_workload_bundle_size_bytes="$(
      jq -r '.workload_bundle_size_bytes' <<<"$verified_authorization"
    )"
    authorized_workload_bundle_path="$(
      jq -r '.workload_bundle_path' <<<"$verified_authorization"
    )"
    authorized_bundle_stage_receipt_digest="$(
      jq -r '.bundle_stage_receipt_digest' <<<"$verified_authorization"
    )"
    authorized_bootstrap_source_digest="$(
      jq -r '.bootstrap_source_digest' <<<"$verified_authorization"
    )"
    authorized_source_head_commit="$(
      jq -r '.source_head_commit' <<<"$verified_authorization"
    )"
    authorized_volume_readiness_receipt_digest="$(
      jq -r '.volume_readiness_receipt_digest' <<<"$verified_authorization"
    )"
    authorized_torch_retention_evidence_digest="$(
      jq -r '.torch_retention_evidence_digest' <<<"$verified_authorization"
    )"
    authorized_dependency_lock_digest="$(
      jq -r '.dependency_lock_digest' <<<"$verified_authorization"
    )"
    authorized_dependency_quarantine_evidence_digest="$(
      jq -r '.dependency_quarantine_evidence_digest' <<<"$verified_authorization"
    )"
    authorized_dependency_private_tree_digest="$(
      jq -r '.dependency_private_tree_digest' <<<"$verified_authorization"
    )"
    authorized_code_materialization_evidence_digest="$(
      jq -r '.code_materialization_evidence_digest' <<<"$verified_authorization"
    )"
    authorized_code_private_tree_digest="$(
      jq -r '.code_private_tree_digest' <<<"$verified_authorization"
    )"
    authorized_live_stage_activation_revision="$(
      jq -r '.live_stage_activation_revision' <<<"$verified_authorization"
    )"
    authorized_live_stage_activation_digest="$(
      jq -r '.live_stage_activation_digest' <<<"$verified_authorization"
    )"
    if [[ ! "$larger_model_authorization_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
      echo "The larger-model gate returned an invalid authorization digest." >&2
      exit 1
    fi
    if [[ ! "$larger_model_screen_result_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
      echo "The larger-model gate returned an invalid screen-result digest." >&2
      exit 1
    fi
    if [[ "$authorized_network_volume_id" != "$network_volume_id" ||
      "$authorized_snapshot_digest" != "$larger_model_expected_snapshot_digest" ||
      "$authorized_source_contract_digest" != "$larger_model_source_contract_digest" ||
      "$authorized_network_volume_data_center_id" != "$network_volume_data_center_id" ||
      "$authorized_network_volume_size_gb" != "$network_volume_verified_size_gb" ||
      "$authorized_volume_readiness_receipt_digest" != "$volume_readiness_receipt_digest" ||
      "$authorized_live_stage_activation_revision" != "$live_stage_activation_revision" ||
      "$authorized_optimization_seed" != "$optimization_seed" ]]; then
      echo "The pilot volume, readiness, activation, source contract, or seed does not match the screened authorization." >&2
      exit 1
    fi
    for authorized_materialization_digest in \
      "$authorized_dependency_lock_digest" \
      "$authorized_dependency_quarantine_evidence_digest" \
      "$authorized_dependency_private_tree_digest" \
      "$authorized_code_materialization_evidence_digest" \
      "$authorized_code_private_tree_digest"; do
      if [[ ! "$authorized_materialization_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
        echo "The larger-model gate returned invalid private-materialization evidence." >&2
        exit 1
      fi
    done
    if [[ -z "$torch_retention_evidence" ||
      ! -f "$torch_retention_evidence" ]]; then
      echo "The pilot requires the committed screen Torch retention evidence." >&2
      exit 1
    fi
    authorization_consumption_path="$authorization_consumption_directory/${larger_model_screen_result_digest#sha256:}.json"
    if [[ -e "$authorization_consumption_path" ]]; then
      echo "The matching larger-model screen authorization has already been consumed." >&2
      exit 1
    fi
  fi
  gpu_inventory="$(run_provider_command 30 runpodctl gpu list --include-unavailable)"
  if [[ -z "$gpu_inventory" ]] ||
    ! jq -e \
      --arg gpu_id "$gpu_id" \
      --arg cloud_type "$cloud_type" \
      --argjson minimum_memory "$minimum_gpu_memory_gb" \
      '
      any(.[];
        .gpuId == $gpu_id
        and .displayName == "H100 SXM"
        and .available == true
        and .memoryInGb >= $minimum_memory
        and (
          ($cloud_type == "SECURE" and .secureCloud == true)
          or ($cloud_type == "COMMUNITY" and .communityCloud == true)
        )
      )
    ' >/dev/null <<<"$gpu_inventory"; then
    echo "RunPod does not currently report an available profile-matching H100 80GB HBM3." >&2
    exit 1
  fi
fi
if [[ "$experiment" == "sequence-ladder" ]]; then
  for configuration_name in \
    EQUINOX_RL_MODEL_ID \
    EQUINOX_RL_SEED \
    EQUINOX_RL_TARGET_SECONDS \
    EQUINOX_RL_MAX_RESUME_GAP_SECONDS \
    EQUINOX_RL_MAX_UPDATES \
    EQUINOX_RL_VALIDATION_EXAMPLES \
    EQUINOX_RL_TEST_EXAMPLES \
    EQUINOX_RL_MASTERY_WINDOWS \
    EQUINOX_RL_TRAINING_TASKS_PER_UPDATE \
    EQUINOX_RL_REPLAY_TASKS_PER_LEVEL \
    EQUINOX_RUNPOD_RETRY_RESERVE_SECONDS \
    EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS; do
    if [[ -n "${!configuration_name+x}" ]]; then
      echo "$configuration_name is pinned by the sequence-ladder workload." >&2
      exit 1
    fi
  done
fi
if [[ "$experiment" != "repository-repair" && -n "$study_condition" ]]; then
  echo "Confirmatory study conditions are only valid for repository-repair." >&2
  exit 1
fi
if [[ -n "$study_eligibility_only" && "$study_eligibility_only" != "1" ]]; then
  echo "EQUINOX_STUDY_ELIGIBILITY_ONLY must be 1 when set." >&2
  exit 1
fi
if [[ "$study_eligibility_only" == "1" && "$study_condition" != "k4_train" ]]; then
  echo "Protocol eligibility screening requires the K=4 training condition." >&2
  exit 1
fi
if [[ -n "$study_condition" ]]; then
  for split_seed in "$study_validation_seed_base" "$study_test_seed_base"; do
    if [[ ! "$split_seed" =~ ^[1-9][0-9]*$ ]] || ((split_seed > 2147483647)); then
      echo "Study validation and test seed bases must be positive 32-bit integers." >&2
      exit 1
    fi
  done
  if [[ "$study_validation_seed_base" == "$study_test_seed_base" ]]; then
    echo "Study validation and test seed bases must be disjoint." >&2
    exit 1
  fi
  if [[ "$study_validation_seed_base" == "40000" || "$study_test_seed_base" == "190000" ]]; then
    echo "Confirmatory study splits must be fresh relative to the frozen reference." >&2
    exit 1
  fi
  if [[ "$study_condition" == "k4_train" ]]; then
    if [[ -n "$study_completion_budget" ]]; then
      echo "Fresh K=4 training determines the matched continuation budget; do not preset it." >&2
      exit 1
    fi
  elif [[ ! "$study_completion_budget" =~ ^[1-9][0-9]*$ ]] ||
    ((study_completion_budget % expected_branch_width != 0)); then
    echo "Matched controls require a positive whole-group completion budget." >&2
    exit 1
  fi
fi
if [[ ! "$boot_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_BOOT_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 1
fi
if [[ ! "$target_runtime_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RL_TARGET_SECONDS must be a positive integer." >&2
  exit 1
fi
if [[ ! "$optimization_seed" =~ ^[0-9]+$ ]] || ((optimization_seed > 2147483647)); then
  echo "EQUINOX_RL_SEED must be an integer between 0 and 2147483647." >&2
  exit 1
fi
if [[ ! "$container_disk_in_gb" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_CONTAINER_DISK_GB must be a positive integer." >&2
  exit 1
fi
if [[ ! "$persistent_volume_in_gb" =~ ^[1-9][0-9]*$ ]] ||
  ((persistent_volume_in_gb > 50)); then
  echo "EQUINOX_RUNPOD_VOLUME_GB must be an integer between 1 and 50." >&2
  exit 1
fi
if [[ ! "$maximum_lifetime_minutes" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_MAX_LIFETIME_MINUTES must be a positive integer." >&2
  exit 1
fi
if [[ "$experiment" == "repository-repair" ]] &&
  {
    [[ ! "$retry_reserve_seconds" =~ ^[1-9][0-9]*$ ]] ||
      [[ ! "$maximum_final_evaluation_reserve_seconds" =~ ^[1-9][0-9]*$ ]] ||
      ((retry_reserve_seconds > 7200)) ||
      ((maximum_final_evaluation_reserve_seconds > 7200)) ||
      ((maximum_final_evaluation_reserve_seconds > retry_reserve_seconds))
  }; then
  echo "Repository-repair reserves must be positive, at most 7200 seconds, and final evaluation must not exceed the retry reserve." >&2
  exit 1
fi
if [[ "$experiment" == "repository-repair" ]] &&
  ((target_runtime_seconds <= maximum_final_evaluation_reserve_seconds + 60)); then
  echo "EQUINOX_RL_TARGET_SECONDS must leave at least 60 seconds for training before final evaluation." >&2
  exit 1
fi
for bounded_integer in \
  "$maximum_updates" \
  "$validation_examples" \
  "$mastery_windows" \
  "$training_tasks_per_update" \
  "$replay_tasks_per_level"; do
  if [[ ! "$bounded_integer" =~ ^[1-9][0-9]*$ ]]; then
    echo "Research workload counts must be positive integers." >&2
    exit 1
  fi
done
if [[ "$larger_model_mode" == "screen" ]]; then
  if [[ "$test_examples" != "0" ]]; then
    echo "The larger-model eligibility screen must disable test examples." >&2
    exit 1
  fi
elif [[ ! "$test_examples" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RL_TEST_EXAMPLES must be a positive integer." >&2
  exit 1
fi
if [[ "$experiment" == "repository-repair" ]]; then
  EQUINOX_RL_MODEL_ID="$model_id" \
    EQUINOX_RL_SEED="$optimization_seed" \
    EQUINOX_RL_TARGET_SECONDS="$target_runtime_seconds" \
    EQUINOX_RL_MAX_RESUME_GAP_SECONDS="$retry_reserve_seconds" \
    EQUINOX_RL_MAX_UPDATES="$maximum_updates" \
    EQUINOX_RL_VALIDATION_EXAMPLES="$validation_examples" \
    EQUINOX_RL_TEST_EXAMPLES="$test_examples" \
    EQUINOX_RL_MASTERY_WINDOWS="$mastery_windows" \
    EQUINOX_RL_TRAINING_TASKS_PER_UPDATE="$training_tasks_per_update" \
    EQUINOX_RL_REPLAY_TASKS_PER_LEVEL="$replay_tasks_per_level" \
    EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS="$maximum_final_evaluation_reserve_seconds" \
    EQUINOX_STUDY_CONDITION="$study_condition" \
    EQUINOX_STUDY_VALIDATION_SEED_BASE="$study_validation_seed_base" \
    EQUINOX_STUDY_TEST_SEED_BASE="$study_test_seed_base" \
    EQUINOX_STUDY_COMPLETION_BUDGET="$study_completion_budget" \
    CUBLAS_WORKSPACE_CONFIG=":4096:8" \
    python3 "$workload_path" --validate-configuration
fi
if ((
  target_runtime_seconds + maximum_final_evaluation_reserve_seconds +
    final_evaluation_generation_overshoot_seconds + boot_timeout_seconds +
    retry_reserve_seconds + 120 > maximum_lifetime_minutes * 60
)); then
  echo "The provider lifetime must cover boot, target runtime, final evaluation, one bounded generation, retry, and cleanup reserves." >&2
  exit 1
fi
bundle_files=("$workload_file" "remote_runner.sh" "result_server.py")
bundle_files+=("${support_files[@]}")
larger_model_profile_file="larger-model-eligibility.json"
bundle_source_path="$(
  mktemp "${TMPDIR:-/tmp}/equinox-runpod-bundle.XXXXXX"
)"
trap 'rm -f -- "$bundle_source_path"' EXIT
if [[ -n "$larger_model_mode" ]]; then
  bundle_metadata="$(
    PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
      python3 "$workload_bundle_tool_path" \
      build \
      --repository-root "$repository_root" \
      --output "$bundle_source_path"
  )"
  bundle_size_bytes="$(jq -r '.bundle_size_bytes' <<<"$bundle_metadata")"
  bundle_digest="$(jq -r '.bundle_digest' <<<"$bundle_metadata")"
  expected_bundle_volume_path="$(jq -r '.bundle_path' <<<"$bundle_metadata")"
else
  COPYFILE_DISABLE=1 tar -cf - \
    -C "$repository_root/research/runpod" \
    "${bundle_files[@]}" |
    xz --threads=1 --check=crc64 -6 -c >"$bundle_source_path"
  bundle_size_bytes="$(wc -c <"$bundle_source_path" | tr -d ' ')"
  if ((bundle_size_bytes > 80 * 1024)); then
    echo "The compressed workload bundle exceeds the 80 KiB inline transport limit." >&2
    exit 1
  fi
  bundle_digest="$(
    python3 - "$bundle_source_path" <<'PY'
import hashlib
import pathlib
import sys

print(f"sha256:{hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest()}")
PY
  )"
  expected_bundle_volume_path=""
fi
if [[ ! "$bundle_size_bytes" =~ ^[1-9][0-9]*$ ||
  ! "$bundle_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "The workload bundle builder returned invalid identity evidence." >&2
  exit 1
fi
if [[ -n "$larger_model_mode" ]] &&
  ! jq -e \
    --arg profile_id "$larger_model_profile_id" \
    --arg manifest_digest "$larger_model_manifest_digest" \
    --arg source_contract_digest "$larger_model_source_contract_digest" \
    '
      .profile_id == $profile_id
      and .manifest_digest == $manifest_digest
      and .source_contract_digest == $source_contract_digest
    ' >/dev/null <<<"$bundle_metadata"; then
  echo "The workload bundle metadata does not match the immutable larger-model profile." >&2
  exit 1
fi
if [[ -n "$larger_model_mode" ]]; then
  if [[ "$live_stage_enabled" == true ]]; then
    bundle_volume_path="$expected_bundle_volume_path"
  else
    if [[ -z "$bundle_stage_receipt" ]]; then
      bundle_stage_receipt="$receipt_directory/larger-model-bundle-stage-$network_volume_id.json"
    fi
    if [[ ! -f "$bundle_stage_receipt" ]]; then
      echo "The configured network volume has no local workload-bundle stage receipt." >&2
      exit 1
    fi
    if ! verified_bundle_stage="$(
      printf '%s' "$network_volume" |
        PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
          python3 "$workload_bundle_tool_path" \
          verify-stage-receipt \
          "$bundle_stage_receipt" \
          - \
          --bundle-digest "$bundle_digest" \
          --bundle-size-bytes "$bundle_size_bytes" \
          --bundle-path "$expected_bundle_volume_path"
    )"; then
      echo "The local workload-bundle stage receipt does not match the profile or provider volume." >&2
      exit 1
    fi
    bundle_volume_path="$(jq -r '.bundle_path' <<<"$verified_bundle_stage")"
    bundle_stage_receipt_digest="$(jq -r '.receipt_digest' <<<"$verified_bundle_stage")"
    if [[ "$bundle_volume_path" != "$expected_bundle_volume_path" ||
      ! "$bundle_stage_receipt_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
      echo "The verified workload-bundle stage evidence is invalid." >&2
      exit 1
    fi
  fi
fi
bootstrap_source_b64="$(
  base64 <"$bootstrap_server_path" |
    tr -d '\n'
)"
bootstrap_source_digest="$(
  python3 - "$bootstrap_server_path" <<'PY'
import hashlib
import pathlib
import sys

print(f"sha256:{hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest()}")
PY
)"
if [[ ! "$bootstrap_source_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "The operational bootstrap source digest is invalid." >&2
  exit 1
fi
if [[ -n "$larger_model_mode" ]]; then
  source_head_commit="$(git -C "$repository_root" rev-parse --verify HEAD 2>/dev/null || true)"
  if [[ ! "$source_head_commit" =~ ^[0-9a-f]{40}$ ]]; then
    echo "The larger-model workload could not resolve an immutable Git HEAD." >&2
    exit 1
  fi
  head_bound_paths=(
    "packages/equinox_core/canonical.py"
    "research/runpod/artifact_republisher.py"
    "research/runpod/bootstrap_server.py"
    "research/runpod/artifact_publication.py"
    "scripts/republish-runpod-proof"
    "scripts/runpod-rl-proof"
    "scripts/screen-larger-model"
    "scripts/run-larger-model-pilot"
    "scripts/runpod-volume-expiry-guard"
  )
  while IFS= read -r bundle_member; do
    if [[ "$bundle_member" == "$larger_model_profile_file" ]]; then
      head_bound_paths+=("research/studies/$bundle_member")
    else
      head_bound_paths+=("research/runpod/$bundle_member")
    fi
  done < <(jq -r '.bundle_files[]' <<<"$bundle_metadata")
  if ! tracked_head_bound_paths="$(
    git -C "$repository_root" ls-files --error-unmatch --stage -- \
      "${head_bound_paths[@]}"
  )" ||
    ! python3 - "$tracked_head_bound_paths" "${head_bound_paths[@]}" <<'PY'
import collections
import re
import sys

tracked, *expected = sys.argv[1:]
if len(expected) != len(set(expected)):
    raise SystemExit("duplicate HEAD-bound path")
entries: list[tuple[str, str, str, str]] = []
for line in tracked.splitlines():
    match = re.fullmatch(r"([0-7]{6}) ([0-9a-f]{40,64}) ([0-3])\t(.+)", line)
    if match is None:
        raise SystemExit("invalid tracked path record")
    entries.append(match.groups())
counts = collections.Counter(path for _mode, _object_id, _stage, path in entries)
if set(counts) != set(expected) or any(count != 1 for count in counts.values()):
    raise SystemExit("HEAD-bound path set mismatch")
for mode, object_id, stage, _path in entries:
    if mode not in {"100644", "100755"} or stage != "0" or set(object_id) == {"0"}:
        raise SystemExit("unsafe HEAD-bound path index identity")
PY
  then
    echo "Every larger-model workload source must be a unique committed regular file." >&2
    exit 1
  fi
  if ! git -C "$repository_root" diff --quiet "$source_head_commit" -- \
    "${head_bound_paths[@]}"; then
    echo "The larger-model workload and bootstrap must match immutable Git HEAD bytes." >&2
    exit 1
  fi
fi
if [[ "$larger_model_mode" == "pilot" ]]; then
  if [[ ! "$source_screen_publication_id" =~ ^runpod-proof-[a-zA-Z0-9_-]+$ ||
    ! "$source_screen_manifest_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "The pilot requires the exact committed source-screen publication identity." >&2
    exit 1
  fi
  if ! source_screen_artifact_set="$(
    PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
