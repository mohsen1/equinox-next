  )" ||
    ! jq -e \
      --arg publication_id "$source_screen_publication_id" \
      --arg profile_id "$larger_model_profile_id" \
      --arg manifest_digest "$source_screen_manifest_digest" \
      --arg set_digest "$source_screen_set_digest" \
      --arg run_result_digest "$source_screen_result_canonical_digest" \
      --arg provider_receipt_digest "$source_screen_receipt_canonical_digest" \
      '
        .execution_id == $publication_id
        and .status == "SUCCEEDED"
        and .teardown_confirmed == true
        and .artifact_publication_required == true
        and (.artifact_publication | type) == "object"
        and (.artifact_publication | keys | sort) == [
          "artifact_set_manifest_digest",
          "profile_id",
          "provider_receipt_canonical_json_sha256",
          "publication_id",
          "publication_type",
          "run_result_canonical_json_sha256",
          "schema_version",
          "set_digest"
        ]
        and .artifact_publication.schema_version == 2
        and .artifact_publication.publication_id == $publication_id
        and .artifact_publication.publication_type == "screen"
        and .artifact_publication.profile_id == $profile_id
        and .artifact_publication.artifact_set_manifest_digest
          == $manifest_digest
        and .artifact_publication.set_digest == $set_digest
        and .artifact_publication.run_result_canonical_json_sha256
          == $run_result_digest
        and .artifact_publication.provider_receipt_canonical_json_sha256
          == $provider_receipt_digest
      ' >/dev/null 2>&1 <<<"$source_screen_execution"; then
    echo "The pilot source screen is not an exact successful atomic API publication." >&2
    exit 1
  fi
fi
if [[ "$larger_model_mode" == "pilot" ]] &&
  {
