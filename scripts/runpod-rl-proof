  python3 - "$maximum_lifetime_minutes" <<'PY'
from datetime import datetime, timedelta, timezone
import sys

print(
    (
        datetime.now(timezone.utc) + timedelta(minutes=int(sys.argv[1]))
    ).replace(microsecond=0).isoformat().replace("+00:00", "Z")
)
PY
)"
if ! mkdir "$operator_lock_directory"; then
