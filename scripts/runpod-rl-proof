model_cache_directory="/workspace/equinox-state/huggingface"
operator_state_root="${EQUINOX_RUNPOD_OPERATOR_STATE_DIR:-$(
  python3 - <<'PY'
from pathlib import Path

print(Path.home() / ".local/state/equinox/runpod")
PY
)}"
