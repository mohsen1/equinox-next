        then null
        else ($data_center_ids | split(","))
        end
      ),
      persistent_volume_in_gb: $persistent_volume_in_gb,
      network_volume_id: (
        if $network_volume_id == "" then null else $network_volume_id end
      ),
      network_volume_data_center_id: (
        if $network_volume_data_center_id == ""
        then null
        else $network_volume_data_center_id
        end
      ),
      volume_readiness_receipt_digest: (
        if $volume_readiness_receipt_digest == ""
        then null
        else $volume_readiness_receipt_digest
        end
      ),
      bundle_stage_receipt_digest: (
        if $bundle_stage_receipt_digest == ""
        then null
        else $bundle_stage_receipt_digest
        end
      ),
      bootstrap_source_digest: $bootstrap_source_digest,
      bundle_handoff_revision: (
        if $bundle_stage_receipt_digest == "" then null else $bundle_handoff_revision end
      ),
      workload_bundle_digest: $workload_bundle_digest,
      workload_bundle_size_bytes: $workload_bundle_size_bytes,
      workload_bundle_compression: $workload_bundle_compression,
      workload_bundle_path: (
        if $workload_bundle_path == "" then null else $workload_bundle_path end
      ),
      maximum_hourly_cost_usd: $maximum_hourly_cost,
      maximum_total_cost_usd: $maximum_total_cost,
      minimum_gpu_memory_gb: $minimum_gpu_memory_gb,
      model_load_timeout_seconds: $model_load_timeout_seconds,
      stale_progress_timeout_seconds: $stale_progress_timeout_seconds
    }
    + (
      if $larger_model_profile_id == ""
      then {}
      else {profile_id: $larger_model_profile_id}
      end
    )'
)"

publish_execution() {
  local status="$1"
  local progress="$2"
  local completed_at="${3:-}"
  local teardown_confirmed="${4:-false}"
  local deadline_epoch="${5:-}"
  local failure_receipt_digest="${6:-}"
  local payload
  local attempt
  local request_timeout
  local retry_delay
  touch_volume_expiry_guard
  payload="$(
    jq -c \
      --arg name "$execution_name" \
      --arg workload_id "$workload_id" \
      --arg model_id "$model_id" \
      --arg larger_model_mode "$larger_model_mode" \
      --arg status "$status" \
      --arg provider_handle "$provider_handle" \
      --argjson resource_profile "$resource_profile" \
      --arg started_at "$started_at" \
      --arg completed_at "$completed_at" \
      --arg failure_receipt_digest "$failure_receipt_digest" \
      --argjson branch_width "$expected_branch_width" \
      --argjson teardown_confirmed "$teardown_confirmed" \
      --argjson artifact_publication "$artifact_publication" \
      '{
        name: $name,
        workload_id: $workload_id,
        model_id: (if $model_id == "" then null else $model_id end),
        branch_width: $branch_width,
        complexity_strategy: "adaptive",
        status: $status,
        provider_name: "RunPod",
        provider_handle: (
          if $provider_handle == "" then null else $provider_handle end
        ),
        resource_profile: $resource_profile,
        progress: .,
        artifact_publication_required: ($larger_model_mode != ""),
        artifact_publication: $artifact_publication,
        failure_receipt_digest: (
          if $failure_receipt_digest == ""
          then null
          else $failure_receipt_digest
          end
        ),
        started_at: $started_at,
        completed_at: (if $completed_at == "" then null else $completed_at end),
        teardown_confirmed: $teardown_confirmed
      }' <<<"$progress"
  )"
  for attempt in 1 2 3; do
    request_timeout=15
    if [[ -n "$deadline_epoch" ]] &&
      ! request_timeout="$(seconds_until_deadline "$deadline_epoch" 15)"; then
      return 1
    fi
    if curl --fail --silent --show-error --max-time "$request_timeout" \
      -X PUT "$api_root/internal/research-compute-executions/$proof_id" \
      -H "Authorization: Bearer $internal_token" \
      -H 'Content-Type: application/json' \
      --data-binary @- <<<"$payload" >/dev/null; then
      return 0
    fi
    if ((attempt < 3)); then
      retry_delay=1
      if [[ -n "$deadline_epoch" ]] &&
        ! retry_delay="$(seconds_until_deadline "$deadline_epoch" 1)"; then
        return 1
      fi
      sleep "$retry_delay"
    fi
  done
  return 1
}

remote_payload_has_no_publication_keys() {
  jq -e '
    [
      ..
      | objects
      | keys[]
      | select(
          . == "artifact_publication"
          or . == "artifact_publication_required"
          or startswith("artifact_set_")
        )
    ] | length == 0
  ' >/dev/null
}

fetch_and_publish_remote_progress() {
  local observed_epoch="$1"
  local observed_progress
  local remote_phase
  touch_volume_expiry_guard
  last_remote_progress_fetch_valid=false
  observed_progress="$(
    curl --fail --silent --show-error --max-time 10 \
      -H "$remote_authorization" "$progress_url" 2>/dev/null || true
  )"
  if [[ -z "$observed_progress" ]] ||
    ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$observed_progress" ||
    ! remote_payload_has_no_publication_keys <<<"$observed_progress"; then
    return 0
  fi
  if ! poll_remote_integrity_floor; then
    failure_message="The private remote progress could not be paired with authenticated integrity state."
    echo "Remote progress was available without a valid monotonic integrity manifest." >&2
    exit 1
  fi
  if ! accept_monotonic_remote_progress "$observed_progress"; then
    failure_message="The private remote progress regressed or replayed an older snapshot."
    echo "Remote progress violated its monotonic attempt/update/elapsed/terminal contract." >&2
    exit 1
  fi
  last_remote_progress_fetch_valid=true
  if [[ "$remote_progress_freshness" == "same" ]]; then
    return 0
  fi
  if [[ "$remote_progress_freshness" == "advanced" ]]; then
    last_progress_change_epoch="$observed_epoch"
  fi
  remote_phase="$(jq -r '.phase // empty' <<<"$observed_progress")"
  if [[ -z "$preparation_started_epoch" ]] &&
    [[ "$remote_phase" == "dependency_setup" || "$remote_phase" == "model_loading" ]]; then
    preparation_started_epoch="$observed_epoch"
  elif [[ "$remote_phase" != "dependency_setup" && "$remote_phase" != "model_loading" ]]; then
    preparation_started_epoch=""
  fi
  last_progress="$(
    {
      printf '%s\n' "$last_progress"
      printf '%s\n' "$observed_progress"
    } | jq -cs '
      if length == 2 and (.[0] | type) == "object" and (.[1] | type) == "object"
      then .[0] + .[1]
      else error("remote progress merge requires two objects")
      end
    '
  )"
  if publish_execution "RUNNING" "$last_progress"; then
    last_remote_progress="$observed_progress"
  else
    echo "Observer progress publish failed after retries; monitoring continues." >&2
  fi
}

larger_model_screen_progress_complete() {
  jq -e \
    --argjson expected_branch_groups "$larger_model_expected_branch_groups" \
    '
      .branch_groups_completed == $expected_branch_groups
      and .branch_groups_total == $expected_branch_groups
      and (.branch_snapshots | type) == "array"
      and (.branch_snapshots | length) == $expected_branch_groups
      and .latest_branch_snapshot == .branch_snapshots[-1]
    ' >/dev/null
}

larger_model_screen_progress_matches_result() {
  local result="$1"
  jq -e \
    --argjson result "$result" \
    --argjson expected_branch_groups "$larger_model_expected_branch_groups" \
    --argjson expected_baseline_examples "$larger_model_expected_baseline_examples" \
    --argjson fail_fast_reasons "$larger_model_screen_fail_fast_reasons" \
    --argjson baseline_fail_fast_reasons \
    "$larger_model_screen_baseline_fail_fast_reasons" \
    '
      ($result.eligible | type) == "boolean"
      and ($result.branch_groups | type) == "number"
      and ($result.branch_groups | floor) == $result.branch_groups
      and $result.branch_groups >= 0
      and $result.branch_groups <= $expected_branch_groups
      and (
        if $result.branch_groups == 0 then
          $result.eligible == false
          and $result.completed_baseline_examples == $expected_baseline_examples
          and (
            $baseline_fail_fast_reasons | index($result.early_stop_reason)
          ) != null
          and (
            (
              (
                $result.early_stop_reason
                == "LEVEL_0_CHECKPOINT_GATE_MATHEMATICALLY_IMPOSSIBLE"
                or $result.early_stop_reason
                == "OVERALL_CHECKPOINT_GATE_MATHEMATICALLY_IMPOSSIBLE"
              )
              and $result.gate_results.baseline_checkpoint_rate == false
            )
            or (
              $result.early_stop_reason
              == "BASELINE_EXACT_HEADROOM_GATE_MATHEMATICALLY_IMPOSSIBLE"
              and $result.gate_results.baseline_exact_rate == false
            )
          )
          and (.branch_groups_completed // 0) == 0
          and (.branch_groups_total // $expected_branch_groups) == $expected_branch_groups
          and ((.branch_snapshots // []) | type) == "array"
          and ((.branch_snapshots // []) | length) == 0
          and (.latest_branch_snapshot // null) == null
        else
          .branch_groups_completed == $result.branch_groups
          and .branch_groups_total == $expected_branch_groups
          and (.branch_snapshots | type) == "array"
          and (.branch_snapshots | length) == $result.branch_groups
          and .latest_branch_snapshot == .branch_snapshots[-1]
          and (
            $result.branch_groups == $expected_branch_groups
            or (
              $result.eligible == false
              and (
                $fail_fast_reasons | index($result.early_stop_reason)
              ) != null
              and (
                (
                  $result.early_stop_reason
                  == "BRANCH_CHECKPOINT_GATE_MATHEMATICALLY_IMPOSSIBLE"
                  and $result.gate_results.branch_checkpoint_rate == false
                )
                or (
                  $result.early_stop_reason
                  == "INFORMATIVE_GROUP_GATE_MATHEMATICALLY_IMPOSSIBLE"
                  and $result.gate_results.informative_group_rate == false
                )
                or (
                  (
                    $result.early_stop_reason
                    == "SOLVED_SIBLING_GATE_MATHEMATICALLY_IMPOSSIBLE"
                    or $result.early_stop_reason
                    == "FAILED_SIBLING_GATE_MATHEMATICALLY_IMPOSSIBLE"
                    or $result.early_stop_reason
                    == "SOLVED_SIBLING_RATE_GATE_MATHEMATICALLY_IMPOSSIBLE"
                  )
                  and $result.gate_results.solved_sibling_rate == false
                )
                or (
                  $result.early_stop_reason
                  == "ACTION_PROTOCOL_GATE_MATHEMATICALLY_IMPOSSIBLE"
                  and $result.gate_results.action_protocol_validity == false
                )
              )
            )
          )
        end
      )
    ' >/dev/null
}

reconcile_pod_id_by_name() {
  local pods
  local matches
  if ! pods="$(provider_pods 2>/dev/null)"; then
    return 2
  fi
  matches="$(jq -r --arg name "$pod_name" '[.[] | select(.name == $name) | .id] | .[]' <<<"$pods")"
  if [[ -z "$matches" ]]; then
    return 1
  fi
  if [[ "$(wc -l <<<"$matches" | tr -d ' ')" != "1" ]] ||
    [[ ! "$matches" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    return 2
  fi
  pod_id="$matches"
  provider_handle="runpod://pods/$pod_id"
  provider_allocation_observed=true
  ambiguous_create_unresolved=false
  touch_volume_expiry_guard
}

pod_presence_state() {
  local pods
  if ! pods="$(provider_pods 2>/dev/null)"; then
    printf '%s\n' "unknown"
  elif [[ -n "$pod_id" ]] &&
    jq -e --arg id "$pod_id" 'any(.[]; .id == $id)' >/dev/null <<<"$pods"; then
    printf '%s\n' "present"
  elif jq -e --arg name "$pod_name" 'any(.[]; .name == $name)' >/dev/null <<<"$pods"; then
    printf '%s\n' "present"
  else
    printf '%s\n' "absent"
  fi
}

confirm_provider_teardown() {
  local consecutive_absent=0
  local reconciliation_seconds="$cleanup_reserve_seconds"
  if [[ "$ambiguous_create_unresolved" == true ]]; then
    reconciliation_seconds="$ambiguous_create_reconciliation_seconds"
  fi
  local cleanup_deadline_epoch="$(( $(date +%s) + reconciliation_seconds ))"
  local current_epoch
  local remaining_seconds
  while (( $(date +%s) < cleanup_deadline_epoch )); do
    touch_volume_expiry_guard
    if [[ -z "$pod_id" ]]; then
      reconcile_pod_id_by_name || true
    fi
    if [[ -n "$pod_id" ]]; then
      run_provider_command 15 runpodctl pod delete "$pod_id" >/dev/null 2>&1 || true
    fi
    current_epoch="$(date +%s)"
    if provider_idle_state_is_safe &&
      {
        [[ "$ambiguous_create_unresolved" != true ]] ||
          ((current_epoch >= ambiguous_create_safe_after_epoch))
      }; then
      consecutive_absent=$((consecutive_absent + 1))
    else
      consecutive_absent=0
    fi
    if ((consecutive_absent >= 3)); then
      return 0
    fi
    remaining_seconds=$((cleanup_deadline_epoch - current_epoch))
    if ((remaining_seconds <= 0)); then
      break
    fi
    if ((remaining_seconds < 5)); then
      sleep "$remaining_seconds"
    else
      sleep 5
    fi
  done
  return 1
}

cleanup() {
  local exit_code="$?"
  local teardown_confirmed="$provider_teardown_confirmed"
  local completed_at
  local completed_epoch
  local observed_progress
  local failed_progress
  local operator_error
  local remote_error
  local provider_cli_version
  local provider_runtime_seconds
  local provider_runtime_started_epoch
  local failure_receipt
  local failure_receipt_digest=""
  trap - EXIT
  trap '' INT TERM HUP
  set +e

  if [[ -n "$larger_model_mode" &&
    "$artifact_set_committed" != true &&
    -f "$publication_plan_path" ]]; then
    recovered_publication="$(
      PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m research.runpod.artifact_publication \
        recover \
        --proof-directory "$receipt_directory" \
        --state-directory "$operator_state_root" \
        --publication-id "$proof_id" 2>/dev/null
    )"
    if jq -e \
      --arg publication_id "$proof_id" \
      --arg profile_id "$larger_model_profile_id" \
      --arg publication_type "$larger_model_mode" \
      '
        .publication_id == $publication_id
        and .publication_type == $publication_type
        and .profile_id == $profile_id
        and .artifact_set_committed == true
        and (
          .artifact_set_manifest_digest
          | test("^sha256:[0-9a-f]{64}$")
        )
      ' >/dev/null 2>&1 <<<"$recovered_publication"; then
      artifact_set_committed=true
      if [[ "$larger_model_mode" == "screen" ]]; then
        failure_message="The completed larger-model eligibility screen could not be published."
      else
        failure_message="A verified local proof receipt is pending ingestion."
      fi
    fi
  fi

  if [[ -n "$bundle_source_path" ]]; then
    rm -f -- "$bundle_source_path"
    bundle_source_path=""
  fi

  if [[ "$pod_create_attempted" == true && -z "$pod_id" ]]; then
    reconcile_pod_id_by_name || true
  fi
  if [[ "$pod_create_attempted" == true && "$teardown_confirmed" != true ]]; then
    if confirm_provider_teardown; then
      teardown_confirmed=true
    fi
  else
    teardown_confirmed=true
  fi
  if [[ "$network_volume_deletion_required" == true &&
    "$pod_create_attempted" == true ]]; then
    if [[ "$teardown_confirmed" == true ]] &&
      confirm_managed_network_volume_deletion; then
      :
    else
      teardown_confirmed=false
    fi
    last_progress="$(
      jq -c \
        --argjson deletion_required "$network_volume_deletion_required" \
        --arg deletion_deadline "$network_volume_deletion_deadline" \
        --argjson deletion_attempted "$network_volume_deletion_attempted" \
        --argjson deletion_confirmed "$network_volume_deletion_confirmed" \
        --argjson deletion_deadline_met "$network_volume_deletion_deadline_met" \
        --arg deleted_at "$network_volume_deleted_at" \
        '. + {
          network_volume_deletion_required: $deletion_required,
          network_volume_deletion_deadline: $deletion_deadline,
          network_volume_deletion_attempted: $deletion_attempted,
          network_volume_deletion_confirmed: $deletion_confirmed,
          network_volume_deletion_deadline_met: $deletion_deadline_met,
          network_volume_deleted_at: (
            if $deleted_at == "" then null else $deleted_at end
          )
        }' <<<"$last_progress"
    )"
    if [[ "$network_volume_deletion_confirmed" == true &&
      "$volume_expiry_guard_active" == true ]]; then
      write_volume_expiry_guard_state \
        "volume-deletion-confirmed" 0 "$proof_id" ""
    fi
  elif [[ "$larger_model_mode" == "pilot" &&
    "$volume_expiry_guard_active" == true &&
    "$pod_create_attempted" != true ]]; then
    # A pilot that failed before any paid allocation must not cancel the
    # screened volume deadline. Return ownership to the bounded handoff lease.
    write_volume_expiry_guard_state \
      "awaiting-pilot" 0 "$source_screen_publication_id" ""
  fi
  if [[ "$larger_model_mode" == "screen" &&
    "$volume_expiry_guard_active" == true &&
    "$terminal_published" != true &&
    "$artifact_set_committed" == true ]]; then
    write_volume_expiry_guard_state \
      "awaiting-pilot" 0 "$proof_id" ""
  elif [[ "$larger_model_mode" == "screen" &&
    "$volume_expiry_guard_active" == true &&
    "$terminal_published" != true ]]; then
    write_volume_expiry_guard_state "screen-failed" 0 "$proof_id" "$pod_id"
    if [[ "$teardown_confirmed" == true ]] &&
      confirm_managed_network_volume_deletion true; then
      write_volume_expiry_guard_state \
        "volume-deletion-confirmed" 0 "$proof_id" ""
    else
      teardown_confirmed=false
    fi
  fi
  provider_teardown_confirmed="$teardown_confirmed"

  if [[ "$execution_registered" == true && "$terminal_published" != true ]]; then
    completed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    completed_epoch="$(date +%s)"
    provider_runtime_started_epoch="${provider_allocation_started_epoch:-$started_epoch}"
    provider_runtime_seconds="$((completed_epoch - provider_runtime_started_epoch))"
    observed_progress="$last_progress"
    operator_error="$(
      jq -cn \
        --arg message "$failure_message" \
        --argjson teardown_confirmed "$teardown_confirmed" \
        '{
          code: "RUNPOD_OPERATOR_FAILURE",
          message: $message,
          teardown_error: (
            if $teardown_confirmed
            then null
            else {
              code: "PROVIDER_TEARDOWN_UNCONFIRMED",
              message: "RunPod teardown could not be confirmed after reconciliation."
            }
            end
          )
        }'
    )"
    failed_progress="$(
      jq -c \
        --argjson operator_error "$operator_error" \
        --argjson teardown_confirmed "$teardown_confirmed" \
        '
          (
            .remote_error
            // (
              if (.error | type) == "string" and (.error | length) > 0
              then {
                code: (
                  if (.error | test("^[A-Z][A-Z0-9_]*$"))
                  then .error
                  else "REMOTE_WORKLOAD_FAILURE"
                  end
                ),
                message: (
                  if (
                    (.error | test("^[A-Z][A-Z0-9_]*$"))
                    and (.message | type) == "string"
                    and (.message | length) > 0
                  )
                  then .message
                  else .error
                  end
                )
              }
              else null
              end
            )
          ) as $remote_error
          | . + {
              phase: "failed",
              message: (
                if $remote_error == null
                then $operator_error.message
                else (.message // $remote_error.message)
                end
              ),
              remote_error: $remote_error,
              operator_error: $operator_error,
              teardown_confirmed: $teardown_confirmed
            }
          | if $remote_error == null then del(.error) else . end
        ' \
        <<<"$last_progress"
    )"
    remote_error="$(jq -c '.remote_error' <<<"$failed_progress")"
    provider_cli_version="$(
      run_provider_command 15 runpodctl version 2>/dev/null |
        awk 'NR == 1 { print $2 }'
    )"
    provider_cli_version="${provider_cli_version:-unknown}"
    failure_receipt="$(
      jq -cnS \
        --arg execution_id "$proof_id" \
        --arg provider_handle "$provider_handle" \
        --arg provider_cli_version "$provider_cli_version" \
        --arg execution_name "$execution_name" \
        --arg workload_id "$workload_id" \
        --arg model_id "$model_id" \
        --arg started_at "$started_at" \
        --arg completed_at "$completed_at" \
        --argjson branch_width "$expected_branch_width" \
        --argjson resource_profile "$resource_profile" \
        --argjson last_observed_progress "$observed_progress" \
        --argjson remote_error "$remote_error" \
        --argjson operator_error "$operator_error" \
        --argjson provider_runtime_seconds "$provider_runtime_seconds" \
        --argjson teardown_confirmed "$teardown_confirmed" \
        '{
          receipt_kind: "operational_failure@1",
          scientific_proof: false,
          proof_id: null,
          execution_id: $execution_id,
          execution_name: $execution_name,
          provider: {
            name: "RunPod",
            handle: (
              if $provider_handle == "" then null else $provider_handle end
            ),
            cli_version: $provider_cli_version
          },
          resource_profile: $resource_profile,
          handoff: {
            revision: ($resource_profile.bundle_handoff_revision // null),
            workload_bundle_digest: (
              $resource_profile.workload_bundle_digest // null
            ),
            workload_bundle_size_bytes: (
              $resource_profile.workload_bundle_size_bytes // null
            ),
            workload_bundle_path: (
              $resource_profile.workload_bundle_path // null
            ),
            bundle_stage_receipt_digest: (
              $resource_profile.bundle_stage_receipt_digest // null
            ),
            bootstrap_source_digest: (
              $resource_profile.bootstrap_source_digest // null
            ),
            network_volume_id: (
              $resource_profile.network_volume_id // null
            )
          },
          workload: {
            id: $workload_id,
            model_id: (if $model_id == "" then null else $model_id end),
            static_branch_width: $branch_width,
            complexity_strategy: "adaptive"
          },
          last_observed_progress: $last_observed_progress,
          remote_error: $remote_error,
          operator_error: $operator_error,
          cost: {
            total_usd: (
              if (
                ($resource_profile.hourly_cost_usd | type) == "number"
                and $provider_runtime_seconds >= 0
              )
              then (
                $resource_profile.hourly_cost_usd
                * $provider_runtime_seconds
                / 3600
              )
              else null
              end
            ),
            estimated: (
              ($resource_profile.hourly_cost_usd | type) == "number"
              and $provider_runtime_seconds >= 0
            ),
            hourly_rate_usd: (
              $resource_profile.hourly_cost_usd // null
            ),
            provider_runtime_seconds: $provider_runtime_seconds
          },
          started_at: $started_at,
          completed_at: $completed_at,
          teardown_confirmed: $teardown_confirmed
        }'
    )"
    if failure_receipt_digest="$(
      persist_operational_failure_receipt "$proof_id" "$failure_receipt"
    )"; then
      :
    else
      failure_receipt_digest=""
      echo "Operational failure evidence could not be persisted." >&2
    fi
    publish_execution \
      "FAILED" \
      "$failed_progress" \
      "$completed_at" \
      "$teardown_confirmed" \
      "" \
      "$failure_receipt_digest" || true
  fi
  if [[ "$teardown_confirmed" == true ]]; then
    cleanup_artifact_staging
    release_operator_lock
  else
    echo "RunPod teardown is unresolved; retaining $operator_lock_directory." >&2
  fi
  exit "$exit_code"
}
trap cleanup EXIT
trap 'failure_message="The operator interrupted the RunPod harness."; exit 130' INT TERM HUP

if provider_idle_state_is_safe; then
  :
else
  case "$?" in
    2)
      echo "Refusing to start: the RunPod account pod inventory is not empty and valid." >&2
      ;;
    3)
      echo "Refusing to start: the RunPod network-volume inventory is not exactly the verified configured volume." >&2
      ;;
    *)
      echo "Refusing to start: hourly spend exceeds the permitted idle baseline or could not be verified." >&2
      ;;
  esac
  exit 1
fi

curl --fail --silent --show-error --max-time 10 "$api_root/healthz" >/dev/null
curl --fail --silent --show-error --max-time 10 "$dashboard_root/runs" >/dev/null
research_executions="$(
  curl --fail --silent --show-error --max-time 10 \
    "$api_root/v1/research-compute-executions"
)"
stale_provider_cli_version="$(
  run_provider_command 15 runpodctl version 2>/dev/null |
    awk 'NR == 1 { print $2 }' || true
)"
stale_provider_cli_version="${stale_provider_cli_version:-unknown}"
stale_committed_publication_pending=false
while IFS= read -r stale_execution; do
  stale_id="$(jq -r '.execution_id' <<<"$stale_execution")"
  reconciled_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  stale_artifact_manifest="$receipt_directory/$stale_id.artifact-set.json"
  if [[ -f "$stale_artifact_manifest" ]] &&
    PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
      python3 -m research.runpod.artifact_publication \
      verify \
      --proof-directory "$receipt_directory" \
      --publication-id "$stale_id" \
      >/dev/null 2>&1; then
    if EQUINOX_INTERNAL_TOKEN="$internal_token" \
      "$repository_root/scripts/republish-runpod-proof" \
      --proof-directory "$receipt_directory" \
      --publication-id "$stale_id" \
      --api-root "$api_root" \
      --timeout-seconds 15 >/dev/null 2>&1; then
      echo "Recovered committed observer record $stale_id without provider compute." >&2
    else
      echo "Preserving committed observer record $stale_id for exact publication replay." >&2
      stale_committed_publication_pending=true
    fi
    continue
  fi
  stale_receipt_path="$receipt_directory/$stale_id.failure.json"
  if [[ -f "$stale_receipt_path" ]]; then
    stale_failure_receipt="$(<"$stale_receipt_path")"
    stale_failure_receipt_digest="$(
      persist_operational_failure_receipt \
        "$stale_id" \
        "$stale_failure_receipt"
    )"
    stale_observed_progress="$(
      jq -ce '.last_observed_progress' <<<"$stale_failure_receipt"
    )"
    stale_remote_error="$(jq -c '.remote_error' <<<"$stale_failure_receipt")"
    stale_operator_error="$(jq -ce '.operator_error' <<<"$stale_failure_receipt")"
    stale_teardown_confirmed="$(
      jq -r '.teardown_confirmed' <<<"$stale_failure_receipt"
    )"
    orphan_completed_at="$(jq -r '.completed_at // empty' <<<"$stale_failure_receipt")"
    if [[ "$orphan_completed_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]]; then
      reconciled_at="$orphan_completed_at"
    fi
  else
    stale_observed_progress="$(jq -c '.progress' <<<"$stale_execution")"
    stale_operator_error="$(
      jq -cn \
        '{
          code: "STALE_OPERATOR_RECONCILIATION",
          message: "No RunPod pod or active hourly spend remained.",
          teardown_error: null
        }'
    )"
    stale_teardown_confirmed=true
    stale_remote_error="$(
      jq -c \
        '
          .remote_error
          // (
            if (.error | type) == "string" and (.error | length) > 0
            then {
              code: (
                if (.error | test("^[A-Z][A-Z0-9_]*$"))
                then .error
                else "REMOTE_WORKLOAD_FAILURE"
                end
              ),
              message: (
                if (
                  (.error | test("^[A-Z][A-Z0-9_]*$"))
                  and (.message | type) == "string"
                  and (.message | length) > 0
                )
                then .message
                else .error
                end
              )
            }
            else null
            end
          )
        ' <<<"$stale_observed_progress"
    )"
    stale_provider_runtime_seconds="$(
      jq -r \
        '
          .progress.elapsed_seconds as $elapsed
          | .resource_profile.maximum_lifetime_minutes as $maximum_minutes
          | if (
              ($elapsed | type) == "number"
              and $elapsed >= 0
              and ($maximum_minutes | type) == "number"
              and $maximum_minutes > 0
              and $elapsed <= ($maximum_minutes * 60)
            )
            then $elapsed
            else null
            end
        ' <<<"$stale_execution"
    )"
    stale_failure_receipt="$(
      jq -cnS \
        --argjson execution "$stale_execution" \
        --argjson last_observed_progress "$stale_observed_progress" \
        --argjson remote_error "$stale_remote_error" \
        --argjson operator_error "$stale_operator_error" \
        --arg provider_cli_version "$stale_provider_cli_version" \
        --arg completed_at "$reconciled_at" \
        --argjson provider_runtime_seconds "$stale_provider_runtime_seconds" \
        '{
          receipt_kind: "operational_failure@1",
          scientific_proof: false,
          proof_id: null,
          execution_id: $execution.execution_id,
          execution_name: $execution.name,
          provider: {
            name: "RunPod",
            handle: $execution.provider_handle,
            cli_version: $provider_cli_version
          },
          resource_profile: $execution.resource_profile,
          handoff: {
            revision: (
              $execution.resource_profile.bundle_handoff_revision // null
            ),
            workload_bundle_digest: (
              $execution.resource_profile.workload_bundle_digest // null
            ),
            workload_bundle_size_bytes: (
              $execution.resource_profile.workload_bundle_size_bytes // null
            ),
            workload_bundle_path: (
              $execution.resource_profile.workload_bundle_path // null
            ),
            bundle_stage_receipt_digest: (
              $execution.resource_profile.bundle_stage_receipt_digest // null
            ),
            bootstrap_source_digest: (
              $execution.resource_profile.bootstrap_source_digest // null
            ),
            network_volume_id: (
              $execution.resource_profile.network_volume_id // null
            )
          },
          workload: {
            id: $execution.workload_id,
            model_id: $execution.model_id,
            static_branch_width: $execution.branch_width,
            complexity_strategy: $execution.complexity_strategy
          },
          last_observed_progress: $last_observed_progress,
          remote_error: $remote_error,
          operator_error: $operator_error,
          cost: {
            total_usd: (
              if (
                ($execution.resource_profile.hourly_cost_usd | type) == "number"
                and ($provider_runtime_seconds | type) == "number"
              )
              then (
                $execution.resource_profile.hourly_cost_usd
                * $provider_runtime_seconds
                / 3600
              )
              else null
              end
            ),
            estimated: (
              ($execution.resource_profile.hourly_cost_usd | type) == "number"
              and ($provider_runtime_seconds | type) == "number"
            ),
            hourly_rate_usd: (
              $execution.resource_profile.hourly_cost_usd // null
            ),
            provider_runtime_seconds: $provider_runtime_seconds
          },
          started_at: $execution.started_at,
          completed_at: $completed_at,
          teardown_confirmed: true
        }'
    )"
    stale_failure_receipt_digest="$(
      persist_operational_failure_receipt \
        "$stale_id" \
        "$stale_failure_receipt"
    )"
  fi
  stale_failed_progress="$(
    jq -c \
      --argjson operator_error "$stale_operator_error" \
      --argjson remote_error "$stale_remote_error" \
      --argjson teardown_confirmed "$stale_teardown_confirmed" \
      '
        . + {
            phase: "failed",
            message: (
              if $remote_error == null
              then "Reconciled after the operator process stopped."
              else (.message // $remote_error.message)
              end
            ),
            remote_error: $remote_error,
            operator_error: $operator_error,
            teardown_confirmed: $teardown_confirmed
          }
        | if $remote_error == null then del(.error) else . end
      ' <<<"$stale_observed_progress"
  )"
  stale_payload="$(
    jq -c \
      --argjson progress "$stale_failed_progress" \
      --arg completed_at "$reconciled_at" \
      --arg failure_receipt_digest "$stale_failure_receipt_digest" \
      --argjson teardown_confirmed "$stale_teardown_confirmed" \
      '{
        name,
        workload_id,
        model_id,
        branch_width,
        complexity_strategy,
        status: "FAILED",
        provider_name,
        provider_handle,
        resource_profile,
        progress: $progress,
        artifact_publication_required: (.artifact_publication_required // false),
        artifact_publication: (.artifact_publication // null),
        failure_receipt_digest: $failure_receipt_digest,
        started_at,
        completed_at: $completed_at,
        teardown_confirmed: $teardown_confirmed
      }' <<<"$stale_execution"
  )"
  curl --fail --silent --show-error --max-time 15 \
    -X PUT "$api_root/internal/research-compute-executions/$stale_id" \
    -H "Authorization: Bearer $internal_token" \
    -H 'Content-Type: application/json' \
    --data-binary @- <<<"$stale_payload" >/dev/null
  echo "Reconciled stale observer record $stale_id; no RunPod worker remained." >&2
done < <(
  jq -c \
    '.items[] | select(
      .status == "PROVISIONING"
      or .status == "RUNNING"
      or .status == "FINALIZING"
    )' \
    <<<"$research_executions"
)
if [[ "$stale_committed_publication_pending" == true ]]; then
  echo "Refusing to allocate while a committed artifact set still requires exact observer replay." >&2
  exit 1
fi

failure_message="The observer API did not accept the provisioning record."
publish_execution "PROVISIONING" "$last_progress"
execution_registered=true

if ! provider_idle_state_is_safe; then
  failure_message="RunPod provider state changed after observer registration."
  echo "Refusing to allocate: the zero-pod storage-only idle state changed before pod creation." >&2
  exit 1
fi

if [[ -n "$larger_model_mode" ]]; then
  failure_message="The pinned container image changed before pod creation."
  if ! verify_pinned_image_tag; then
    echo "Refusing to allocate: the pinned container image could not be reverified." >&2
    exit 1
  fi
fi
deployment_image="$image"
if [[ -n "$larger_model_mode" ]]; then
  deployment_image="$image@$verified_image_digest"
fi

if ! provider_live_stage_campaign_is_allowed; then
  failure_message="The authorized RunPod campaign budget changed before allocation."
  echo "Refusing to allocate: the remaining campaign budget no longer covers this allocation and its required reserves." >&2
  exit 1
fi

if [[ -n "$larger_model_mode" ]]; then
  failure_message="The RunPod market price could not be bounded before allocation."
  if ! market_price_attestation="$(provider_market_price_attestation)"; then
    echo "Refusing to allocate: a just-in-time Secure Cloud offer at or below the hourly ceiling was not attested." >&2
    exit 1
  fi
  if ! printf '%s\n' "$market_price_attestation" |
    durable_write_stdin "$operator_lock_directory/market-price-attestation.json"; then
    echo "Refusing to allocate: the market-price attestation could not be persisted." >&2
    exit 1
  fi
fi

if [[ "$larger_model_mode" == "screen" ]]; then
  failure_message="The screen volume-expiry guard could not be armed before allocation."
  if ! arm_screen_volume_expiry_guard; then
    exit 1
  fi
elif [[ "$larger_model_mode" == "pilot" ]]; then
  failure_message="The pilot could not take over the screened volume-expiry guard."
  if ! attach_pilot_volume_expiry_guard; then
    exit 1
  fi
fi

provider_allocation_started_epoch="$(date +%s)"
boot_started_epoch="$provider_allocation_started_epoch"
readiness_deadline_epoch=$((provider_allocation_started_epoch + boot_timeout_seconds))
if [[ "$live_stage_enabled" == true ]]; then
  pod_environment="$(
    jq -c \
      --arg readiness_deadline_epoch "$readiness_deadline_epoch" \
      '. + {
        EQUINOX_LIVE_STAGE_READINESS_DEADLINE_EPOCH:
          $readiness_deadline_epoch
      }' <<<"$pod_environment"
  )"
  pod_environment_size_bytes="$(printf '%s' "$pod_environment" | wc -c | tr -d ' ')"
  if ((pod_environment_size_bytes > 4 * 1024)); then
    failure_message="The allocation-time live-stage environment exceeded the bounded transport size."
    echo "The allocation-time live-stage environment exceeds the 4 KiB transport limit." >&2
    exit 1
  fi
elif [[ "$larger_model_mode" == "pilot" ]]; then
  pod_environment="$(
    jq -c \
      --arg private_materialization_deadline_epoch "$readiness_deadline_epoch" \
      '. + {
        EQUINOX_PRIVATE_MATERIALIZATION_DEADLINE_EPOCH:
          $private_materialization_deadline_epoch
      }' <<<"$pod_environment"
  )"
  pod_environment_size_bytes="$(printf '%s' "$pod_environment" | wc -c | tr -d ' ')"
  if ((pod_environment_size_bytes > 4 * 1024)); then
    failure_message="The allocation-time pilot materialization environment exceeded the bounded transport size."
    echo "The pilot private-materialization environment exceeds the 4 KiB transport limit." >&2
    exit 1
  fi
fi
terminate_after="$(
  python3 - "$provider_allocation_started_epoch" "$((maximum_lifetime_minutes * 60))" <<'PY'
from datetime import UTC, datetime
import sys

deadline = datetime.fromtimestamp(int(sys.argv[1]) + int(sys.argv[2]), UTC)
print(deadline.isoformat(timespec="seconds").replace("+00:00", "Z"))
PY
)"
if [[ "$network_volume_deletion_required" == true ]]; then
  candidate_network_volume_deletion_deadline_epoch=$((
    provider_allocation_started_epoch +
      maximum_lifetime_minutes * 60 +
      network_volume_deletion_reserve_seconds
  ))
  if ((network_volume_deletion_deadline_epoch <= 0 ||
    candidate_network_volume_deletion_deadline_epoch <
      network_volume_deletion_deadline_epoch)); then
    network_volume_deletion_deadline_epoch="$candidate_network_volume_deletion_deadline_epoch"
  fi
  network_volume_deletion_deadline="$(
    python3 - "$network_volume_deletion_deadline_epoch" <<'PY'
from datetime import UTC, datetime
import sys

deadline = datetime.fromtimestamp(int(sys.argv[1]), UTC)
print(deadline.isoformat(timespec="seconds").replace("+00:00", "Z"))
PY
  )"
fi
if ! jq \
    --arg terminate_after "$terminate_after" \
    --arg readiness_deadline_epoch "$readiness_deadline_epoch" \
    --argjson network_volume_deletion_required "$network_volume_deletion_required" \
    --arg network_volume_deletion_deadline "$network_volume_deletion_deadline" \
    --arg network_volume_id "$network_volume_id" \
    --argjson volume_expiry_guard_active "$volume_expiry_guard_active" \
    --arg volume_expiry_guard_id "$volume_expiry_guard_id" \
    --arg volume_expiry_guard_deadline "$volume_expiry_guard_deadline" \
    --arg volume_expiry_guard_directory "$volume_expiry_guard_directory" \
    '. + {
      terminate_after: $terminate_after,
      readiness_deadline_epoch: ($readiness_deadline_epoch | tonumber),
      network_volume_deletion_required: $network_volume_deletion_required,
      network_volume_deletion_deadline: (
        if $network_volume_deletion_required
        then $network_volume_deletion_deadline
        else null
        end
      ),
      network_volume_id: (
        if $network_volume_deletion_required then $network_volume_id else null end
      ),
      volume_expiry_guard_active: $volume_expiry_guard_active,
      volume_expiry_guard_id: (
        if $volume_expiry_guard_active then $volume_expiry_guard_id else null end
      ),
      volume_expiry_guard_deadline: (
        if $volume_expiry_guard_active
        then $volume_expiry_guard_deadline
        else null
        end
      ),
      volume_expiry_guard_directory: (
        if $volume_expiry_guard_active
        then $volume_expiry_guard_directory
        else null
        end
      ),
      state: "allocating"
    }' \
    "$operator_lock_directory/lease.json" |
  durable_write_stdin "$operator_lock_directory/lease.json"; then
  failure_message="The exact provider deadline could not be persisted before allocation."
  echo "Refusing to allocate: the paid deadline lease could not be persisted." >&2
  exit 1
fi

echo "Creating one bounded RunPod worker; provider deadline: $terminate_after" >&2
failure_message="RunPod pod creation failed before a provider handle was returned."
create_arguments=(
  pod create
  --name "$pod_name"
  --image "$deployment_image"
  --gpu-id "$gpu_id"
  --gpu-count 1
  --cloud-type "$cloud_type"
  --container-disk-in-gb "$container_disk_in_gb"
  --volume-mount-path "/workspace"
  --ports "8000/http"
  --ssh=false
  --env "$pod_environment"
  --docker-args "$docker_args"
  --terminate-after "$terminate_after"
)
if [[ -n "$network_volume_id" ]]; then
  create_arguments+=(--network-volume-id "$network_volume_id")
else
  create_arguments+=(--volume-in-gb "$persistent_volume_in_gb")
fi
if [[ -n "$data_center_ids" ]]; then
  create_arguments+=(--data-center-ids "$data_center_ids")
fi
pod_create_attempted=true
if [[ "$larger_model_mode" == "pilot" ]]; then
  if ! jq -n \
      --arg proof_id "$proof_id" \
      --arg screen_result_digest "$larger_model_screen_result_digest" \
      --arg authorization_digest "$larger_model_authorization_digest" \
      --arg consumed_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
      '{
        proof_id: $proof_id,
        screen_result_digest: $screen_result_digest,
        authorization_digest: $authorization_digest,
        consumed_at: $consumed_at
      }' |
    durable_create_stdin "$authorization_consumption_path" 2>/dev/null; then
    pod_create_attempted=false
    echo "The matching larger-model screen authorization was consumed concurrently." >&2
    exit 1
  fi
fi
if ! create_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 90
)"; then
  echo "The paid readiness deadline expired before pod creation." >&2
  exit 1
fi
set +e
create_response="$(run_provider_command "$create_timeout" runpodctl "${create_arguments[@]}")"
create_exit_code="$?"
set -e
pod_id="$(jq -r '.id // .pod.id // empty' <<<"$create_response" 2>/dev/null || true)"
if [[ "$pod_id" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  provider_handle="runpod://pods/$pod_id"
  provider_allocation_observed=true
  touch_volume_expiry_guard
  if [[ "$create_exit_code" != "0" ]]; then
    failure_message="RunPod pod creation returned a valid pod id with a failed command status."
    echo "RunPod returned $pod_id with status $create_exit_code; cleanup will delete that exact pod." >&2
    exit 1
  fi
else
  pod_id=""
  ambiguous_create_unresolved=true
  ambiguous_create_safe_after_epoch="$(
    python3 - "$terminate_after" "$ambiguous_create_termination_grace_seconds" <<'PY'
from datetime import datetime
import sys

deadline = datetime.fromisoformat(sys.argv[1].replace("Z", "+00:00"))
print(int(deadline.timestamp()) + int(sys.argv[2]))
PY
  )"
  ambiguous_create_reconciliation_seconds=$((
    ambiguous_create_safe_after_epoch - $(date +%s) + cleanup_reserve_seconds
  ))
  if ((ambiguous_create_reconciliation_seconds < cleanup_reserve_seconds)); then
    ambiguous_create_reconciliation_seconds="$cleanup_reserve_seconds"
  fi
  if reconcile_pod_id_by_name; then
    failure_message="RunPod pod creation returned ambiguously after allocating a worker."
    echo "Reconciled ambiguous pod creation to $pod_id; cleanup will delete it." >&2
  else
    failure_message="RunPod pod creation failed and provider state could not be reconciled."
    echo "RunPod did not return a valid pod id; refusing to assume no worker exists." >&2
  fi
  exit 1
fi

failure_message="RunPod did not report a bounded hourly rate."
if ! attestation_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 30
)"; then
  echo "The paid readiness deadline expired before provider attestation." >&2
  exit 1
fi
pod_response="$(run_provider_command "$attestation_timeout" runpodctl pod get "$pod_id")"
hourly_cost="$(
  jq -r '.adjustedCostPerHr // .costPerHr // .costPerHour // empty' <<<"$pod_response"
)"
if [[ -n "$larger_model_mode" ]]; then
  if ! jq -e \
    --arg pod_id "$pod_id" \
    --arg deployment_image "$deployment_image" \
    --arg gpu_id "$gpu_id" \
    --arg cloud_type "$cloud_type" \
    --arg volume_id "$network_volume_id" \
    --arg data_center_id "$network_volume_data_center_id" \
    --arg terminate_after "$terminate_after" \
    --argjson container_disk_in_gb "$container_disk_in_gb" \
    '
      .id == $pod_id
      and .imageName == $deployment_image
      and .gpuId == $gpu_id
      and .gpuCount == 1
      and .cloudType == $cloud_type
      and .networkVolumeId == $volume_id
      and .dataCenterId == $data_center_id
      and .volumeMountPath == "/workspace"
      and .terminateAfter == $terminate_after
      and .containerDiskInGb == $container_disk_in_gb
    ' >/dev/null 2>&1 <<<"$pod_response"; then
    failure_message="RunPod did not attest the exact image and mounted network volume."
    echo "The allocated worker did not report the exact requested image and volume attachment; terminating." >&2
    exit 1
  fi
fi
if [[ -z "$hourly_cost" ]]; then
  echo "RunPod did not report an hourly cost; terminating rather than running unbounded." >&2
  exit 1
fi
if ! jq -en \
  --argjson observed "$hourly_cost" \
  --argjson maximum "$maximum_hourly_cost" \
  '$observed > 0 and $observed <= $maximum' >/dev/null; then
  echo "Hourly cost must be positive and no more than the \$$maximum_hourly_cost ceiling." >&2
  exit 1
fi
if [[ "$live_stage_enabled" == true ]] &&
  ! jq -en \
    --argjson observed "$hourly_cost" \
    --argjson conservative_seconds "$conservative_billing_seconds" \
    --argjson maximum_total "$maximum_total_cost" \
    '$observed > 0
      and (($observed * $conservative_seconds / 3600) <= $maximum_total)' \
    >/dev/null; then
  failure_message="The allocated rate exceeded the conservative screen cost envelope."
  echo "The allocated worker rate cannot fit the 3000-second screen cost gate; terminating." >&2
  exit 1
fi
resource_profile="$(
  jq -cn \
    --arg larger_model_profile_id "$larger_model_profile_id" \
    --arg gpu_id "$gpu_id" \
    --arg image "$image" \
    --arg image_digest "$verified_image_digest" \
    --arg cloud_type "$cloud_type" \
    --arg data_center_ids "$data_center_ids" \
    --arg network_volume_id "$network_volume_id" \
    --arg network_volume_data_center_id "$network_volume_data_center_id" \
    --arg volume_readiness_receipt_digest "$volume_readiness_receipt_digest" \
    --arg bundle_stage_receipt_digest "$bundle_stage_receipt_digest" \
    --arg bootstrap_source_digest "$bootstrap_source_digest" \
    --arg bundle_handoff_revision "$bundle_handoff_revision" \
    --arg workload_bundle_path "$bundle_volume_path" \
    --arg workload_bundle_digest "$bundle_digest" \
    --arg workload_bundle_compression "xz" \
    --argjson persistent_volume_in_gb "$persistent_volume_in_gb" \
    --argjson hourly_cost "$hourly_cost" \
    --argjson workload_bundle_size_bytes "$bundle_size_bytes" \
    --argjson maximum_hourly_cost "$maximum_hourly_cost" \
    --argjson maximum_total_cost "$maximum_total_cost" \
    --argjson minimum_gpu_memory_gb "$minimum_gpu_memory_gb" \
    --argjson model_load_timeout_seconds "$model_load_timeout_seconds" \
    --argjson stale_progress_timeout_seconds "$stale_progress_timeout_seconds" \
    '{
      gpu_id: $gpu_id,
      gpu_count: 1,
      image: $image,
      image_digest: (
        if $image_digest == "" then null else $image_digest end
      ),
      cloud_type: $cloud_type,
      data_center_ids: (
        if $data_center_ids == ""
        then null
        else ($data_center_ids | split(","))
        end
      ),
      persistent_volume_in_gb: $persistent_volume_in_gb,
      network_volume_id: (
        if $network_volume_id == "" then null else $network_volume_id end
      ),
      network_volume_data_center_id: (
        if $network_volume_data_center_id == ""
        then null
        else $network_volume_data_center_id
        end
      ),
      volume_readiness_receipt_digest: (
        if $volume_readiness_receipt_digest == ""
        then null
        else $volume_readiness_receipt_digest
        end
      ),
      bundle_stage_receipt_digest: (
        if $bundle_stage_receipt_digest == ""
        then null
        else $bundle_stage_receipt_digest
        end
      ),
      bootstrap_source_digest: $bootstrap_source_digest,
      bundle_handoff_revision: (
        if $bundle_stage_receipt_digest == "" then null else $bundle_handoff_revision end
      ),
      workload_bundle_digest: $workload_bundle_digest,
      workload_bundle_size_bytes: $workload_bundle_size_bytes,
      workload_bundle_compression: $workload_bundle_compression,
      workload_bundle_path: (
        if $workload_bundle_path == "" then null else $workload_bundle_path end
      ),
      hourly_cost_usd: $hourly_cost,
      maximum_hourly_cost_usd: $maximum_hourly_cost,
      maximum_total_cost_usd: $maximum_total_cost,
      minimum_gpu_memory_gb: $minimum_gpu_memory_gb,
      model_load_timeout_seconds: $model_load_timeout_seconds,
      stale_progress_timeout_seconds: $stale_progress_timeout_seconds
    }
    + (
      if $larger_model_profile_id == ""
      then {}
      else {profile_id: $larger_model_profile_id}
      end
    )'
)"
if [[ "$larger_model_mode" == "pilot" ]]; then
  resource_profile="$(
    jq -c \
      --arg profile_id "$larger_model_profile_id" \
      --arg manifest_digest "$larger_model_manifest_digest" \
      --arg source_head_commit "$source_head_commit" \
      --arg source_contract_digest "$larger_model_source_contract_digest" \
      --arg live_stage_activation_revision "$authorized_live_stage_activation_revision" \
      --arg live_stage_activation_digest "$bundle_activation_digest" \
      --arg torch_retention_evidence_digest "$torch_retention_evidence_digest" \
      --arg dependency_quarantine_revision "$dependency_quarantine_revision" \
      --arg dependency_lock_digest "$dependency_lock_digest" \
      --arg dependency_quarantine_evidence_digest "$dependency_quarantine_evidence_digest" \
      --arg dependency_private_tree_digest "$dependency_private_tree_digest" \
      --arg code_materialization_revision "$code_materialization_revision" \
      --arg code_materialization_evidence_digest "$code_materialization_evidence_digest" \
      --arg code_private_tree_digest "$code_private_tree_digest" \
      --argjson network_volume_size_gb "$network_volume_verified_size_gb" \
      '. + {
        profile_id: $profile_id,
        manifest_digest: $manifest_digest,
        source_head_commit: $source_head_commit,
        source_contract_digest: $source_contract_digest,
        live_stage_activation_revision: $live_stage_activation_revision,
        live_stage_activation_digest: $live_stage_activation_digest,
        bundle_activation_digest: $live_stage_activation_digest,
        torch_retention_evidence_digest: $torch_retention_evidence_digest,
        dependency_quarantine_revision: $dependency_quarantine_revision,
        dependency_lock_digest: $dependency_lock_digest,
        dependency_quarantine_evidence_digest:
          $dependency_quarantine_evidence_digest,
        dependency_private_tree_digest: $dependency_private_tree_digest,
        code_materialization_revision: $code_materialization_revision,
        code_materialization_evidence_digest:
          $code_materialization_evidence_digest,
        code_private_tree_digest: $code_private_tree_digest,
        network_volume_size_gb: $network_volume_size_gb
      }' <<<"$resource_profile"
  )"
  if ! (
    umask 077
    mkdir "$artifact_staging_directory"
    chmod 700 "$artifact_staging_directory"
    fsync_directory "$operator_lock_directory"
  ); then
    failure_message="The local pilot artifact transaction could not be initialized."
    echo "The local pilot artifact transaction could not be initialized; terminating." >&2
    exit 1
  fi
  bundle_stage_receipt_path="$artifact_staging_directory/bundle-receipt.json"
  remote_volume_receipt_path="$artifact_staging_directory/readiness-receipt.json"
  torch_retention_evidence_path="$artifact_staging_directory/torch-evidence.json"
  if ! durable_write_stdin "$bundle_stage_receipt_path" <"$bundle_stage_receipt" ||
    ! durable_write_stdin "$remote_volume_receipt_path" <"$volume_readiness_receipt" ||
    ! durable_write_stdin "$torch_retention_evidence_path" <"$torch_retention_evidence"; then
    failure_message="The inherited pilot evidence could not be staged transactionally."
    echo "The inherited pilot evidence could not be staged transactionally; terminating." >&2
    exit 1
  fi
fi
if [[ "$live_stage_enabled" == true ]]; then
if ! (
  umask 077
  mkdir "$artifact_staging_directory"
  chmod 700 "$artifact_staging_directory"
  fsync_directory "$operator_lock_directory"
); then
  failure_message="The local artifact transaction could not be initialized."
  echo "The local artifact transaction could not be initialized; terminating." >&2
  exit 1
fi
last_progress="$(
  jq -cn \
    --argjson maximum_updates "$maximum_updates" \
    '{
      phase: "waiting_for_worker",
      message: "Waiting for worker.",
      maximum_level: 3,
      maximum_updates: $maximum_updates
    }'
)"
failure_message="The RunPod worker never exposed the authenticated staging endpoint."
publish_execution "PROVISIONING" "$last_progress" "" false "$readiness_deadline_epoch"

proxy_root="https://${pod_id}-8000.proxy.runpod.net"
bootstrap_health_url="$proxy_root/bootstrap-health"
bundle_upload_url="$proxy_root/bundle"
bundle_activation_url="$proxy_root/activate-staged-bundle"
bundle_stage_receipt_url="$proxy_root/bundle-stage-receipt.json"
volume_readiness_receipt_url="$proxy_root/volume-readiness-receipt.json"
torch_retention_evidence_url="$proxy_root/torch-retention-evidence.json"
dependency_quarantine_evidence_url="$proxy_root/dependency-quarantine-evidence.json"
code_materialization_evidence_url="$proxy_root/code-materialization-evidence.json"
progress_url="$proxy_root/progress.json"
remote_authorization="Authorization: Bearer $transport_token"
exit_code=""
workload_transport_ready=false
preparation_started_epoch=""

if ! volume_attestation_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 30
)"; then
  echo "The paid readiness deadline expired before volume attestation." >&2
  exit 1
fi
if ! network_volume="$(
  run_provider_command "$volume_attestation_timeout" \
    runpodctl network-volume get "$network_volume_id"
)" ||
  ! jq -e \
    --arg volume_id "$network_volume_id" \
    --arg data_center_id "$network_volume_data_center_id" \
    --argjson volume_size "$network_volume_verified_size_gb" \
    '
      (.networkVolume // .) as $volume
      | ($volume.id // $volume.networkVolumeId) == $volume_id
        and $volume.dataCenterId == $data_center_id
        and $volume.size == $volume_size
    ' >/dev/null 2>&1 <<<"$network_volume"; then
  failure_message="The network volume changed before authenticated upload."
  echo "The exact mounted network volume could not be re-attested; terminating." >&2
  exit 1
fi

bootstrap_transport_ready=false
attempt=0
while readiness_poll_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 10
)"; do
  touch_volume_expiry_guard
  attempt=$((attempt + 1))
  bootstrap_health="$(
    curl --fail --silent --show-error --max-time "$readiness_poll_timeout" \
      -H "$remote_authorization" "$bootstrap_health_url" 2>/dev/null || true
  )"
  if [[ -n "$bootstrap_health" ]] &&
    jq -e \
      --arg revision "authenticated-proxy-bundle-bootstrap@1" \
      --arg profile_id "$larger_model_profile_id" \
      --arg head_commit "$source_head_commit" \
      --arg manifest_digest "$larger_model_manifest_digest" \
      --arg source_contract_digest "$larger_model_source_contract_digest" \
      --arg bootstrap_source_digest "$bootstrap_source_digest" \
      --arg workload_bundle_digest "$bundle_digest" \
      --argjson workload_bundle_size_bytes "$bundle_size_bytes" \
      --arg workload_bundle_path "$bundle_volume_path" \
      --arg network_volume_id "$network_volume_id" \
      --arg network_volume_data_center_id "$network_volume_data_center_id" \
      --argjson network_volume_size_gb "$network_volume_verified_size_gb" \
      --argjson readiness_deadline_epoch "$readiness_deadline_epoch" \
      '
        (keys | sort) == (
          [
            "activation_digest",
            "bootstrap_source_digest",
            "bundle_stage_receipt_digest",
            "code_materialization_evidence_digest",
            "code_private_tree_digest",
            "dependency_private_tree_digest",
            "dependency_quarantine_evidence_digest",
            "dependency_lock_digest",
            "head_commit",
            "manifest_digest",
            "network_volume_data_center_id",
            "network_volume_id",
            "network_volume_size_gb",
            "profile_id",
            "readiness_deadline_epoch",
            "revision",
            "source_contract_digest",
            "status",
            "torch_retention_evidence_digest",
            "volume_readiness_receipt_digest",
            "workload_bundle_digest",
            "workload_bundle_path",
            "workload_bundle_size_bytes"
          ] | sort
        )
        and .revision == $revision
        and .status == "awaiting_bundle"
        and .profile_id == $profile_id
        and .head_commit == $head_commit
        and .manifest_digest == $manifest_digest
        and .source_contract_digest == $source_contract_digest
        and .bootstrap_source_digest == $bootstrap_source_digest
        and .workload_bundle_digest == $workload_bundle_digest
        and .workload_bundle_size_bytes == $workload_bundle_size_bytes
        and .workload_bundle_path == $workload_bundle_path
        and .network_volume_id == $network_volume_id
        and .network_volume_data_center_id == $network_volume_data_center_id
        and .network_volume_size_gb == $network_volume_size_gb
        and .readiness_deadline_epoch == $readiness_deadline_epoch
        and .bundle_stage_receipt_digest == null
        and .volume_readiness_receipt_digest == null
        and .torch_retention_evidence_digest == null
        and .dependency_quarantine_evidence_digest == null
        and .dependency_lock_digest == null
        and .dependency_private_tree_digest == null
        and .code_materialization_evidence_digest == null
        and .code_private_tree_digest == null
        and .activation_digest == null
      ' >/dev/null 2>&1 <<<"$bootstrap_health"; then
    bootstrap_transport_ready=true
    break
  fi
  if ((attempt == 1 || attempt % 3 == 0)); then
    last_progress="$(
      jq -cn \
        --argjson maximum_updates "$maximum_updates" \
        --argjson elapsed_seconds "$(($(date +%s) - boot_started_epoch))" \
        '{
          phase: "waiting_for_worker",
          message: "Waiting for worker.",
          elapsed_seconds: $elapsed_seconds,
          maximum_level: 3,
          maximum_updates: $maximum_updates
        }'
    )"
    publish_execution "PROVISIONING" "$last_progress" "" false "$readiness_deadline_epoch"
  fi
  if ! readiness_sleep_seconds="$(
    seconds_until_deadline "$readiness_deadline_epoch" 5
  )"; then
    break
  fi
  sleep "$readiness_sleep_seconds"
done
if [[ "$bootstrap_transport_ready" != true ]]; then
  echo "The worker did not expose the exact authenticated staging plan before timeout." >&2
  exit 1
fi

last_progress="$(
  jq -cn \
    --argjson maximum_updates "$maximum_updates" \
    '{
      phase: "staging",
      message: "Staging workload.",
      maximum_level: 3,
      maximum_updates: $maximum_updates
    }'
)"
failure_message="The one-shot authenticated workload upload did not produce verified staging evidence."
publish_execution "RUNNING" "$last_progress" "" false "$readiness_deadline_epoch"

if ! bundle_upload_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 60
)"; then
  echo "The paid readiness deadline expired before the one-shot bundle upload." >&2
  exit 1
fi
set +e
bundle_upload_response="$(
  curl --silent --show-error --http1.1 --max-time "$bundle_upload_timeout" \
    -X POST \
    -H "$remote_authorization" \
    -H "Content-Type: application/x-xz" \
    -H "Content-Length: $bundle_size_bytes" \
    -H "Expect:" \
    --data-binary "@$bundle_source_path" \
    --write-out $'\n%{http_code}' \
    "$bundle_upload_url"
)"
bundle_upload_exit_code="$?"
set -e
bundle_upload_status=""
bundle_upload_body=""
if [[ "$bundle_upload_response" == *$'\n'* ]]; then
  bundle_upload_status="${bundle_upload_response##*$'\n'}"
  bundle_upload_body="${bundle_upload_response%$'\n'*}"
fi
if [[ "$bundle_upload_status" =~ ^[45][0-9][0-9]$ ]]; then
  failure_message="The bootstrap endpoint explicitly rejected the authenticated workload bundle."
  echo "The bootstrap endpoint rejected the one-shot bundle upload with HTTP $bundle_upload_status." >&2
  exit 1
fi
bundle_upload_acknowledged=false
if [[ "$bundle_upload_exit_code" == "0" &&
  "$bundle_upload_status" =~ ^2[0-9][0-9]$ ]] &&
  jq -e \
    --arg workload_bundle_digest "$bundle_digest" \
    '
      .status == "awaiting_stage_activation"
      and .workload_bundle_digest == $workload_bundle_digest
      and (.bundle_stage_receipt_digest | test("^sha256:[0-9a-f]{64}$"))
      and (.volume_readiness_receipt_digest | test("^sha256:[0-9a-f]{64}$"))
      and (.torch_retention_evidence_digest | test("^sha256:[0-9a-f]{64}$"))
      and (.dependency_quarantine_evidence_digest | test("^sha256:[0-9a-f]{64}$"))
      and (.dependency_lock_digest | test("^sha256:[0-9a-f]{64}$"))
      and (.dependency_private_tree_digest | test("^sha256:[0-9a-f]{64}$"))
      and (.code_materialization_evidence_digest | test("^sha256:[0-9a-f]{64}$"))
      and (.code_private_tree_digest | test("^sha256:[0-9a-f]{64}$"))
      and .activation_digest == null
    ' >/dev/null 2>&1 <<<"$bundle_upload_body"; then
  bundle_upload_acknowledged=true
fi

stage_evidence_ready=false
while readiness_poll_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 10
)"; do
  bootstrap_health="$(
    curl --fail --silent --show-error --max-time "$readiness_poll_timeout" \
      -H "$remote_authorization" "$bootstrap_health_url" 2>/dev/null || true
  )"
  if [[ -n "$bootstrap_health" ]] &&
    jq -e \
      --arg profile_id "$larger_model_profile_id" \
      --arg head_commit "$source_head_commit" \
      --arg workload_bundle_digest "$bundle_digest" \
      '
        .status == "awaiting_stage_activation"
        and .profile_id == $profile_id
        and .head_commit == $head_commit
        and .workload_bundle_digest == $workload_bundle_digest
        and (.bundle_stage_receipt_digest | test("^sha256:[0-9a-f]{64}$"))
        and (.volume_readiness_receipt_digest | test("^sha256:[0-9a-f]{64}$"))
        and (.torch_retention_evidence_digest | test("^sha256:[0-9a-f]{64}$"))
        and (.dependency_quarantine_evidence_digest | test("^sha256:[0-9a-f]{64}$"))
        and (.dependency_lock_digest | test("^sha256:[0-9a-f]{64}$"))
        and (.dependency_private_tree_digest | test("^sha256:[0-9a-f]{64}$"))
        and (.code_materialization_evidence_digest | test("^sha256:[0-9a-f]{64}$"))
        and (.code_private_tree_digest | test("^sha256:[0-9a-f]{64}$"))
        and .activation_digest == null
      ' >/dev/null 2>&1 <<<"$bootstrap_health"; then
    stage_evidence_ready=true
    break
  fi
  if ! readiness_sleep_seconds="$(
    seconds_until_deadline "$readiness_deadline_epoch" 5
  )"; then
    break
  fi
  sleep "$readiness_sleep_seconds"
done
if [[ "$stage_evidence_ready" != true ]]; then
  if [[ "$bundle_upload_acknowledged" == true ]]; then
    echo "The accepted upload did not produce staging evidence before timeout." >&2
  else
    echo "The interrupted upload response could not be reconciled to exact staging evidence." >&2
  fi
  exit 1
fi

bundle_stage_receipt_path="$artifact_staging_directory/bundle-receipt.json"
remote_volume_receipt_path="$artifact_staging_directory/readiness-receipt.json"
torch_retention_evidence_path="$artifact_staging_directory/torch-evidence.json"
dependency_quarantine_evidence_path="$artifact_staging_directory/dependency-quarantine-evidence.json"
code_materialization_evidence_path="$artifact_staging_directory/code-materialization-evidence.json"
for evidence_spec in \
  "$bundle_stage_receipt_url|$bundle_stage_receipt_path" \
  "$volume_readiness_receipt_url|$remote_volume_receipt_path" \
  "$torch_retention_evidence_url|$torch_retention_evidence_path" \
  "$dependency_quarantine_evidence_url|$dependency_quarantine_evidence_path" \
  "$code_materialization_evidence_url|$code_materialization_evidence_path"; do
  evidence_url="${evidence_spec%%|*}"
  evidence_path="${evidence_spec#*|}"
  if ! evidence_timeout="$(
    seconds_until_deadline "$readiness_deadline_epoch" 30
  )"; then
    echo "The paid readiness deadline expired while retrieving staging evidence." >&2
    exit 1
  fi
  if ! curl --fail --silent --show-error --max-time "$evidence_timeout" \
    -H "$remote_authorization" "$evidence_url" |
    durable_write_stdin "$evidence_path"; then
    echo "Authenticated staging evidence could not be retrieved exactly once ready." >&2
    exit 1
  fi
done

if ! verified_bundle_stage="$(
  printf '%s' "$network_volume" |
    PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
      python3 "$workload_bundle_tool_path" \
      verify-stage-receipt \
      "$bundle_stage_receipt_path" \
      - \
      --bundle-digest "$bundle_digest" \
      --bundle-size-bytes "$bundle_size_bytes" \
      --bundle-path "$bundle_volume_path"
)"; then
  failure_message="The remote workload-bundle stage receipt failed local verification."
  echo "The remote workload-bundle stage receipt is invalid; terminating." >&2
  exit 1
fi
bundle_stage_receipt_digest="$(jq -r '.receipt_digest' <<<"$verified_bundle_stage")"

if ! verified_volume_readiness="$(
  printf '%s' "$network_volume" |
    python3 "$repository_root/research/runpod/larger_model_gate.py" \
      verify-volume-receipt \
      "$remote_volume_receipt_path" \
      -
)"; then
  failure_message="The H100 model and runtime readiness receipt failed local verification."
  echo "The H100 model/runtime readiness receipt is invalid; terminating." >&2
  exit 1
fi
volume_readiness_receipt_digest="$(
  jq -r '.receipt_digest' <<<"$verified_volume_readiness"
)"
dependency_lock_digest="$(
  jq -r '.dependency_lock_digest' <<<"$verified_volume_readiness"
)"
dependency_quarantine_evidence_digest="$(
  jq -r '.dependency_quarantine_evidence_digest' <<<"$verified_volume_readiness"
)"
dependency_private_tree_digest="$(
  jq -r '.dependency_private_tree_digest' <<<"$verified_volume_readiness"
)"
code_materialization_evidence_digest="$(
  jq -r '.code_materialization_evidence_digest' <<<"$verified_volume_readiness"
)"
code_private_tree_digest="$(
  jq -r '.code_private_tree_digest' <<<"$verified_volume_readiness"
)"
if ! jq -e \
  --arg dependency_revision "$dependency_quarantine_revision" \
  --arg dependency_lock_digest "$dependency_lock_digest" \
  --arg code_revision "$code_materialization_revision" \
  --slurpfile dependency_evidence "$dependency_quarantine_evidence_path" \
  --slurpfile code_evidence "$code_materialization_evidence_path" \
  '
    ($dependency_evidence | length) == 1
    and ($code_evidence | length) == 1
    and .dependency_quarantine_revision == $dependency_revision
    and .dependency_lock_digest == $dependency_lock_digest
    and .dependency_lock_digest == $dependency_evidence[0].lock_digest
    and .code_materialization_revision == $code_revision
    and .dependency_quarantine_evidence == $dependency_evidence[0]
    and .code_materialization_evidence == $code_evidence[0]
    and .dependency_quarantine_evidence_digest
      == $dependency_evidence[0].evidence_digest
    and .dependency_private_tree_digest
      == $dependency_evidence[0].private_tree_digest
    and .code_materialization_evidence_digest
      == $code_evidence[0].evidence_digest
    and .code_private_tree_digest == $code_evidence[0].private_tree_digest
  ' >/dev/null "$remote_volume_receipt_path"; then
  failure_message="The private dependency or code evidence was not bound to H100 readiness."
  echo "The authenticated private-materialization evidence is invalid; terminating." >&2
  exit 1
fi
if [[ "$(jq -r '.snapshot_digest' <<<"$verified_volume_readiness")" != "$larger_model_expected_snapshot_digest" ]]; then
  failure_message="The H100 readiness receipt did not attest the pinned model snapshot."
  echo "The staged worker did not attest the pinned model snapshot; terminating." >&2
  exit 1
fi

if ! verified_torch_retention="$(
  python3 "$repository_root/research/runpod/larger_model_gate.py" \
    verify-retention-evidence \
    "$torch_retention_evidence_path" \
    --head-commit "$source_head_commit" \
    --workload-bundle-digest "$bundle_digest" \
    --workload-bundle-size-bytes "$bundle_size_bytes" \
    --workload-bundle-path "$bundle_volume_path" \
    --bundle-stage-receipt-digest "$bundle_stage_receipt_digest" \
    --bootstrap-source-digest "$bootstrap_source_digest" \
    --volume-readiness-receipt-digest "$volume_readiness_receipt_digest" \
    --dependency-lock-digest "$dependency_lock_digest" \
    --dependency-quarantine-evidence-digest "$dependency_quarantine_evidence_digest" \
    --dependency-private-tree-digest "$dependency_private_tree_digest" \
    --code-materialization-evidence-digest "$code_materialization_evidence_digest" \
    --code-private-tree-digest "$code_private_tree_digest" \
    --volume-id "$network_volume_id" \
    --data-center-id "$network_volume_data_center_id" \
    --volume-size-gb "$network_volume_verified_size_gb"
)"; then
  failure_message="The real Torch retention probe failed local verification."
  echo "The Torch retention evidence is invalid; terminating." >&2
  exit 1
fi
torch_retention_evidence_digest="$(
  jq -r '.evidence_digest' <<<"$verified_torch_retention"
)"

activation_body="$(
  PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}" \
    python3 - \
    "$source_head_commit" \
    "$bundle_digest" \
    "$bundle_size_bytes" \
    "$bundle_volume_path" \
    "$bundle_stage_receipt_digest" \
    "$bootstrap_source_digest" \
    "$volume_readiness_receipt_digest" \
    "$torch_retention_evidence_digest" \
    "$dependency_lock_digest" \
    "$dependency_quarantine_evidence_digest" \
    "$dependency_private_tree_digest" \
    "$code_materialization_evidence_digest" \
    "$code_private_tree_digest" \
    "$network_volume_id" \
    "$network_volume_data_center_id" \
    "$network_volume_verified_size_gb" <<'PY'
import sys

from research.runpod.larger_model_gate import (
    build_live_stage_activation,
    canonical_json,
    load_manifest,
)

(
    head_commit,
    bundle_digest,
    bundle_size,
    bundle_path,
    stage_digest,
    bootstrap_digest,
    readiness_digest,
    torch_digest,
    dependency_lock_digest,
    dependency_evidence_digest,
    dependency_tree_digest,
    code_evidence_digest,
    code_tree_digest,
    volume_id,
    data_center_id,
    volume_size,
) = sys.argv[1:]
activation = build_live_stage_activation(
    load_manifest(),
    head_commit=head_commit,
    workload_bundle_digest=bundle_digest,
    workload_bundle_size_bytes=int(bundle_size),
    workload_bundle_path=bundle_path,
    bundle_stage_receipt_digest=stage_digest,
    bootstrap_source_digest=bootstrap_digest,
    volume_readiness_receipt_digest=readiness_digest,
    torch_retention_evidence_digest=torch_digest,
    dependency_lock_digest=dependency_lock_digest,
    dependency_quarantine_evidence_digest=dependency_evidence_digest,
    dependency_private_tree_digest=dependency_tree_digest,
    code_materialization_evidence_digest=code_evidence_digest,
    code_private_tree_digest=code_tree_digest,
    network_volume_id=volume_id,
    data_center_id=data_center_id,
    volume_size_gb=int(volume_size),
)
sys.stdout.buffer.write(canonical_json(activation))
PY
)"
bundle_activation_digest="$(jq -r '.activation_digest // empty' <<<"$activation_body")"
if [[ ! "$bundle_activation_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "The canonical live-stage activation digest is invalid." >&2
  exit 1
fi
activation_path="$artifact_staging_directory/stage-activation.json"
printf '%s' "$activation_body" | durable_write_stdin "$activation_path"
activation_size_bytes="$(wc -c <"$activation_path" | tr -d ' ')"

last_progress="$(
  jq -cn \
    --argjson maximum_updates "$maximum_updates" \
    '{
      phase: "starting",
      message: "Starting workload.",
      maximum_level: 3,
      maximum_updates: $maximum_updates
    }'
)"
failure_message="The verified staged workload was not activated."
publish_execution "RUNNING" "$last_progress" "" false "$readiness_deadline_epoch"
if ! activation_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 30
)"; then
  echo "The paid readiness deadline expired before staged activation." >&2
  exit 1
fi
set +e
activation_response="$(
  curl --silent --show-error --http1.1 --max-time "$activation_timeout" \
    -X POST \
    -H "$remote_authorization" \
    -H "Content-Type: application/json" \
    -H "Content-Length: $activation_size_bytes" \
    -H "Expect:" \
    --data-binary "@$activation_path" \
    --write-out $'\n%{http_code}' \
    "$bundle_activation_url"
)"
activation_exit_code="$?"
set -e
activation_status=""
activation_response_body=""
if [[ "$activation_response" == *$'\n'* ]]; then
  activation_status="${activation_response##*$'\n'}"
  activation_response_body="${activation_response%$'\n'*}"
fi
if [[ "$activation_status" =~ ^[45][0-9][0-9]$ ]]; then
  failure_message="The bootstrap endpoint explicitly rejected the verified stage activation."
  echo "The bootstrap endpoint rejected stage activation with HTTP $activation_status." >&2
  exit 1
fi
activation_acknowledged=false
if [[ "$activation_exit_code" == "0" &&
  "$activation_status" =~ ^2[0-9][0-9]$ ]] &&
  jq -e \
    --arg activation_digest "$bundle_activation_digest" \
    '
      .status == "activated"
      and .activation_digest == $activation_digest
    ' >/dev/null 2>&1 <<<"$activation_response_body"; then
  activation_acknowledged=true
fi

resource_profile="$(
  jq -c \
    --arg profile_id "$larger_model_profile_id" \
    --arg manifest_digest "$larger_model_manifest_digest" \
    --arg source_head_commit "$source_head_commit" \
    --arg source_contract_digest "$larger_model_source_contract_digest" \
    --arg bundle_handoff_revision "$bundle_handoff_revision" \
    --arg live_stage_activation_revision "$live_stage_activation_revision" \
    --arg live_stage_activation_digest "$bundle_activation_digest" \
    --arg volume_readiness_receipt_digest "$volume_readiness_receipt_digest" \
    --arg bundle_stage_receipt_digest "$bundle_stage_receipt_digest" \
    --arg torch_retention_evidence_digest "$torch_retention_evidence_digest" \
    --arg dependency_quarantine_revision "$dependency_quarantine_revision" \
    --arg dependency_lock_digest "$dependency_lock_digest" \
    --arg dependency_quarantine_evidence_digest "$dependency_quarantine_evidence_digest" \
    --arg dependency_private_tree_digest "$dependency_private_tree_digest" \
    --arg code_materialization_revision "$code_materialization_revision" \
    --arg code_materialization_evidence_digest "$code_materialization_evidence_digest" \
    --arg code_private_tree_digest "$code_private_tree_digest" \
    '. + {
      profile_id: $profile_id,
      manifest_digest: $manifest_digest,
      source_head_commit: $source_head_commit,
      source_contract_digest: $source_contract_digest,
      bundle_handoff_revision: $bundle_handoff_revision,
      live_stage_activation_revision: $live_stage_activation_revision,
      live_stage_activation_digest: $live_stage_activation_digest,
      volume_readiness_receipt_digest: $volume_readiness_receipt_digest,
      bundle_stage_receipt_digest: $bundle_stage_receipt_digest,
      torch_retention_evidence_digest: $torch_retention_evidence_digest,
      dependency_quarantine_revision: $dependency_quarantine_revision,
      dependency_lock_digest: $dependency_lock_digest,
      dependency_quarantine_evidence_digest:
        $dependency_quarantine_evidence_digest,
      dependency_private_tree_digest: $dependency_private_tree_digest,
      code_materialization_revision: $code_materialization_revision,
      code_materialization_evidence_digest:
        $code_materialization_evidence_digest,
      code_private_tree_digest: $code_private_tree_digest
    }' <<<"$resource_profile"
)"

attempt=0
while readiness_poll_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 10
)"; do
  touch_volume_expiry_guard
  attempt=$((attempt + 1))
  remote_progress="$(
    curl --fail --silent --show-error --max-time "$readiness_poll_timeout" \
      -H "$remote_authorization" "$progress_url" 2>/dev/null || true
  )"
  if [[ -n "$remote_progress" ]] &&
    jq -e \
      --arg activation_revision "$live_stage_activation_revision" \
      --arg profile_id "$larger_model_profile_id" \
      --arg head_commit "$source_head_commit" \
      --arg source_contract_digest "$larger_model_source_contract_digest" \
      --arg bootstrap_source_digest "$bootstrap_source_digest" \
      --arg workload_bundle_digest "$bundle_digest" \
      --argjson workload_bundle_size_bytes "$bundle_size_bytes" \
      --arg workload_bundle_path "$bundle_volume_path" \
      --arg bundle_stage_receipt_digest "$bundle_stage_receipt_digest" \
      --arg volume_readiness_receipt_digest "$volume_readiness_receipt_digest" \
      --arg torch_retention_evidence_digest "$torch_retention_evidence_digest" \
      --arg dependency_lock_digest "$dependency_lock_digest" \
      --arg dependency_quarantine_evidence_digest "$dependency_quarantine_evidence_digest" \
      --arg dependency_private_tree_digest "$dependency_private_tree_digest" \
      --arg code_materialization_evidence_digest "$code_materialization_evidence_digest" \
      --arg code_private_tree_digest "$code_private_tree_digest" \
      --arg network_volume_id "$network_volume_id" \
      --arg network_volume_data_center_id "$network_volume_data_center_id" \
      --argjson network_volume_size_gb "$network_volume_verified_size_gb" \
      --arg activation_digest "$bundle_activation_digest" \
      --arg bundle_handoff_revision "$bundle_handoff_revision" \
      '
        .live_stage_activation_revision == $activation_revision
        and .profile_id == $profile_id
        and .head_commit == $head_commit
        and .source_contract_digest == $source_contract_digest
        and .bootstrap_source_digest == $bootstrap_source_digest
        and .workload_bundle_digest == $workload_bundle_digest
        and .workload_bundle_size_bytes == $workload_bundle_size_bytes
        and .workload_bundle_path == $workload_bundle_path
        and .bundle_stage_receipt_digest == $bundle_stage_receipt_digest
        and .volume_readiness_receipt_digest
          == $volume_readiness_receipt_digest
        and .torch_retention_evidence_digest
          == $torch_retention_evidence_digest
        and .dependency_lock_digest == $dependency_lock_digest
        and .dependency_quarantine_evidence_digest
          == $dependency_quarantine_evidence_digest
        and .dependency_private_tree_digest == $dependency_private_tree_digest
        and .code_materialization_evidence_digest
          == $code_materialization_evidence_digest
        and .code_private_tree_digest == $code_private_tree_digest
        and .network_volume_id == $network_volume_id
        and .network_volume_data_center_id
          == $network_volume_data_center_id
        and .network_volume_size_gb == $network_volume_size_gb
        and .bundle_activation_digest == $activation_digest
        and .bundle_handoff_revision == $bundle_handoff_revision
      ' >/dev/null 2>&1 <<<"$remote_progress"; then
    if ! remote_payload_has_no_publication_keys <<<"$remote_progress" ||
      ! poll_remote_integrity_floor ||
      ! accept_monotonic_remote_progress "$remote_progress"; then
      failure_message="The first private progress failed integrity or monotonicity validation."
      echo "The first structured progress was not a fresh private-runtime observation." >&2
      exit 1
    fi
    if [[ "$remote_progress_freshness" == "advanced" ]]; then
      last_progress_change_epoch="$(date +%s)"
    fi
    remote_phase="$(jq -r '.phase // empty' <<<"$remote_progress")"
    if [[ "$remote_phase" == "dependency_setup" || "$remote_phase" == "model_loading" ]]; then
      preparation_started_epoch="$(date +%s)"
    fi
    last_progress="$(
      {
        printf '%s\n' "$last_progress"
        printf '%s\n' "$remote_progress"
      } | jq -cs '.[0] + .[1]'
    )"
    publish_execution "RUNNING" "$last_progress" "" false "$readiness_deadline_epoch"
    workload_transport_ready=true
    break
  fi
  if [[ -n "$remote_progress" ]] &&
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$remote_progress"; then
    failure_message="The first structured progress did not bind the exact activated handoff."
    echo "The first structured progress did not match the activated workload evidence; terminating." >&2
    exit 1
  fi
  if ! readiness_sleep_seconds="$(
    seconds_until_deadline "$readiness_deadline_epoch" 5
  )"; then
    break
  fi
  sleep "$readiness_sleep_seconds"
done
if [[ "$workload_transport_ready" != true ]]; then
  if [[ "$activation_acknowledged" == true ]]; then
    echo "The activated workload did not expose exact progress before timeout." >&2
  else
    echo "The interrupted activation response could not be reconciled to exact progress." >&2
  fi
  exit 1
fi
else
last_progress="$(
  jq -cn \
    --argjson maximum_updates "$maximum_updates" \
    '{
      phase: "starting_workload",
      message: "Pod created; waiting for structured progress.",
      maximum_level: 3,
      maximum_updates: $maximum_updates
    }'
)"
failure_message="The RunPod worker never exposed structured workload progress."
publish_execution "PROVISIONING" "$last_progress" "" false "$readiness_deadline_epoch"

echo "Worker $pod_id allocated at \$$hourly_cost/hour; waiting for structured progress." >&2
proxy_root="https://${pod_id}-8000.proxy.runpod.net"
progress_url="$proxy_root/progress.json"
remote_authorization="Authorization: Bearer $transport_token"
exit_code=""
workload_transport_ready=false
preparation_started_epoch=""
attempt=0
while readiness_poll_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 10
)"; do
  attempt=$((attempt + 1))
  remote_progress="$(
    curl --fail --silent --show-error --max-time "$readiness_poll_timeout" \
      -H "$remote_authorization" "$progress_url" 2>/dev/null || true
  )"
  if [[ -n "$remote_progress" ]] &&
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$remote_progress"; then
    if [[ -n "$larger_model_mode" ]] &&
      ! jq -e \
        --arg activation_revision "$live_stage_activation_revision" \
        --arg profile_id "$larger_model_profile_id" \
        --arg head_commit "$source_head_commit" \
        --arg source_contract_digest "$larger_model_source_contract_digest" \
        --arg bundle_handoff_revision "$bundle_handoff_revision" \
        --arg workload_bundle_digest "$bundle_digest" \
        --argjson workload_bundle_size_bytes "$bundle_size_bytes" \
        --arg workload_bundle_path "$bundle_volume_path" \
        --arg bundle_stage_receipt_digest "$bundle_stage_receipt_digest" \
        --arg bootstrap_source_digest "$bootstrap_source_digest" \
        --arg volume_readiness_receipt_digest "$volume_readiness_receipt_digest" \
        --arg torch_retention_evidence_digest "$torch_retention_evidence_digest" \
        --arg dependency_lock_digest "$dependency_lock_digest" \
        --arg dependency_quarantine_evidence_digest "$dependency_quarantine_evidence_digest" \
        --arg dependency_private_tree_digest "$dependency_private_tree_digest" \
        --arg code_materialization_evidence_digest "$code_materialization_evidence_digest" \
        --arg code_private_tree_digest "$code_private_tree_digest" \
        --arg network_volume_id "$network_volume_id" \
        --arg network_volume_data_center_id "$network_volume_data_center_id" \
        --argjson network_volume_size_gb "$network_volume_verified_size_gb" \
        --arg activation_digest "$bundle_activation_digest" \
        '
          .live_stage_activation_revision == $activation_revision
          and .profile_id == $profile_id
          and .head_commit == $head_commit
          and .source_contract_digest == $source_contract_digest
          and .bundle_handoff_revision == $bundle_handoff_revision
          and .workload_bundle_digest == $workload_bundle_digest
          and .workload_bundle_size_bytes == $workload_bundle_size_bytes
          and .workload_bundle_path == $workload_bundle_path
          and .bundle_stage_receipt_digest == $bundle_stage_receipt_digest
          and .bootstrap_source_digest == $bootstrap_source_digest
          and .volume_readiness_receipt_digest
            == $volume_readiness_receipt_digest
          and .torch_retention_evidence_digest
            == $torch_retention_evidence_digest
          and .dependency_lock_digest == $dependency_lock_digest
          and .dependency_quarantine_evidence_digest
            == $dependency_quarantine_evidence_digest
          and .dependency_private_tree_digest == $dependency_private_tree_digest
          and .code_materialization_evidence_digest
            == $code_materialization_evidence_digest
          and .code_private_tree_digest == $code_private_tree_digest
          and .network_volume_id == $network_volume_id
          and .network_volume_data_center_id
            == $network_volume_data_center_id
          and .network_volume_size_gb == $network_volume_size_gb
          and .bundle_activation_digest == $activation_digest
        ' >/dev/null <<<"$remote_progress"; then
      failure_message="The worker did not attest the exact staged workload handoff."
      echo "The first structured progress did not match the preallocated workload handoff; terminating." >&2
      exit 1
    fi
    if ! remote_payload_has_no_publication_keys <<<"$remote_progress" ||
      ! poll_remote_integrity_floor ||
      ! accept_monotonic_remote_progress "$remote_progress"; then
      failure_message="The first private progress failed integrity or monotonicity validation."
      echo "The first structured progress was not a fresh private-runtime observation." >&2
      exit 1
    fi
    if [[ "$remote_progress_freshness" == "advanced" ]]; then
      last_progress_change_epoch="$(date +%s)"
    fi
    remote_phase="$(jq -r '.phase // empty' <<<"$remote_progress")"
    if [[ "$remote_phase" == "dependency_setup" || "$remote_phase" == "model_loading" ]]; then
      preparation_started_epoch="$(date +%s)"
    fi
    last_progress="$(
      {
        printf '%s\n' "$last_progress"
        printf '%s\n' "$remote_progress"
      } | jq -cs '.[0] + .[1]'
    )"
    publish_execution "RUNNING" "$last_progress" "" false "$readiness_deadline_epoch"
    workload_transport_ready=true
    break
  fi
  if ((attempt == 1 || attempt % 3 == 0)); then
    elapsed_wait=$(($(date +%s) - boot_started_epoch))
    last_progress="$(
      jq -cn \
        --arg message "Pod created; waiting for structured progress." \
        --argjson elapsed_seconds "$elapsed_wait" \
        --argjson maximum_updates "$maximum_updates" \
        '{
          phase: "starting_workload",
          message: $message,
          elapsed_seconds: $elapsed_seconds,
          maximum_level: 3,
          maximum_updates: $maximum_updates
        }'
    )"
    publish_execution "PROVISIONING" "$last_progress" "" false "$readiness_deadline_epoch"
  fi
  if ! readiness_sleep_seconds="$(
    seconds_until_deadline "$readiness_deadline_epoch" 5
  )"; then
    break
  fi
  sleep "$readiness_sleep_seconds"
done
fi
rm -f -- "$bundle_source_path"
bundle_source_path=""
if [[ "$workload_transport_ready" != true ]]; then
  echo "The workload did not expose structured progress before timeout." >&2
  exit 1
fi

echo "Container is live; streaming structured progress to Equinox." >&2
provider_deadline_epoch=$((provider_allocation_started_epoch + maximum_lifetime_minutes * 60))
result_deadline_epoch=$((provider_deadline_epoch - cleanup_reserve_seconds - artifact_retrieval_reserve_seconds))
failure_message="The remote workload did not finish before the provider cleanup reserve."
while (( $(date +%s) < result_deadline_epoch )); do
  current_epoch="$(date +%s)"
  accrued_cost="$(
    jq -n \
      --argjson hourly_cost "$hourly_cost" \
      --argjson elapsed_seconds "$((current_epoch - provider_allocation_started_epoch))" \
      '$hourly_cost * $elapsed_seconds / 3600'
  )"
  if ! jq -en \
    --argjson accrued "$accrued_cost" \
    --argjson maximum "$maximum_total_cost" \
    '$accrued < $maximum' >/dev/null; then
    failure_message="The total-cost ceiling was reached before the workload completed."
    echo "Stopping before accrued cost can exceed \$$maximum_total_cost." >&2
    exit 1
  fi
  if [[ -n "$preparation_started_epoch" ]] &&
    ((current_epoch - preparation_started_epoch > model_load_timeout_seconds)); then
    failure_message="Dependency preparation or model loading exceeded its bounded timeout."
    echo "Model readiness exceeded ${model_load_timeout_seconds}s; terminating the worker." >&2
    exit 1
  fi
  if [[ -n "$larger_model_mode" ]] &&
    ((current_epoch - last_progress_change_epoch > stale_progress_timeout_seconds)); then
    failure_message="Structured remote progress stopped changing before completion."
    echo "No progress change for ${stale_progress_timeout_seconds}s; terminating the worker." >&2
    exit 1
  fi
  fetch_and_publish_remote_progress "$current_epoch"
  exit_code="$(
    curl --fail --silent --show-error --max-time 10 \
      -H "$remote_authorization" "$proxy_root/exit_code" 2>/dev/null || true
  )"
  if [[ -n "$exit_code" ]]; then
    # The worker writes progress before exit_code. Fetch once more after observing the
    # terminal marker so a delayed or transiently missed final branch tree is retained.
    terminal_progress_complete=false
    for final_progress_attempt in 1 2 3; do
      fetch_and_publish_remote_progress "$(date +%s)"
      if [[ "$larger_model_mode" == "screen" ]]; then
        if larger_model_screen_progress_complete <<<"$last_progress"; then
          terminal_progress_complete=true
          break
        fi
      elif [[ "$last_remote_progress_fetch_valid" == true ]]; then
        terminal_progress_complete=true
        break
      fi
      if ((final_progress_attempt < 3)); then
        sleep 1
      fi
    done
    break
  fi
  sleep 5
done
if [[ -z "$exit_code" ]]; then
  echo "The remote workload did not finish before the cleanup reserve." >&2
  exit 1
fi
if [[ "$exit_code" != "0" ]]; then
  failure_message="The remote workload failed with exit code $exit_code."
  echo "The remote workload failed with exit code $exit_code." >&2
  curl --fail --silent --show-error --max-time 30 \
    -H "$remote_authorization" \
    "$proxy_root/error.log" 2>/dev/null |
    tail -40 >&2 || true
  exit 1
fi
if [[ "$live_stage_enabled" == true ]]; then
  result_path="$artifact_staging_directory/screen-result.json"
elif [[ "$larger_model_mode" == "pilot" ]]; then
  result_path="$artifact_staging_directory/pilot-result.json"
else
  result_path="$receipt_directory/$proof_id.result.json"
fi
if [[ "$experiment" == "repository-repair" &&
  "$study_eligibility_only" != "1" &&
  "$larger_model_mode" != "screen" ]]; then
  if [[ "$larger_model_mode" == "pilot" ]]; then
    adapter_path="$artifact_staging_directory/model-artifact.tgz"
  else
    adapter_path="$receipt_directory/$proof_id.adapter.tgz"
  fi
fi
if ! curl --fail --silent --show-error --max-time 60 \
    --max-filesize "$((64 * 1024 * 1024))" \
    -H "$remote_authorization" \
    "$proxy_root/result.json" |
  durable_write_stdin "$result_path"; then
  failure_message="The remote workload result could not be persisted."
  echo "The remote workload did not return a bounded result artifact." >&2
  exit 1
fi
metrics="$(
  python3 - "$result_path" <<'PY'
import os
import stat
import sys

path = sys.argv[1]
descriptor = os.open(
    path,
    os.O_RDONLY
    | getattr(os, "O_CLOEXEC", 0)
    | getattr(os, "O_NOFOLLOW", 0)
    | getattr(os, "O_NONBLOCK", 0),
)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or not 0 < metadata.st_size <= 64 * 1024 * 1024:
        raise SystemExit("result artifact is not a bounded regular file")
    payload = b""
    while len(payload) < metadata.st_size:
        chunk = os.read(descriptor, min(1024 * 1024, metadata.st_size - len(payload)))
        if not chunk:
            raise SystemExit("result artifact was truncated")
        payload += chunk
    sys.stdout.buffer.write(payload)
finally:
    os.close(descriptor)
PY
)"
if [[ -z "$metrics" ]] ||
  ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$metrics" ||
  ! remote_payload_has_no_publication_keys <<<"$metrics"; then
  failure_message="The remote workload result was missing or invalid."
  echo "The remote workload did not return a valid publication-key-free metrics object." >&2
  exit 1
fi
if [[ -n "$adapter_path" ]]; then
  adapter_pending_path="$adapter_path.pending"
  if ! curl --fail --silent --show-error --max-time 120 \
      --max-filesize "$((4 * 1024 * 1024 * 1024))" \
      -H "$remote_authorization" \
      "$proxy_root/adapter.tgz" >"$adapter_pending_path" ||
    ! durably_promote_bounded_file \
      "$adapter_pending_path" "$adapter_path" "$((4 * 1024 * 1024 * 1024))"; then
    failure_message="The trained LoRA adapter could not be persisted before teardown."
    echo "The remote adapter artifact was empty or unsafe; refusing a successful run." >&2
    exit 1
  fi
  adapter_pending_path=""
fi
if ! fetch_and_verify_remote_integrity; then
  exit 1
fi
if [[ "$larger_model_mode" == "screen" ]] &&
  ! larger_model_screen_progress_matches_result "$metrics" <<<"$last_progress"; then
  failure_message="The completed eligibility screen result did not match its cumulative terminal branch progress."
  echo "The eligibility result and authenticated terminal branch progress did not match." >&2
  exit 1
fi
if [[ -n "$adapter_path" ]]; then
  python3 - "$adapter_path" "$(jq -r '.adapter_manifest.digest // empty' <<<"$metrics")" <<'PY'
import hashlib
import json
import sys
import tarfile

archive_path, expected_digest = sys.argv[1:]
if not expected_digest.startswith("sha256:"):
    raise SystemExit("result omitted the adapter manifest digest")
with tarfile.open(archive_path, "r:gz") as archive:
    members = {
        member.name: member
        for member in archive.getmembers()
        if member.isfile()
    }
    manifest_member = members.get("adapter/adapter-manifest.json")
    if manifest_member is None:
        raise SystemExit("adapter archive omitted its manifest")
    manifest = json.load(archive.extractfile(manifest_member))
    content = {key: value for key, value in manifest.items() if key != "digest"}
    digest = "sha256:" + hashlib.sha256(
        json.dumps(content, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    if digest != expected_digest or manifest.get("digest") != expected_digest:
        raise SystemExit("adapter manifest digest mismatch")
    for item in manifest["files"]:
        member = members.get("adapter/" + item["path"])
        if member is None:
            raise SystemExit(f"adapter archive omitted {item['path']}")
        payload = archive.extractfile(member).read()
        if len(payload) != item["size_bytes"]:
            raise SystemExit(f"adapter size mismatch for {item['path']}")
        if hashlib.sha256(payload).hexdigest() != item["sha256"]:
            raise SystemExit(f"adapter digest mismatch for {item['path']}")
PY
  if [[ "$larger_model_mode" == "pilot" ]]; then
    model_artifact_identity="$(
      python3 - "$adapter_path" <<'PY'
import hashlib
import json
import os
import stat
import sys

path = sys.argv[1]
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
descriptor = os.open(path, flags)
try:
    before = os.fstat(descriptor)
    if not stat.S_ISREG(before.st_mode) or not 0 < before.st_size <= 512 * 1024 * 1024:
        raise SystemExit("pilot model artifact is not a bounded regular file")
    digest = hashlib.sha256()
    while chunk := os.read(descriptor, 1024 * 1024):
        digest.update(chunk)
    after = os.fstat(descriptor)
    identity = ("st_dev", "st_ino", "st_mode", "st_size", "st_mtime_ns", "st_ctime_ns")
    if any(getattr(before, key) != getattr(after, key) for key in identity):
        raise SystemExit("pilot model artifact changed while it was hashed")
    print(
        json.dumps(
            {
                "sha256": "sha256:" + digest.hexdigest(),
                "size_bytes": before.st_size,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
finally:
    os.close(descriptor)
PY
    )"
    model_artifact_sha256="$(jq -r '.sha256' <<<"$model_artifact_identity")"
    model_artifact_size_bytes="$(jq -r '.size_bytes' <<<"$model_artifact_identity")"
    if [[ ! "$model_artifact_sha256" =~ ^sha256:[0-9a-f]{64}$ ||
      ! "$model_artifact_size_bytes" =~ ^[1-9][0-9]*$ ]]; then
      failure_message="The trained LoRA adapter identity could not be bound."
      echo "The trained LoRA adapter identity is invalid; refusing publication." >&2
      exit 1
    fi
  fi
fi
if [[ "$larger_model_mode" == "screen" ]]; then
  proof_assertion='
    .device == "cuda"
    and .workload == $expected_screen_workload
    and .workload_revision == $expected_screen_workload_revision
    and .profile_id == $expected_profile_id
    and .model_id == $expected_model
    and .model_revision == $expected_model_revision
    and .optimization_seed == $expected_optimization_seed
    and .source_contract_digest == $expected_source_contract_digest
    and .environment_revision == $expected_environment_revision
    and .action_protocol_revision == $expected_action_protocol_revision
    and .terminal_submission_contract == $expected_terminal_submission_contract
    and .screen_levels == $expected_admission_levels
    and .shared_prefix_checkpoint_strategy == $expected_shared_prefix_checkpoint
    and .screen_completed == true
    and (.eligible | type) == "boolean"
    and .training_started == false
    and .persistent_policy_updates == 0
    and .policy_mutation_enabled == false
    and .policy_mutation_detected == false
    and .optimizer_state_restored == true
    and .test_split_accessed == false
    and .test_examples_accessed == 0
    and .branch_width == 4
    and (
      .branch_groups == $expected_branch_groups
      or (
        .eligible == false
        and (.branch_groups | type) == "number"
        and (.branch_groups | floor) == .branch_groups
        and .branch_groups >= 1
        and .branch_groups < $expected_branch_groups
        and (
