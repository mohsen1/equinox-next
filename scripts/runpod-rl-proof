#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$repository_root/scripts/ensure-local-env"
internal_token="${EQUINOX_INTERNAL_TOKEN:-$(
  sed -n 's/^EQUINOX_INTERNAL_TOKEN=//p' "$repository_root/.env" | tail -n 1
)}"
if [[ ${#internal_token} -lt 32 ]]; then
  echo "EQUINOX_INTERNAL_TOKEN must contain at least 32 characters." >&2
  exit 1
fi
experiment="${EQUINOX_RUNPOD_EXPERIMENT:-repository-repair}"
support_file=""
case "$experiment" in
  sequence-ladder)
    workload_file="branching_sequence_ladder.py"
    workload_id="branching-sequence-policy-gradient-ladder"
    execution_name="Branching sequence ladder"
    default_model_id=""
    default_gpu_id="NVIDIA GeForce RTX 3090"
    default_cloud_type="COMMUNITY"
    default_target_runtime_seconds="420"
    default_maximum_lifetime_minutes="15"
    default_retry_reserve_seconds="0"
    default_maximum_final_evaluation_reserve_seconds="0"
    default_maximum_updates="1200"
    default_validation_examples="1"
    default_test_examples="1"
    default_mastery_windows="1"
    default_training_tasks_per_update="1"
    default_replay_tasks_per_level="1"
    ;;
  repository-repair)
    workload_file="repository_repair_rl.py"
    support_file="repository_repair_env.py"
    workload_id="repository-repair-restored-continuation-post-training"
    execution_name="Repository repair post-training"
    default_model_id="Qwen/Qwen2.5-Coder-3B-Instruct"
    default_gpu_id="NVIDIA A40"
    default_cloud_type="SECURE"
    default_target_runtime_seconds="7200"
    default_maximum_lifetime_minutes="240"
    default_retry_reserve_seconds="2700"
    default_maximum_final_evaluation_reserve_seconds="2700"
    default_maximum_updates="120"
    default_validation_examples="8"
    default_test_examples="6"
    default_mastery_windows="2"
    default_training_tasks_per_update="2"
    default_replay_tasks_per_level="1"
    ;;
  *)
    echo "EQUINOX_RUNPOD_EXPERIMENT must be sequence-ladder or repository-repair." >&2
    exit 1
    ;;
esac
workload_path="$repository_root/research/runpod/$workload_file"
support_path="$repository_root/research/runpod/$support_file"
remote_runner_path="$repository_root/research/runpod/remote_runner.sh"
result_server_path="$repository_root/research/runpod/result_server.py"
receipt_directory="$repository_root/var/research-proofs"
api_root="${EQUINOX_API_ROOT:-http://127.0.0.1:8180}"
dashboard_root="${EQUINOX_DASHBOARD_ROOT:-http://127.0.0.1:3100}"
gpu_id="${EQUINOX_RUNPOD_GPU:-$default_gpu_id}"
template_id="${EQUINOX_RUNPOD_TEMPLATE:-runpod-torch-v280}"
cloud_type="${EQUINOX_RUNPOD_CLOUD_TYPE:-$default_cloud_type}"
maximum_hourly_cost="${EQUINOX_RUNPOD_MAX_HOURLY_COST:-0.50}"
maximum_lifetime_minutes="${EQUINOX_RUNPOD_MAX_LIFETIME_MINUTES:-$default_maximum_lifetime_minutes}"
boot_timeout_seconds="${EQUINOX_RUNPOD_BOOT_TIMEOUT_SECONDS:-360}"
container_disk_in_gb="${EQUINOX_RUNPOD_CONTAINER_DISK_GB:-30}"
persistent_volume_in_gb="${EQUINOX_RUNPOD_VOLUME_GB:-10}"
persistent_work_directory="/workspace/equinox-state"
if [[ "$experiment" == "sequence-ladder" ]]; then
  model_id="$default_model_id"
  target_runtime_seconds="$default_target_runtime_seconds"
  optimization_seed="73"
  maximum_updates="$default_maximum_updates"
  validation_examples="$default_validation_examples"
  test_examples="$default_test_examples"
  mastery_windows="$default_mastery_windows"
  training_tasks_per_update="$default_training_tasks_per_update"
  replay_tasks_per_level="$default_replay_tasks_per_level"
  retry_reserve_seconds="$default_retry_reserve_seconds"
  maximum_final_evaluation_reserve_seconds="$default_maximum_final_evaluation_reserve_seconds"
else
  model_id="${EQUINOX_RL_MODEL_ID:-$default_model_id}"
  target_runtime_seconds="${EQUINOX_RL_TARGET_SECONDS:-$default_target_runtime_seconds}"
  optimization_seed="${EQUINOX_RL_SEED:-73}"
  maximum_updates="${EQUINOX_RL_MAX_UPDATES:-$default_maximum_updates}"
  validation_examples="${EQUINOX_RL_VALIDATION_EXAMPLES:-$default_validation_examples}"
  test_examples="${EQUINOX_RL_TEST_EXAMPLES:-$default_test_examples}"
  mastery_windows="${EQUINOX_RL_MASTERY_WINDOWS:-$default_mastery_windows}"
  training_tasks_per_update="${EQUINOX_RL_TRAINING_TASKS_PER_UPDATE:-$default_training_tasks_per_update}"
  replay_tasks_per_level="${EQUINOX_RL_REPLAY_TASKS_PER_LEVEL:-$default_replay_tasks_per_level}"
  retry_reserve_seconds="${EQUINOX_RUNPOD_RETRY_RESERVE_SECONDS:-$default_retry_reserve_seconds}"
  maximum_final_evaluation_reserve_seconds="${EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS:-$default_maximum_final_evaluation_reserve_seconds}"
fi
final_evaluation_generation_overshoot_seconds=0
if [[ "$experiment" == "repository-repair" ]]; then
  final_evaluation_generation_overshoot_seconds=900
fi

command -v runpodctl >/dev/null
command -v jq >/dev/null
command -v curl >/dev/null
command -v timeout >/dev/null
command -v base64 >/dev/null
command -v python3 >/dev/null
command -v tar >/dev/null
runpod_create_help="$(runpodctl pod create --help)"
if [[ "$runpod_create_help" != *"--env string"* ||
  "$runpod_create_help" != *"environment variables as json object"* ]]; then
  echo "This runpodctl version does not document the JSON --env contract required for result transport." >&2
  exit 1
fi
test -f "$workload_path"
test -f "$remote_runner_path"
test -f "$result_server_path"
if [[ -n "$support_file" ]]; then
  test -f "$support_path"
fi
template_response="$(runpodctl template get "$template_id")"
image="$(jq -r '.imageName // empty' <<<"$template_response")"
if [[ -z "$image" ]]; then
  echo "RunPod template $template_id did not resolve to a container image." >&2
  exit 1
fi
if [[ "$cloud_type" != "COMMUNITY" && "$cloud_type" != "SECURE" ]]; then
  echo "EQUINOX_RUNPOD_CLOUD_TYPE must be COMMUNITY or SECURE." >&2
  exit 1
fi
if [[ "$experiment" == "sequence-ladder" ]]; then
  for configuration_name in \
    EQUINOX_RL_MODEL_ID \
    EQUINOX_RL_SEED \
    EQUINOX_RL_TARGET_SECONDS \
    EQUINOX_RL_MAX_RESUME_GAP_SECONDS \
    EQUINOX_RL_MAX_UPDATES \
    EQUINOX_RL_VALIDATION_EXAMPLES \
    EQUINOX_RL_TEST_EXAMPLES \
    EQUINOX_RL_MASTERY_WINDOWS \
    EQUINOX_RL_TRAINING_TASKS_PER_UPDATE \
    EQUINOX_RL_REPLAY_TASKS_PER_LEVEL \
    EQUINOX_RUNPOD_RETRY_RESERVE_SECONDS \
    EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS; do
    if [[ -n "${!configuration_name+x}" ]]; then
      echo "$configuration_name is pinned by the sequence-ladder workload." >&2
      exit 1
    fi
  done
fi
if [[ ! "$boot_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_BOOT_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 1
fi
if [[ ! "$target_runtime_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RL_TARGET_SECONDS must be a positive integer." >&2
  exit 1
fi
if [[ ! "$optimization_seed" =~ ^[0-9]+$ ]] || ((optimization_seed > 2147483647)); then
  echo "EQUINOX_RL_SEED must be an integer between 0 and 2147483647." >&2
  exit 1
fi
if [[ ! "$container_disk_in_gb" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_CONTAINER_DISK_GB must be a positive integer." >&2
  exit 1
fi
if [[ ! "$persistent_volume_in_gb" =~ ^[1-9][0-9]*$ ]] ||
  ((persistent_volume_in_gb > 50)); then
  echo "EQUINOX_RUNPOD_VOLUME_GB must be an integer between 1 and 50." >&2
  exit 1
fi
if [[ ! "$maximum_lifetime_minutes" =~ ^[1-9][0-9]*$ ]]; then
  echo "EQUINOX_RUNPOD_MAX_LIFETIME_MINUTES must be a positive integer." >&2
  exit 1
fi
if [[ "$experiment" == "repository-repair" ]] &&
  {
    [[ ! "$retry_reserve_seconds" =~ ^[1-9][0-9]*$ ]] ||
      [[ ! "$maximum_final_evaluation_reserve_seconds" =~ ^[1-9][0-9]*$ ]] ||
      ((retry_reserve_seconds > 7200)) ||
      ((maximum_final_evaluation_reserve_seconds > 7200)) ||
      ((maximum_final_evaluation_reserve_seconds > retry_reserve_seconds))
  }; then
  echo "Repository-repair reserves must be positive, at most 7200 seconds, and final evaluation must not exceed the retry reserve." >&2
  exit 1
fi
if [[ "$experiment" == "repository-repair" ]] &&
  ((target_runtime_seconds <= maximum_final_evaluation_reserve_seconds + 60)); then
  echo "EQUINOX_RL_TARGET_SECONDS must leave at least 60 seconds for training before final evaluation." >&2
  exit 1
fi
for bounded_integer in \
  "$maximum_updates" \
  "$validation_examples" \
  "$test_examples" \
  "$mastery_windows" \
  "$training_tasks_per_update" \
  "$replay_tasks_per_level"; do
  if [[ ! "$bounded_integer" =~ ^[1-9][0-9]*$ ]]; then
    echo "Research workload counts must be positive integers." >&2
    exit 1
  fi
done
if [[ "$experiment" == "repository-repair" ]]; then
  EQUINOX_RL_MODEL_ID="$model_id" \
    EQUINOX_RL_SEED="$optimization_seed" \
    EQUINOX_RL_TARGET_SECONDS="$target_runtime_seconds" \
    EQUINOX_RL_MAX_RESUME_GAP_SECONDS="$retry_reserve_seconds" \
    EQUINOX_RL_MAX_UPDATES="$maximum_updates" \
    EQUINOX_RL_VALIDATION_EXAMPLES="$validation_examples" \
    EQUINOX_RL_TEST_EXAMPLES="$test_examples" \
    EQUINOX_RL_MASTERY_WINDOWS="$mastery_windows" \
    EQUINOX_RL_TRAINING_TASKS_PER_UPDATE="$training_tasks_per_update" \
    EQUINOX_RL_REPLAY_TASKS_PER_LEVEL="$replay_tasks_per_level" \
    EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS="$maximum_final_evaluation_reserve_seconds" \
    python3 "$workload_path" --validate-configuration
fi
if ((
  target_runtime_seconds + maximum_final_evaluation_reserve_seconds +
    final_evaluation_generation_overshoot_seconds + boot_timeout_seconds +
    retry_reserve_seconds + 120 > maximum_lifetime_minutes * 60
)); then
  echo "The provider lifetime must cover boot, target runtime, final evaluation, one bounded generation, retry, and cleanup reserves." >&2
  exit 1
fi
bundle_files=("$workload_file" "remote_runner.sh" "result_server.py")
if [[ -n "$support_file" ]]; then
  bundle_files+=("$support_file")
fi
bundle_source_b64="$(
  tar -czf - \
    -C "$repository_root/research/runpod" \
    "${bundle_files[@]}" |
    base64 |
    tr -d '\n'
)"
transport_token="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
pod_environment="$(jq -cn --arg token "$transport_token" '{EQUINOX_RESULT_TOKEN: $token}')"
docker_args="bash -lc \"mkdir -p $persistent_work_directory; echo $bundle_source_b64 | base64 -d | tar -xzf - -C $persistent_work_directory; EQUINOX_REMOTE_WORKDIR=$persistent_work_directory EQUINOX_WORKLOAD_FILE=$workload_file EQUINOX_RL_MODEL_ID=$model_id EQUINOX_RL_SEED=$optimization_seed EQUINOX_RL_TARGET_SECONDS=$target_runtime_seconds EQUINOX_RL_MAX_RESUME_GAP_SECONDS=$retry_reserve_seconds EQUINOX_RL_MAX_UPDATES=$maximum_updates EQUINOX_RL_VALIDATION_EXAMPLES=$validation_examples EQUINOX_RL_TEST_EXAMPLES=$test_examples EQUINOX_RL_MASTERY_WINDOWS=$mastery_windows EQUINOX_RL_TRAINING_TASKS_PER_UPDATE=$training_tasks_per_update EQUINOX_RL_REPLAY_TASKS_PER_LEVEL=$replay_tasks_per_level EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS=$maximum_final_evaluation_reserve_seconds bash $persistent_work_directory/remote_runner.sh\""

mkdir -p "$receipt_directory"
proof_id="runpod-proof-$(date -u '+%Y%m%dT%H%M%SZ')"
pod_name="equinox-${proof_id}"
started_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
started_epoch="$(date +%s)"
terminate_after="$(
  python3 - "$maximum_lifetime_minutes" <<'PY'
from datetime import datetime, timedelta, timezone
import sys

print(
    (
        datetime.now(timezone.utc) + timedelta(minutes=int(sys.argv[1]))
    ).replace(microsecond=0).isoformat().replace("+00:00", "Z")
)
PY
)"
pod_id=""
provider_handle=""
hourly_cost=""
execution_registered=false
terminal_published=false
failure_message="The operator harness exited before the proof was persisted."
last_progress="$(
  jq -cn \
    --argjson maximum_updates "$maximum_updates" \
    '{
      phase: "requesting_capacity",
      message: "Requesting one bounded RunPod worker.",
      maximum_level: 3,
      maximum_updates: $maximum_updates
    }'
)"
resource_profile="$(
  jq -cn \
    --arg gpu_id "$gpu_id" \
    --arg image "$image" \
    --arg cloud_type "$cloud_type" \
    --argjson persistent_volume_in_gb "$persistent_volume_in_gb" \
    --argjson maximum_hourly_cost "$maximum_hourly_cost" \
    '{
      gpu_id: $gpu_id,
      gpu_count: 1,
      image: $image,
      cloud_type: $cloud_type,
      persistent_volume_in_gb: $persistent_volume_in_gb,
      maximum_hourly_cost_usd: $maximum_hourly_cost
    }'
)"

publish_execution() {
  local status="$1"
  local progress="$2"
  local completed_at="${3:-}"
  local teardown_confirmed="${4:-false}"
  jq -cn \
    --arg name "$execution_name" \
    --arg workload_id "$workload_id" \
    --arg model_id "$model_id" \
    --arg status "$status" \
    --arg provider_handle "$provider_handle" \
    --argjson resource_profile "$resource_profile" \
    --argjson progress "$progress" \
    --arg started_at "$started_at" \
    --arg completed_at "$completed_at" \
    --argjson teardown_confirmed "$teardown_confirmed" \
    '{
      name: $name,
      workload_id: $workload_id,
      model_id: (if $model_id == "" then null else $model_id end),
      branch_width: 4,
      complexity_strategy: "adaptive",
      status: $status,
      provider_name: "RunPod",
      provider_handle: (
        if $provider_handle == "" then null else $provider_handle end
      ),
      resource_profile: $resource_profile,
      progress: $progress,
      started_at: $started_at,
      completed_at: (if $completed_at == "" then null else $completed_at end),
      teardown_confirmed: $teardown_confirmed
    }' |
    curl --fail --silent --show-error --max-time 15 \
      -X PUT "$api_root/internal/research-compute-executions/$proof_id" \
      -H "Authorization: Bearer $internal_token" \
      -H 'Content-Type: application/json' \
      --data-binary @- >/dev/null
}

pod_is_present() {
  runpodctl pod list --all |
    jq -e --arg id "$pod_id" '.[] | select(.id == $id)' >/dev/null
}

cleanup() {
  local exit_code="$?"
  local teardown_confirmed=false
  local completed_at
  local failed_progress
  trap - EXIT
  set +e

  if [[ -n "$pod_id" ]]; then
    timeout 30 runpodctl pod delete "$pod_id" >/dev/null 2>&1 || true
    for _ in {1..12}; do
      if ! pod_is_present; then
        teardown_confirmed=true
        break
      fi
      sleep 5
    done
  else
    teardown_confirmed=true
  fi

  if [[ "$execution_registered" == true && "$terminal_published" != true ]]; then
    completed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    failed_progress="$(
      jq -c \
        --arg message "Run stopped before proof ingestion." \
        --arg error "$failure_message" \
        '. + {message: $message, error: $error}' \
        <<<"$last_progress"
    )"
    publish_execution \
      "FAILED" \
      "$failed_progress" \
      "$completed_at" \
      "$teardown_confirmed" || true
  fi
  exit "$exit_code"
}
trap cleanup EXIT
trap 'failure_message="The operator interrupted the RunPod harness."; exit 130' INT TERM

if [[ "$(runpodctl user | jq -r '.currentSpendPerHr')" != "0" ]]; then
  echo "Refusing to start: the RunPod account already has active hourly spend." >&2
  exit 1
fi

if [[ "$(runpodctl pod list --all | jq 'length')" != "0" ]]; then
  echo "Refusing to start: the RunPod account already contains a pod." >&2
  exit 1
fi

curl --fail --silent --show-error --max-time 10 "$api_root/healthz" >/dev/null
curl --fail --silent --show-error --max-time 10 "$dashboard_root/runs" >/dev/null
research_executions="$(
  curl --fail --silent --show-error --max-time 10 \
    "$api_root/v1/research-compute-executions"
)"
while IFS= read -r stale_execution; do
  stale_id="$(jq -r '.execution_id' <<<"$stale_execution")"
  reconciled_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  jq -c \
    --arg completed_at "$reconciled_at" \
    '{
      name,
      workload_id,
      model_id,
      branch_width,
      complexity_strategy,
      status: "FAILED",
      provider_name,
      provider_handle,
      resource_profile,
      progress: (
        .progress + {
          message: "Reconciled after the operator process stopped.",
          error: "No RunPod pod or active hourly spend remained."
        }
      ),
      started_at,
      completed_at: $completed_at,
      teardown_confirmed: true
    }' <<<"$stale_execution" |
    curl --fail --silent --show-error --max-time 15 \
      -X PUT "$api_root/internal/research-compute-executions/$stale_id" \
      -H "Authorization: Bearer $internal_token" \
      -H 'Content-Type: application/json' \
      --data-binary @- >/dev/null
  echo "Reconciled stale observer record $stale_id; no RunPod worker remained." >&2
done < <(
  jq -c \
    '.items[] | select(
      .status == "PROVISIONING"
      or .status == "RUNNING"
      or .status == "FINALIZING"
    )' \
    <<<"$research_executions"
)

failure_message="The observer API did not accept the provisioning record."
publish_execution "PROVISIONING" "$last_progress"
execution_registered=true

echo "Creating one bounded RunPod worker; provider deadline: $terminate_after" >&2
failure_message="RunPod pod creation failed before a provider handle was returned."
create_response="$(
  runpodctl pod create \
    --name "$pod_name" \
    --template-id "$template_id" \
    --gpu-id "$gpu_id" \
    --gpu-count 1 \
    --cloud-type "$cloud_type" \
    --container-disk-in-gb "$container_disk_in_gb" \
    --volume-in-gb "$persistent_volume_in_gb" \
    --volume-mount-path "/workspace" \
    --ports "8000/http" \
    --ssh=false \
    --env "$pod_environment" \
    --docker-args "$docker_args" \
    --terminate-after "$terminate_after"
)"
pod_id="$(jq -r '.id // .pod.id // empty' <<<"$create_response")"
if [[ ! "$pod_id" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "RunPod did not return a valid pod id." >&2
  exit 1
fi
provider_handle="runpod://pods/$pod_id"

failure_message="RunPod did not report a bounded hourly rate."
pod_response="$(runpodctl pod get "$pod_id")"
hourly_cost="$(
  jq -r '.adjustedCostPerHr // .costPerHr // .costPerHour // empty' <<<"$pod_response"
)"
if [[ -z "$hourly_cost" ]]; then
  echo "RunPod did not report an hourly cost; terminating rather than running unbounded." >&2
  exit 1
fi
if ! jq -en \
  --argjson observed "$hourly_cost" \
  --argjson maximum "$maximum_hourly_cost" \
  '$observed <= $maximum' >/dev/null; then
  echo "Hourly cost \$$hourly_cost exceeds the \$$maximum_hourly_cost ceiling." >&2
  exit 1
fi
resource_profile="$(
  jq -cn \
    --arg gpu_id "$gpu_id" \
    --arg image "$image" \
    --arg cloud_type "$cloud_type" \
    --argjson persistent_volume_in_gb "$persistent_volume_in_gb" \
    --argjson hourly_cost "$hourly_cost" \
    --argjson maximum_hourly_cost "$maximum_hourly_cost" \
    '{
      gpu_id: $gpu_id,
      gpu_count: 1,
      image: $image,
      cloud_type: $cloud_type,
      persistent_volume_in_gb: $persistent_volume_in_gb,
      hourly_cost_usd: $hourly_cost,
      maximum_hourly_cost_usd: $maximum_hourly_cost
    }'
)"
last_progress="$(
  jq -cn \
    --argjson maximum_updates "$maximum_updates" \
    '{
      phase: "waiting_for_capacity",
      message: "Pod created; waiting for a live container endpoint.",
      maximum_level: 3,
      maximum_updates: $maximum_updates
    }'
)"
publish_execution "PROVISIONING" "$last_progress"

echo "Worker $pod_id allocated at \$$hourly_cost/hour; waiting for container readiness." >&2
proxy_root="https://${pod_id}-8000.proxy.runpod.net"
progress_url="$proxy_root/progress.json"
remote_authorization="Authorization: Bearer $transport_token"
exit_code=""
readiness_attempts=$(( (boot_timeout_seconds + 4) / 5 ))
container_ready=false
failure_message="The RunPod worker never exposed a live container endpoint."
for ((attempt = 1; attempt <= readiness_attempts; attempt += 1)); do
  remote_progress="$(
    curl --fail --silent --show-error --max-time 10 \
      -H "$remote_authorization" "$progress_url" 2>/dev/null || true
  )"
  if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$remote_progress"; then
    last_progress="$(
      jq -cn \
        --argjson previous "$last_progress" \
        --argjson current "$remote_progress" \
        '$previous + $current'
    )"
    publish_execution "RUNNING" "$last_progress"
    container_ready=true
    break
  fi
  if ((attempt == 1 || attempt % 3 == 0)); then
    elapsed_wait=$((attempt * 5))
    last_progress="$(
      jq -cn \
        --arg message "Pod created; waiting for a live container endpoint." \
        --argjson elapsed_seconds "$elapsed_wait" \
        --argjson maximum_updates "$maximum_updates" \
        '{
          phase: "waiting_for_capacity",
          message: $message,
          elapsed_seconds: $elapsed_seconds,
          maximum_level: 3,
          maximum_updates: $maximum_updates
        }'
    )"
    publish_execution "PROVISIONING" "$last_progress"
  fi
  sleep 5
done
if [[ "$container_ready" != true ]]; then
  echo "The RunPod worker did not expose a live container endpoint before timeout." >&2
  exit 1
fi

echo "Container is live; streaming structured progress to Equinox." >&2
result_deadline_epoch=$((started_epoch + maximum_lifetime_minutes * 60 - 60))
failure_message="The remote workload did not finish before the provider cleanup reserve."
while (( $(date +%s) < result_deadline_epoch )); do
  exit_code="$(
    curl --fail --silent --show-error --max-time 10 \
      -H "$remote_authorization" "$proxy_root/exit_code" 2>/dev/null || true
  )"
  if [[ -n "$exit_code" ]]; then
    break
  fi
  remote_progress="$(
    curl --fail --silent --show-error --max-time 10 \
      -H "$remote_authorization" "$progress_url" 2>/dev/null || true
  )"
  if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$remote_progress"; then
    last_progress="$(
      jq -cn \
        --argjson previous "$last_progress" \
        --argjson current "$remote_progress" \
        '$previous + $current'
    )"
    publish_execution "RUNNING" "$last_progress"
  fi
  sleep 5
done
if [[ -z "$exit_code" ]]; then
  echo "The remote workload did not finish before the cleanup reserve." >&2
  exit 1
fi
if [[ "$exit_code" != "0" ]]; then
  failure_message="The remote workload failed with exit code $exit_code."
  echo "The remote workload failed with exit code $exit_code." >&2
  curl --fail --silent --show-error -H "$remote_authorization" \
    "$proxy_root/error.log" 2>/dev/null |
    tail -40 >&2 || true
  exit 1
fi
metrics="$(
  curl --fail --silent --show-error \
    -H "$remote_authorization" "$proxy_root/result.json"
)"
if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$metrics"; then
  failure_message="The remote workload result was missing or invalid."
  echo "The remote workload did not return a valid metrics object." >&2
  exit 1
fi
result_path="$receipt_directory/$proof_id.result.json"
jq . <<<"$metrics" >"$result_path"
if [[ "$experiment" == "repository-repair" ]]; then
  adapter_path="$receipt_directory/$proof_id.adapter.tgz"
  adapter_pending_path="$adapter_path.pending"
  curl --fail --silent --show-error --max-time 120 \
    -H "$remote_authorization" \
    "$proxy_root/adapter.tgz" >"$adapter_pending_path"
  if [[ ! -s "$adapter_pending_path" ]]; then
    failure_message="The trained LoRA adapter could not be persisted before teardown."
    echo "The remote adapter artifact was empty; refusing to terminate as a successful run." >&2
    exit 1
  fi
  mv "$adapter_pending_path" "$adapter_path"
  python3 - "$adapter_path" "$(jq -r '.adapter_manifest.digest // empty' <<<"$metrics")" <<'PY'
import hashlib
import json
import sys
import tarfile

archive_path, expected_digest = sys.argv[1:]
if not expected_digest.startswith("sha256:"):
    raise SystemExit("result omitted the adapter manifest digest")
with tarfile.open(archive_path, "r:gz") as archive:
    members = {
        member.name: member
        for member in archive.getmembers()
        if member.isfile()
    }
    manifest_member = members.get("adapter/adapter-manifest.json")
    if manifest_member is None:
        raise SystemExit("adapter archive omitted its manifest")
    manifest = json.load(archive.extractfile(manifest_member))
    content = {key: value for key, value in manifest.items() if key != "digest"}
    digest = "sha256:" + hashlib.sha256(
        json.dumps(content, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    if digest != expected_digest or manifest.get("digest") != expected_digest:
        raise SystemExit("adapter manifest digest mismatch")
    for item in manifest["files"]:
        member = members.get("adapter/" + item["path"])
        if member is None:
            raise SystemExit(f"adapter archive omitted {item['path']}")
        payload = archive.extractfile(member).read()
        if len(payload) != item["size_bytes"]:
            raise SystemExit(f"adapter size mismatch for {item['path']}")
        if hashlib.sha256(payload).hexdigest() != item["sha256"]:
            raise SystemExit(f"adapter digest mismatch for {item['path']}")
PY
fi
if [[ "$experiment" == "sequence-ladder" ]]; then
  proof_assertion='
    .device == "cuda"
    and .workload == "branching-sequence-policy-gradient-ladder"
    and .branch_width == 4
    and .complexity_strategy == "adaptive"
    and .test_case_count == 3
    and (.test_cases | length) == 3
    and ([.test_cases[].branch_width] | all(. == 4))
    and ([.test_cases[].promotion_count] | all(. >= 1))
    and ([.test_cases[].reward_gain] | all(. >= 0.20))
    and ([.test_cases[].final_reward] | all(. >= 0.85))
    and .test_cases[0].maximum_horizon < .test_cases[1].maximum_horizon
    and .test_cases[1].maximum_horizon < .test_cases[2].maximum_horizon
    and .maximum_horizon >= 64
    and .total_action_decisions >= 50000000
    and .promotion_count >= 5
    and .reward_gain >= 0.20
  '
else
  proof_assertion='
    .device == "cuda"
    and .experiment_completed == true
    and .post_training_completed == true
    and .adapter_persisted == true
    and .workload == "repository-repair-restored-continuation-post-training"
    and .workload_revision == "runpod-repository-repair-loo-reinforce@9"
    and .algorithm == "leave-one-out-group-normalized-reinforce"
    and .objective_id == "leave-one-out-correctness-gated-reinforce@3"
    and .objective_sequence_reduction == "mean_completion_token_log_probabilities"
    and .reward_contract.revision == "correctness-gated-efficiency@1"
    and .reward_contract.incorrect_terminal_reward == 0
    and .reward_contract.efficiency_adjustment_bounds == [-0.05, 0]
    and .optimizer_contract.learning_rate == 0.00002
    and .optimizer_contract.advantage_standard_deviation_floor == 0.1
    and .teacher_data_used == false
    and .branch_width == 4
    and .static_branch_width == 4
    and .multi_step == true
    and .restored_continuations == true
    and .prefix_gradient == false
    and .complexity_strategy == "adaptive"
    and .replay_enabled == true
    and .snapshot_fidelity == "logical_restore"
    and .model_id == $expected_model
    and .task_domains == ["micro_repository"]
    and (.complexity_levels | length) == 4
    and .complexity_levels[0].repair_horizon < .complexity_levels[3].repair_horizon
    and (.updates_completed | type) == "number"
    and (.optimizer_update_count | type) == "number"
    and (.policy_update_count | type) == "number"
    and (.total_task_groups | type) == "number"
    and (.replay_task_groups | type) == "number"
    and (.promotion_count | type) == "number"
    and .validation_examples == $expected_validation_examples
    and .test_examples == $expected_test_examples
    and .mastery_windows == $expected_mastery_windows
    and .training_tasks_per_update == $expected_training_tasks_per_update
    and .replay_tasks_per_level == $expected_replay_tasks_per_level
    and .training_configuration.maximum_updates == $expected_maximum_updates
    and .training_configuration.maximum_final_evaluation_reserve_seconds == $expected_final_evaluation_reserve
    and .evaluation_interval_method == "wilson-score-95"
    and (.attempt_count == 1 or .attempt_count == 2)
    and .resumed_from_checkpoint == (.attempt_count == 2)
    and (.paired_test_change.examples | type) == "number"
    and (.final_evaluation_complete | type) == "boolean"
    and .final_evaluation_partial == (.final_evaluation_complete | not)
    and ([.initial_by_level[], .final_by_level[]
      | .examples == .distinct_semantic_examples
        and .semantic_universe_size >= $expected_test_examples
    ] | all)
    and (
      (
        .final_evaluation_complete == true
        and (
          (
            .probative_post_training == false
            and .claim_strength == "NONPROBATIVE_RESERVE_STOP"
          )
          or (
            .probative_post_training == true
            and .claim_strength == "EXPLORATORY_SINGLE_SEED"
          )
        )
        and ([.initial_by_level[], .final_by_level[]
          | .examples == $expected_test_examples
            and .complete == true
            and (.exact_rate_95ci | length) == 2
        ] | all)
      )
      or (
        .final_evaluation_partial == true
        and .claim_strength == "INCOMPLETE_FINAL_EVALUATION"
        and .hypothesis_passed == false
        and .reward_gain == null
        and ([.initial_by_level[], .final_by_level[]
          | .examples <= $expected_test_examples
        ] | all)
      )
    )
    and (.total_sampled_actions | type) == "number"
    and (.total_post_branch_actions | type) == "number"
    and (.branch_snapshots | type) == "array"
    and .probative_post_training == (
      .updates_completed >= 1
      and .policy_update_count >= 1
      and .restored_branching_observed == true
    )
    and (.discarded_task_groups | type) == "number"
    and (.discarded_sampled_actions | type) == "number"
    and .discarded_sampled_actions <= .total_sampled_actions
    and (.discarded_post_branch_actions | type) == "number"
    and .discarded_post_branch_actions <= .total_post_branch_actions
    and (.structural_mirror_disclosures | type) == "array"
    and (.structural_mirror_disclosures | length) >= 7
    and .adapter_manifest.digest != null
    and ([.adapter_manifest.files[].path
      | startswith("checkpoints/")
      | not
    ] | all)
    and (
      if .probative_post_training == false then
        .stop_reason == "final_evaluation_reserve_ceiling"
        and .updates_completed >= 0
        and .optimizer_update_count >= 0
        and .policy_update_count >= 0
        and .total_task_groups >= 0
        and .total_sampled_actions >= 0
        and .total_post_branch_actions >= 0
      else
        .probative_post_training == true
        and .updates_completed >= 1
        and .policy_update_count >= 1
        and .total_task_groups >= 1
        and .total_sampled_actions >= 4
        and .total_post_branch_actions >= 4
        and .restored_branching_observed == true
        and
        (.branch_snapshots | length) >= 1
        and (
          [.branch_snapshots[]
            | select(
              .checkpoint != null
              and .checkpoint.static_branch_width == 4
              and (.shared_prefix.steps | length) >= 2
              and (.siblings | length) == 4
              and ([.siblings[].steps | length] | all(. >= 1))
            )
          ] | length
        ) >= 1
      end
    )
    and (.hypothesis_passed | type) == "boolean"
  '
fi
if ! jq -e \
  --arg expected_model "$model_id" \
  --argjson expected_validation_examples "$validation_examples" \
  --argjson expected_test_examples "$test_examples" \
  --argjson expected_mastery_windows "$mastery_windows" \
  --argjson expected_training_tasks_per_update "$training_tasks_per_update" \
  --argjson expected_replay_tasks_per_level "$replay_tasks_per_level" \
  --argjson expected_maximum_updates "$maximum_updates" \
  --argjson expected_final_evaluation_reserve "$maximum_final_evaluation_reserve_seconds" \
  "$proof_assertion" >/dev/null <<<"$metrics"; then
  failure_message="The remote result did not satisfy the declared proof contract."
  echo "The remote workload completed but did not meet the proof assertions." >&2
  jq . <<<"$metrics" >&2
  exit 1
fi
if [[ "$experiment" == "repository-repair" ]] &&
  [[ "$(jq -r '.stop_reason' <<<"$metrics")" == "final_evaluation_reserve_ceiling" ]]; then
  if [[ "$(jq -r '.probative_post_training' <<<"$metrics")" == "true" ]]; then
    echo \
      "Remote result is probative: training stopped early after the evaluation reserve exceeded its ceiling." \
      >&2
  else
    if [[ "$(jq -r '.updates_completed' <<<"$metrics")" == "0" ]]; then
      echo \
        "Remote result is valid but non-probative: evaluation reserve exceeded its ceiling before training." \
        >&2
    else
      echo \
        "Remote result is valid but non-probative: reserve ceiling stopped training before enough learning evidence accrued." \
        >&2
    fi
  fi
fi

last_progress="$(
  jq -c \
    --argjson result "$metrics" \
    '
      ($result.reached_complexity_level // .current_level // 0) as $level
      | . + {
          phase: "finalizing",
          message: "Result persisted; confirming RunPod teardown.",
          update: ($result.updates_completed // .update // 0),
          current_level: $level,
          promotion_count: ($result.promotion_count // .promotion_count // 0),
          sampled_completions: (
            $result.total_sampled_completions
            // $result.total_sampled_actions
            // .sampled_completions
            // 0
          ),
          exact_rate: (
            $result.final_by_level[($level | tostring)].exact_rate
            // $result.final_reward
            // .exact_rate
          ),
          elapsed_seconds: ($result.elapsed_seconds // .elapsed_seconds),
          stop_reason: ($result.stop_reason // .stop_reason),
          hypothesis_passed: (
            $result.hypothesis_passed // .hypothesis_passed
          )
        }
    ' <<<"$last_progress"
)"
publish_execution "FINALIZING" "$last_progress"

echo "Remote loop passed; terminating worker $pod_id." >&2
failure_message="RunPod teardown could not be confirmed."
runpodctl pod delete "$pod_id" >/dev/null
for _ in {1..12}; do
  if ! pod_is_present; then
    break
  fi
  sleep 5
done
if pod_is_present; then
  echo "RunPod still reports worker $pod_id; refusing to record confirmed teardown." >&2
  exit 1
fi
completed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
pod_id=""

receipt_path="$receipt_directory/$proof_id.json"
jq -n \
  --arg provider_name "RunPod" \
  --arg provider_handle "$provider_handle" \
  --arg provider_cli_version "$(runpodctl version | awk '{print $2}')" \
  --arg gpu_id "$gpu_id" \
  --arg image "$image" \
  --arg cloud_type "$cloud_type" \
  --argjson persistent_volume_in_gb "$persistent_volume_in_gb" \
  --argjson hourly_cost "$hourly_cost" \
  --arg started_at "$started_at" \
  --arg completed_at "$completed_at" \
  --argjson result "$metrics" \
  '{
    provider_name: $provider_name,
    provider_handle: $provider_handle,
    provider_cli_version: $provider_cli_version,
    resource_profile: {
      gpu_id: $gpu_id,
      gpu_count: 1,
      image: $image,
      hourly_cost_usd: $hourly_cost,
      cloud_type: $cloud_type,
      persistent_volume_in_gb: $persistent_volume_in_gb
    },
    workload: {
      id: $result.workload,
      revision: $result.workload_revision,
      algorithm: $result.algorithm,
      static_branch_width: $result.branch_width,
      complexity_strategy: $result.complexity_strategy,
      scale_case_count: ($result.test_case_count // null),
      maximum_horizon: ($result.maximum_horizon // null),
      total_action_decisions: ($result.total_action_decisions // null),
      model_id: ($result.model_id // null),
      model_revision: ($result.model_revision // null),
      task_domains: ($result.task_domains // null),
      maximum_complexity_level: ($result.maximum_complexity_level // null),
      reached_complexity_level: ($result.reached_complexity_level // null),
      total_sampled_completions: ($result.total_sampled_completions // null),
      total_sampled_actions: ($result.total_sampled_actions // null),
      multi_step: ($result.multi_step // null),
      restored_continuations: ($result.restored_continuations // null),
      snapshot_fidelity: ($result.snapshot_fidelity // null),
      replay_enabled: ($result.replay_enabled // null)
    },
    result: $result,
    started_at: $started_at,
    completed_at: $completed_at,
    teardown_confirmed: true
  }' >"$receipt_path"

failure_message="The sanitized proof receipt could not be ingested after teardown."
curl --fail --silent --show-error \
  -X POST "$api_root/internal/research-compute-proofs" \
  -H "Authorization: Bearer $internal_token" \
  -H 'Content-Type: application/json' \
  --data-binary "@$receipt_path" |
  jq .
terminal_published=true
echo "Sanitized receipt: $receipt_path" >&2
