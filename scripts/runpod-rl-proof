        network_volume_deletion_required: $deletion_required,
        network_volume_deletion_deadline: $deletion_deadline,
        network_volume_deletion_attempted: $deletion_attempted,
        network_volume_deletion_confirmed: $deletion_confirmed,
        network_volume_deletion_deadline_met: $deletion_deadline_met,
        network_volume_deleted_at: $deleted_at
      }' <<<"$last_progress"
  )"
fi
provider_teardown_confirmed=true
completed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
