  create_arguments+=(--data-center-ids "$data_center_ids")
fi
pod_create_attempted=true
if [[ "$larger_model_mode" == "pilot" ]]; then
  if ! jq -n \
      --arg proof_id "$proof_id" \
      --arg screen_result_digest "$larger_model_screen_result_digest" \
      --arg authorization_digest "$larger_model_authorization_digest" \
      --arg consumed_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
      '{
        proof_id: $proof_id,
        screen_result_digest: $screen_result_digest,
        authorization_digest: $authorization_digest,
        consumed_at: $consumed_at
      }' |
    durable_create_stdin "$authorization_consumption_path" 2>/dev/null; then
    pod_create_attempted=false
    echo "The matching larger-model screen authorization was consumed concurrently." >&2
    exit 1
  fi
fi
boot_started_epoch="$(date +%s)"
readiness_deadline_epoch=$((boot_started_epoch + boot_timeout_seconds))
set +e
create_response="$(run_provider_command 90 runpodctl "${create_arguments[@]}")"
create_exit_code="$?"
set -e
pod_id="$(jq -r '.id // .pod.id // empty' <<<"$create_response" 2>/dev/null || true)"
if [[ "$pod_id" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  provider_handle="runpod://pods/$pod_id"
  if [[ "$create_exit_code" != "0" ]]; then
    failure_message="RunPod pod creation returned a valid pod id with a failed command status."
    echo "RunPod returned $pod_id with status $create_exit_code; cleanup will delete that exact pod." >&2
    exit 1
  fi
else
  pod_id=""
  ambiguous_create_unresolved=true
  ambiguous_create_safe_after_epoch="$(($(date +%s) + ambiguous_create_visibility_seconds))"
  if reconcile_pod_id_by_name; then
    failure_message="RunPod pod creation returned ambiguously after allocating a worker."
    echo "Reconciled ambiguous pod creation to $pod_id; cleanup will delete it." >&2
  else
    failure_message="RunPod pod creation failed and provider state could not be reconciled."
    echo "RunPod did not return a valid pod id; refusing to assume no worker exists." >&2
  fi
  exit 1
fi

failure_message="RunPod did not report a bounded hourly rate."
pod_response="$(run_provider_command 30 runpodctl pod get "$pod_id")"
hourly_cost="$(
  jq -r '.adjustedCostPerHr // .costPerHr // .costPerHour // empty' <<<"$pod_response"
)"
if [[ -z "$hourly_cost" ]]; then
  echo "RunPod did not report an hourly cost; terminating rather than running unbounded." >&2
  exit 1
fi
if ! jq -en \
  --argjson observed "$hourly_cost" \
  --argjson maximum "$maximum_hourly_cost" \
  '$observed <= $maximum' >/dev/null; then
  echo "Hourly cost \$$hourly_cost exceeds the \$$maximum_hourly_cost ceiling." >&2
  exit 1
fi
resource_profile="$(
  jq -cn \
    --arg gpu_id "$gpu_id" \
    --arg image "$image" \
    --arg cloud_type "$cloud_type" \
    --arg data_center_ids "$data_center_ids" \
    --arg network_volume_id "$network_volume_id" \
    --arg network_volume_data_center_id "$network_volume_data_center_id" \
    --arg volume_readiness_receipt_digest "$volume_readiness_receipt_digest" \
    --argjson persistent_volume_in_gb "$persistent_volume_in_gb" \
    --argjson hourly_cost "$hourly_cost" \
    --argjson maximum_hourly_cost "$maximum_hourly_cost" \
    --argjson maximum_total_cost "$maximum_total_cost" \
    --argjson minimum_gpu_memory_gb "$minimum_gpu_memory_gb" \
    --argjson model_load_timeout_seconds "$model_load_timeout_seconds" \
    --argjson stale_progress_timeout_seconds "$stale_progress_timeout_seconds" \
    '{
      gpu_id: $gpu_id,
      gpu_count: 1,
      image: $image,
      cloud_type: $cloud_type,
      data_center_ids: (
        if $data_center_ids == ""
        then null
        else ($data_center_ids | split(","))
        end
      ),
      persistent_volume_in_gb: $persistent_volume_in_gb,
      network_volume_id: (
        if $network_volume_id == "" then null else $network_volume_id end
      ),
      network_volume_data_center_id: (
        if $network_volume_data_center_id == ""
        then null
        else $network_volume_data_center_id
        end
      ),
      volume_readiness_receipt_digest: (
        if $volume_readiness_receipt_digest == ""
        then null
        else $volume_readiness_receipt_digest
        end
      ),
      hourly_cost_usd: $hourly_cost,
      maximum_hourly_cost_usd: $maximum_hourly_cost,
      maximum_total_cost_usd: $maximum_total_cost,
      minimum_gpu_memory_gb: $minimum_gpu_memory_gb,
      model_load_timeout_seconds: $model_load_timeout_seconds,
      stale_progress_timeout_seconds: $stale_progress_timeout_seconds
    }'
)"
last_progress="$(
  jq -cn \
    --argjson maximum_updates "$maximum_updates" \
    '{
      phase: "waiting_for_capacity",
      message: "Pod created; waiting for a live container endpoint.",
      maximum_level: 3,
      maximum_updates: $maximum_updates
    }'
)"
failure_message="The RunPod worker never exposed structured workload progress."
publish_execution "PROVISIONING" "$last_progress" "" false "$readiness_deadline_epoch"

echo "Worker $pod_id allocated at \$$hourly_cost/hour; waiting for container readiness." >&2
proxy_root="https://${pod_id}-8000.proxy.runpod.net"
progress_url="$proxy_root/progress.json"
remote_authorization="Authorization: Bearer $transport_token"
exit_code=""
workload_transport_ready=false
preparation_started_epoch=""
attempt=0
while readiness_poll_timeout="$(
  seconds_until_deadline "$readiness_deadline_epoch" 10
)"; do
  attempt=$((attempt + 1))
  remote_progress="$(
    curl --fail --silent --show-error --max-time "$readiness_poll_timeout" \
      -H "$remote_authorization" "$progress_url" 2>/dev/null || true
  )"
  if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$remote_progress"; then
    last_progress_change_epoch="$(date +%s)"
    remote_phase="$(jq -r '.phase // empty' <<<"$remote_progress")"
    if [[ "$remote_phase" == "dependency_setup" || "$remote_phase" == "model_loading" ]]; then
      preparation_started_epoch="$(date +%s)"
    fi
    last_progress="$(
      jq -cn \
        --argjson previous "$last_progress" \
        --argjson current "$remote_progress" \
        '$previous + $current'
    )"
    publish_execution "RUNNING" "$last_progress" "" false "$readiness_deadline_epoch"
    workload_transport_ready=true
    break
  fi
  if ((attempt == 1 || attempt % 3 == 0)); then
    elapsed_wait=$(($(date +%s) - boot_started_epoch))
    last_progress="$(
      jq -cn \
        --arg message "Pod created; waiting for a live container endpoint." \
        --argjson elapsed_seconds "$elapsed_wait" \
        --argjson maximum_updates "$maximum_updates" \
        '{
          phase: "waiting_for_capacity",
          message: $message,
          elapsed_seconds: $elapsed_seconds,
          maximum_level: 3,
          maximum_updates: $maximum_updates
        }'
    )"
    publish_execution "PROVISIONING" "$last_progress" "" false "$readiness_deadline_epoch"
  fi
  if ! readiness_sleep_seconds="$(
    seconds_until_deadline "$readiness_deadline_epoch" 5
  )"; then
    break
  fi
  sleep "$readiness_sleep_seconds"
done
rm -f -- "$bundle_source_path"
bundle_source_path=""
if [[ "$workload_transport_ready" != true ]]; then
  echo "The inline workload did not expose structured progress before timeout." >&2
  exit 1
fi

echo "Container is live; streaming structured progress to Equinox." >&2
provider_deadline_epoch=$((started_epoch + maximum_lifetime_minutes * 60))
result_deadline_epoch=$((provider_deadline_epoch - cleanup_reserve_seconds - artifact_retrieval_reserve_seconds))
failure_message="The remote workload did not finish before the provider cleanup reserve."
while (( $(date +%s) < result_deadline_epoch )); do
  current_epoch="$(date +%s)"
  accrued_cost="$(
    jq -n \
      --argjson hourly_cost "$hourly_cost" \
      --argjson elapsed_seconds "$((current_epoch - started_epoch))" \
      '$hourly_cost * $elapsed_seconds / 3600'
  )"
  if ! jq -en \
    --argjson accrued "$accrued_cost" \
    --argjson maximum "$maximum_total_cost" \
    '$accrued < $maximum' >/dev/null; then
    failure_message="The total-cost ceiling was reached before the workload completed."
    echo "Stopping before accrued cost can exceed \$$maximum_total_cost." >&2
    exit 1
  fi
  if [[ -n "$preparation_started_epoch" ]] &&
    ((current_epoch - preparation_started_epoch > model_load_timeout_seconds)); then
    failure_message="Dependency preparation or model loading exceeded its bounded timeout."
    echo "Model readiness exceeded ${model_load_timeout_seconds}s; terminating the worker." >&2
    exit 1
  fi
  if [[ -n "$larger_model_mode" ]] &&
    ((current_epoch - last_progress_change_epoch > stale_progress_timeout_seconds)); then
    failure_message="Structured remote progress stopped changing before completion."
    echo "No progress change for ${stale_progress_timeout_seconds}s; terminating the worker." >&2
    exit 1
  fi
  exit_code="$(
    curl --fail --silent --show-error --max-time 10 \
      -H "$remote_authorization" "$proxy_root/exit_code" 2>/dev/null || true
  )"
  if [[ -n "$exit_code" ]]; then
    break
  fi
  remote_progress="$(
    curl --fail --silent --show-error --max-time 10 \
      -H "$remote_authorization" "$progress_url" 2>/dev/null || true
  )"
  if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$remote_progress" &&
    [[ "$remote_progress" != "$last_remote_progress" ]]; then
    last_progress_change_epoch="$current_epoch"
    remote_phase="$(jq -r '.phase // empty' <<<"$remote_progress")"
    if [[ -z "$preparation_started_epoch" ]] &&
      [[ "$remote_phase" == "dependency_setup" || "$remote_phase" == "model_loading" ]]; then
      preparation_started_epoch="$current_epoch"
    elif [[ "$remote_phase" != "dependency_setup" && "$remote_phase" != "model_loading" ]]; then
      preparation_started_epoch=""
    fi
    last_progress="$(
      jq -cn \
        --argjson previous "$last_progress" \
        --argjson current "$remote_progress" \
        '$previous + $current'
    )"
    if publish_execution "RUNNING" "$last_progress"; then
      last_remote_progress="$remote_progress"
    else
      echo "Observer progress publish failed after retries; monitoring continues." >&2
    fi
  fi
  sleep 5
done
if [[ -z "$exit_code" ]]; then
  echo "The remote workload did not finish before the cleanup reserve." >&2
  exit 1
fi
if [[ "$exit_code" != "0" ]]; then
  failure_message="The remote workload failed with exit code $exit_code."
  echo "The remote workload failed with exit code $exit_code." >&2
  curl --fail --silent --show-error --max-time 30 \
    -H "$remote_authorization" \
    "$proxy_root/error.log" 2>/dev/null |
    tail -40 >&2 || true
  exit 1
fi
metrics="$(
  curl --fail --silent --show-error --max-time 60 \
    -H "$remote_authorization" "$proxy_root/result.json"
)"
if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$metrics"; then
  failure_message="The remote workload result was missing or invalid."
  echo "The remote workload did not return a valid metrics object." >&2
  exit 1
fi
result_path="$receipt_directory/$proof_id.result.json"
jq . <<<"$metrics" >"$result_path"
if [[ "$experiment" == "repository-repair" &&
  "$study_eligibility_only" != "1" &&
  "$larger_model_mode" != "screen" ]]; then
  adapter_path="$receipt_directory/$proof_id.adapter.tgz"
  adapter_pending_path="$adapter_path.pending"
  curl --fail --silent --show-error --max-time 120 \
    -H "$remote_authorization" \
    "$proxy_root/adapter.tgz" >"$adapter_pending_path"
  if [[ ! -s "$adapter_pending_path" ]]; then
    failure_message="The trained LoRA adapter could not be persisted before teardown."
    echo "The remote adapter artifact was empty; refusing to terminate as a successful run." >&2
    exit 1
  fi
  mv "$adapter_pending_path" "$adapter_path"
  python3 - "$adapter_path" "$(jq -r '.adapter_manifest.digest // empty' <<<"$metrics")" <<'PY'
import hashlib
import json
import sys
import tarfile

archive_path, expected_digest = sys.argv[1:]
if not expected_digest.startswith("sha256:"):
    raise SystemExit("result omitted the adapter manifest digest")
with tarfile.open(archive_path, "r:gz") as archive:
    members = {
        member.name: member
        for member in archive.getmembers()
        if member.isfile()
    }
    manifest_member = members.get("adapter/adapter-manifest.json")
    if manifest_member is None:
        raise SystemExit("adapter archive omitted its manifest")
    manifest = json.load(archive.extractfile(manifest_member))
    content = {key: value for key, value in manifest.items() if key != "digest"}
    digest = "sha256:" + hashlib.sha256(
        json.dumps(content, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    if digest != expected_digest or manifest.get("digest") != expected_digest:
        raise SystemExit("adapter manifest digest mismatch")
    for item in manifest["files"]:
        member = members.get("adapter/" + item["path"])
        if member is None:
            raise SystemExit(f"adapter archive omitted {item['path']}")
        payload = archive.extractfile(member).read()
        if len(payload) != item["size_bytes"]:
            raise SystemExit(f"adapter size mismatch for {item['path']}")
        if hashlib.sha256(payload).hexdigest() != item["sha256"]:
            raise SystemExit(f"adapter digest mismatch for {item['path']}")
PY
fi
