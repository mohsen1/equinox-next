#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$repository_root/.venv/bin/python3" ]]; then
  PATH="$repository_root/.venv/bin:$PATH"
fi
"$repository_root/scripts/ensure-local-env"
internal_token="${EQUINOX_INTERNAL_TOKEN:-$(
  sed -n 's/^EQUINOX_INTERNAL_TOKEN=//p' "$repository_root/.env" | tail -n 1
)}"
if [[ ${#internal_token} -lt 32 ]]; then
  echo "EQUINOX_INTERNAL_TOKEN must contain at least 32 characters." >&2
  exit 1
fi
experiment="${EQUINOX_RUNPOD_EXPERIMENT:-repository-repair}"
support_files=()
study_condition="${EQUINOX_STUDY_CONDITION:-}"
study_revision="${EQUINOX_STUDY_REVISION:-30}"
study_validation_seed_base="${EQUINOX_STUDY_VALIDATION_SEED_BASE:-}"
study_test_seed_base="${EQUINOX_STUDY_TEST_SEED_BASE:-}"
study_completion_budget="${EQUINOX_STUDY_COMPLETION_BUDGET:-}"
study_eligibility_only="${EQUINOX_STUDY_ELIGIBILITY_ONLY:-}"
larger_model_mode="${EQUINOX_LARGER_MODEL_MODE:-}"
expected_study_id="repository-repair-confirmatory-study@1"
expected_complexity_strategy="adaptive"
expected_mastery_window_basis="retained_zero_regression_checkpoints"
expected_frontier_probe_routing="mixed_correctness_branch_contrast_feedback"
expected_training_level_allocation="current_and_adaptive_probe_even_split"
expected_branch_width=4
expected_algorithm="verified-fix-group-conditioned-policy-gradient"
case "$experiment" in
  sequence-ladder)
    workload_file="branching_sequence_ladder.py"
    workload_id="branching-sequence-policy-gradient-ladder"
    execution_name="Branching sequence ladder"
    default_model_id=""
    default_gpu_id="NVIDIA GeForce RTX 3090"
    default_cloud_type="COMMUNITY"
    default_target_runtime_seconds="420"
    default_maximum_lifetime_minutes="15"
    default_retry_reserve_seconds="0"
    default_maximum_final_evaluation_reserve_seconds="0"
    default_maximum_updates="1200"
    default_validation_examples="1"
    default_test_examples="1"
    default_mastery_windows="1"
    default_training_tasks_per_update="1"
    default_replay_tasks_per_level="1"
    ;;
  repository-repair)
    contract_workload_file="repository_repair_rl.py"
    environment_file="repository_repair_env.py"
    if [[ -n "$larger_model_mode" ]]; then
      if [[ -n "$study_condition" || -n "$study_eligibility_only" ]]; then
        echo "Larger-model runs cannot be combined with a frozen study condition." >&2
        exit 1
      fi
      contract_workload_file="repository_repair_large_model_pilot.py"
      environment_file="repository_repair_env_v32.py"
      support_files=(
        "larger_model_gate.py"
        "repository_repair_env.py"
        "repository_repair_env_v31.py"
        "$environment_file"
        "repository_repair_rl.py"
        "repository_repair_study.py"
      )
      case "$larger_model_mode" in
        screen)
          workload_file="repository_repair_large_model_eligibility.py"
          support_files+=("repository_repair_large_model_pilot.py")
          workload_id="repository-repair-larger-model-eligibility"
          execution_name="7B eligibility screen"
          ;;
        pilot)
          workload_file="repository_repair_large_model_pilot.py"
          support_files+=("repository_repair_large_model_eligibility.py")
          workload_id="repository-repair-restored-continuation-post-training"
          execution_name="7B K=4 pilot"
          ;;
        *)
          echo "EQUINOX_LARGER_MODEL_MODE must be screen or pilot." >&2
          exit 1
          ;;
      esac
    elif [[ -z "$study_condition" ]]; then
      workload_file="$contract_workload_file"
      support_files=("$environment_file")
    else
      if [[ "$study_revision" == "31" ]]; then
        if [[ "$study_eligibility_only" == "1" ]]; then
          echo "Revision 31 does not use the revision-30 eligibility screen." >&2
          exit 1
        fi
        workload_file="repository_repair_study_v31.py"
        contract_workload_file="$workload_file"
        environment_file="repository_repair_env_v31.py"
        support_files=(
          "repository_repair_study.py"
          "repository_repair_rl.py"
          "repository_repair_env.py"
          "$environment_file"
        )
        expected_study_id="repository-repair-causal-factorial-study@2"
        case "$study_condition" in
          k1_adaptive | k4_adaptive)
            expected_complexity_strategy="adaptive"
            ;;
          k1_scheduled_dynamic | k4_scheduled_dynamic)
            expected_complexity_strategy="scheduled_dynamic"
            expected_mastery_window_basis="scheduled_completed_validation_windows"
            expected_frontier_probe_routing="scheduled_nearest_harder_probe"
            expected_training_level_allocation="current_and_scheduled_probe_even_split"
            ;;
          *)
            echo "Revision-31 conditions must name a preregistered factorial cell." >&2
            exit 1
            ;;
        esac
      elif [[ "$study_revision" != "30" ]]; then
        echo "EQUINOX_STUDY_REVISION must be 30 or 31." >&2
        exit 1
      elif [[ "$study_eligibility_only" == "1" ]]; then
        workload_file="repository_repair_eligibility.py"
        support_files=(
          "repository_repair_study.py"
          "$contract_workload_file"
          "$environment_file"
        )
      else
        workload_file="repository_repair_study.py"
        support_files=("$contract_workload_file" "$environment_file")
      fi
      case "$study_condition" in
        k4_train)
          if [[ "$study_eligibility_only" == "1" ]]; then
            execution_name="Protocol eligibility · seed ${EQUINOX_RL_SEED:-unset}"
          else
            execution_name="K=4 training · seed ${EQUINOX_RL_SEED:-unset}"
          fi
          ;;
        k4_no_update)
          execution_name="K=4 no-update control · seed ${EQUINOX_RL_SEED:-unset}"
          ;;
        k1_train)
          execution_name="K=1 training · seed ${EQUINOX_RL_SEED:-unset}"
          expected_branch_width=1
          expected_algorithm="verified-fix-positive-only-policy-gradient-k1"
          ;;
        k4_adaptive)
          execution_name="K=4 · adaptive complexity · seed ${EQUINOX_RL_SEED:-unset}"
          ;;
        k4_scheduled_dynamic)
          execution_name="K=4 · scheduled complexity · seed ${EQUINOX_RL_SEED:-unset}"
          ;;
        k1_adaptive)
          execution_name="K=1 · adaptive complexity · seed ${EQUINOX_RL_SEED:-unset}"
          expected_branch_width=1
          expected_algorithm="verified-fix-positive-only-policy-gradient-k1"
          ;;
        k1_scheduled_dynamic)
          execution_name="K=1 · scheduled complexity · seed ${EQUINOX_RL_SEED:-unset}"
          expected_branch_width=1
          expected_algorithm="verified-fix-positive-only-policy-gradient-k1"
          ;;
        *)
          echo "EQUINOX_STUDY_CONDITION does not name a supported study condition." >&2
          exit 1
          ;;
      esac
    fi
    if [[ -n "$larger_model_mode" ]]; then
      :
    elif [[ "$study_eligibility_only" == "1" ]]; then
      workload_id="repository-repair-protocol-eligibility"
    else
      workload_id="repository-repair-restored-continuation-post-training"
    fi
    execution_name="${execution_name:-Repository repair post-training}"
    default_model_id="Qwen/Qwen2.5-Coder-3B-Instruct"
    default_gpu_id="NVIDIA A40"
    default_cloud_type="SECURE"
    default_target_runtime_seconds="7200"
    default_maximum_lifetime_minutes="240"
    default_retry_reserve_seconds="2700"
    default_maximum_final_evaluation_reserve_seconds="2700"
    default_maximum_updates="120"
    default_validation_examples="8"
    default_test_examples="6"
    default_mastery_windows="2"
    default_training_tasks_per_update="4"
    default_replay_tasks_per_level="1"
    if [[ "$larger_model_mode" == "screen" ]]; then
      default_model_id="Qwen/Qwen2.5-Coder-7B-Instruct"
      default_gpu_id="NVIDIA H100 80GB HBM3"
      default_target_runtime_seconds="1500"
      default_maximum_lifetime_minutes="43"
      default_retry_reserve_seconds="300"
      default_maximum_final_evaluation_reserve_seconds="300"
      default_maximum_updates="1"
      default_validation_examples="8"
      default_test_examples="4"
      default_mastery_windows="1"
      default_training_tasks_per_update="8"
      default_replay_tasks_per_level="1"
    elif [[ "$larger_model_mode" == "pilot" ]]; then
      default_model_id="Qwen/Qwen2.5-Coder-7B-Instruct"
      default_gpu_id="NVIDIA H100 80GB HBM3"
      default_target_runtime_seconds="9000"
      default_maximum_lifetime_minutes="238"
      default_retry_reserve_seconds="1800"
      default_maximum_final_evaluation_reserve_seconds="1800"
      default_maximum_updates="40"
      default_validation_examples="8"
      default_test_examples="12"
      default_mastery_windows="2"
      default_training_tasks_per_update="4"
      default_replay_tasks_per_level="1"
    elif [[ -n "$study_condition" ]]; then
      default_target_runtime_seconds="10800"
      default_maximum_lifetime_minutes="360"
      default_test_examples="12"
      if [[ "$study_condition" == "k1_train" ]]; then
        default_training_tasks_per_update="12"
      elif [[ "$study_revision" == "31" && "$study_condition" == k1_* ]]; then
        default_training_tasks_per_update="12"
      elif [[ "$study_revision" == "31" && "$study_condition" == k4_* ]]; then
        default_training_tasks_per_update="3"
      fi
    fi
    ;;
  *)
    echo "EQUINOX_RUNPOD_EXPERIMENT must be sequence-ladder or repository-repair." >&2
    exit 1
    ;;
esac
workload_path="$repository_root/research/runpod/$workload_file"
contract_workload_path="$repository_root/research/runpod/${contract_workload_file:-$workload_file}"
environment_path="$repository_root/research/runpod/${environment_file:-$workload_file}"
bootstrap_server_path="$repository_root/research/runpod/bootstrap_server.py"
remote_runner_path="$repository_root/research/runpod/remote_runner.sh"
result_server_path="$repository_root/research/runpod/result_server.py"
receipt_directory="$repository_root/var/research-proofs"
api_root="${EQUINOX_API_ROOT:-http://127.0.0.1:8180}"
dashboard_root="${EQUINOX_DASHBOARD_ROOT:-http://127.0.0.1:3100}"
gpu_id="${EQUINOX_RUNPOD_GPU:-$default_gpu_id}"
template_id="${EQUINOX_RUNPOD_TEMPLATE:-runpod-torch-v280}"
cloud_type="${EQUINOX_RUNPOD_CLOUD_TYPE:-$default_cloud_type}"
data_center_ids="${EQUINOX_RUNPOD_DATA_CENTER_IDS:-}"
default_maximum_hourly_cost="0.50"
default_maximum_total_cost="10.00"
default_minimum_gpu_memory_gb="1"
default_model_load_timeout_seconds="1200"
default_maximum_workload_attempts="2"
default_container_disk_in_gb="30"
default_persistent_volume_in_gb="10"
default_stale_progress_timeout_seconds="1800"
if [[ "$larger_model_mode" == "screen" ]]; then
  default_maximum_hourly_cost="4.00"
  default_maximum_total_cost="3.00"
  default_minimum_gpu_memory_gb="80"
  default_maximum_workload_attempts="1"
  default_container_disk_in_gb="50"
  default_persistent_volume_in_gb="50"
  default_stale_progress_timeout_seconds="600"
elif [[ "$larger_model_mode" == "pilot" ]]; then
  default_maximum_hourly_cost="4.00"
  default_maximum_total_cost="16.00"
  default_minimum_gpu_memory_gb="80"
  default_maximum_workload_attempts="1"
  default_container_disk_in_gb="50"
  default_persistent_volume_in_gb="50"
  default_stale_progress_timeout_seconds="900"
fi
maximum_hourly_cost="${EQUINOX_RUNPOD_MAX_HOURLY_COST:-$default_maximum_hourly_cost}"
maximum_total_cost="${EQUINOX_RUNPOD_MAX_TOTAL_COST:-$default_maximum_total_cost}"
minimum_gpu_memory_gb="${EQUINOX_RUNPOD_MIN_GPU_MEMORY_GB:-$default_minimum_gpu_memory_gb}"
