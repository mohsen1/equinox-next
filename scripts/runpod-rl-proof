          $torch_retention_evidence_digest,
        EQUINOX_DEPENDENCY_LOCK_SHA256: $dependency_lock_digest,
        EQUINOX_DEPENDENCY_QUARANTINE_EVIDENCE_SHA256:
          $dependency_quarantine_evidence_digest,
        EQUINOX_DEPENDENCY_PRIVATE_TREE_SHA256:
          $dependency_private_tree_digest,
        EQUINOX_CODE_MATERIALIZATION_EVIDENCE_SHA256:
          $code_materialization_evidence_digest,
        EQUINOX_CODE_PRIVATE_TREE_SHA256:
          $code_private_tree_digest,
        EQUINOX_RUNPOD_NETWORK_VOLUME_ID: $network_volume_id,
        EQUINOX_RUNPOD_NETWORK_VOLUME_DATA_CENTER_ID:
          $network_volume_data_center_id,
        EQUINOX_RUNPOD_NETWORK_VOLUME_SIZE_GB: $network_volume_size_gb,
        EQUINOX_BUNDLE_ACTIVATION_DIGEST: $activation_digest
      }'
  )"
else
  pod_environment="$(
    base64 <"$bundle_source_path" |
      tr -d '\n' |
      jq -Rsc \
      --arg token "$transport_token" \
      --arg checkpoint_authentication_key "$checkpoint_authentication_key" \
      --arg run_identity "$proof_id" \
      --arg bundle_digest "$bundle_digest" \
      --arg proof_id "$proof_id" \
      '{
        EQUINOX_RESULT_TOKEN: $token,
        EQUINOX_CHECKPOINT_AUTHENTICATION_KEY: $checkpoint_authentication_key,
        EQUINOX_RUN_IDENTITY: $run_identity,
        EQUINOX_PROOF_ID: $proof_id,
        EQUINOX_BUNDLE_B64: .,
        EQUINOX_BUNDLE_SHA256: $bundle_digest
      }'
  )"
fi
pod_environment_size_bytes="$(
  printf '%s' "$pod_environment" |
    wc -c |
    tr -d ' '
)"
if [[ -n "$larger_model_mode" ]] && ((pod_environment_size_bytes > 4 * 1024)); then
  echo "The volume-bundle pod environment exceeds the 4 KiB transport limit." >&2
  exit 1
fi
if [[ -z "$larger_model_mode" ]] && ((pod_environment_size_bytes > 120 * 1024)); then
  echo "The serialized pod environment exceeds the 120 KiB process-argument limit." >&2
  exit 1
fi
bootstrap_private_directory="/tmp/equinox-bootstrap-$proof_id"
bootstrap_private_path="$bootstrap_private_directory/bootstrap_server.py"
bootstrap_exec_code='import hashlib,os,stat,sys
path,expected=sys.argv[1:]
flags=os.O_RDONLY|getattr(os,"O_CLOEXEC",0)|getattr(os,"O_NOFOLLOW",0)
descriptor=os.open(path,flags)
metadata=os.fstat(descriptor)
if not stat.S_ISREG(metadata.st_mode):
    raise SystemExit("bootstrap source is not a regular file")
os.fchmod(descriptor,0o444)
metadata=os.fstat(descriptor)
digest=hashlib.sha256()
while True:
    chunk=os.read(descriptor,1024*1024)
    if not chunk:
        break
    digest.update(chunk)
after=os.fstat(descriptor)
stable=("st_dev","st_ino","st_mode","st_size","st_mtime_ns","st_ctime_ns")
if any(getattr(metadata,key)!=getattr(after,key) for key in stable):
    raise SystemExit("bootstrap source changed during verification")
if digest.hexdigest()!=expected:
    raise SystemExit("bootstrap source digest mismatch")
os.lseek(descriptor,0,os.SEEK_SET)
os.set_inheritable(descriptor,True)
os.unlink(path)
os.rmdir(os.path.dirname(path))
os.execve(
    sys.executable,
    [sys.executable,"-I","-S",f"/proc/self/fd/{descriptor}"],
    os.environ,
)'
docker_args="bash -lc \"set -e; umask 077; mkdir -m 0700 -- $bootstrap_private_directory; (set -C; printf '%s' '$bootstrap_source_b64' | base64 -d > $bootstrap_private_path); EQUINOX_REMOTE_WORKDIR=$persistent_work_directory EQUINOX_WORKLOAD_FILE=$workload_file EQUINOX_RL_MODEL_ID=$model_id EQUINOX_RL_SEED=$optimization_seed EQUINOX_RL_TARGET_SECONDS=$target_runtime_seconds EQUINOX_RL_MAX_RESUME_GAP_SECONDS=$retry_reserve_seconds EQUINOX_RL_MAX_UPDATES=$maximum_updates EQUINOX_RL_VALIDATION_EXAMPLES=$validation_examples EQUINOX_RL_TEST_EXAMPLES=$test_examples EQUINOX_RL_MASTERY_WINDOWS=$mastery_windows EQUINOX_RL_TRAINING_TASKS_PER_UPDATE=$training_tasks_per_update EQUINOX_RL_REPLAY_TASKS_PER_LEVEL=$replay_tasks_per_level EQUINOX_RL_MAX_FINAL_EVALUATION_RESERVE_SECONDS=$maximum_final_evaluation_reserve_seconds EQUINOX_STUDY_CONDITION=$study_condition EQUINOX_STUDY_VALIDATION_SEED_BASE=$study_validation_seed_base EQUINOX_STUDY_TEST_SEED_BASE=$study_test_seed_base EQUINOX_STUDY_COMPLETION_BUDGET=$study_completion_budget EQUINOX_RUNPOD_MAX_WORKLOAD_ATTEMPTS=$maximum_workload_attempts EQUINOX_LARGER_MODEL_AUTHORIZATION_DIGEST=$larger_model_authorization_digest EQUINOX_LARGER_MODEL_EXPECTED_SNAPSHOT_DIGEST=$larger_model_expected_snapshot_digest EQUINOX_RUNPOD_NETWORK_VOLUME_ID=$network_volume_id EQUINOX_EXPECTED_GPU_ID='$gpu_id' EQUINOX_MINIMUM_GPU_MEMORY_GB=$minimum_gpu_memory_gb HF_HOME=$model_cache_directory HUGGINGFACE_HUB_CACHE=$model_cache_directory/hub HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python3 -I -S -c '$bootstrap_exec_code' $bootstrap_private_path ${bootstrap_source_digest#sha256:}\""

provider_pods() {
  local pods
  if ! pods="$(run_provider_command 15 runpodctl pod list --all)"; then
    return 1
  fi
  if [[ -z "$pods" ]] ||
    ! jq -e \
    'type == "array"
      and all(.[];
        type == "object"
        and (.id | type) == "string"
        and (.id | length) > 0
        and (.name | type) == "string"
        and (.name | length) > 0
      )' \
    >/dev/null 2>&1 <<<"$pods"; then
    return 1
  fi
  printf '%s\n' "$pods"
}

provider_current_spend() {
  local account
  if ! account="$(run_provider_command 15 runpodctl user)"; then
    return 1
  fi
  if [[ -z "$account" ]]; then
    return 1
  fi
  jq -er \
    'if (.currentSpendPerHr | type) == "number" and .currentSpendPerHr >= 0
     then .currentSpendPerHr
     else error("invalid currentSpendPerHr")
     end' \
    <<<"$account"
}

provider_network_volumes() {
  local volumes
  if ! volumes="$(run_provider_command 15 runpodctl network-volume list)"; then
    return 1
  fi
  if [[ -z "$volumes" ]] ||
    ! jq -e \
    'type == "array"
      and all(.[];
        type == "object"
        and (.id | type) == "string"
        and (.id | length) > 0
        and (.dataCenterId | type) == "string"
        and (.dataCenterId | length) > 0
        and (.size | type) == "number"
        and .size > 0
      )' \
    >/dev/null 2>&1 <<<"$volumes"; then
    return 1
  fi
  printf '%s\n' "$volumes"
}

provider_has_no_pods() {
  local pods
  pods="$(provider_pods)" &&
    jq -e 'length == 0' >/dev/null 2>&1 <<<"$pods"
}

provider_network_volume_inventory_matches() {
  local volumes
  if [[ -z "$larger_model_mode" ]]; then
    return 1
  fi
  if ! volumes="$(provider_network_volumes)"; then
    return 1
  fi
  jq -e \
    --arg volume_id "$network_volume_id" \
    --arg data_center_id "$network_volume_data_center_id" \
    --argjson volume_size "$network_volume_verified_size_gb" \
    '
      length == 1
      and .[0].id == $volume_id
      and .[0].dataCenterId == $data_center_id
      and .[0].size == $volume_size
    ' >/dev/null 2>&1 <<<"$volumes"
}

provider_current_spend_is_allowed() {
  local spend
  if ! spend="$(provider_current_spend)"; then
    return 1
  fi
  if [[ -n "$larger_model_mode" ]]; then
    jq -en \
      --argjson spend "$spend" \
      --argjson maximum "$maximum_storage_only_hourly_spend" \
      '$spend <= $maximum' >/dev/null 2>&1
  else
    jq -en --argjson spend "$spend" '$spend == 0' >/dev/null 2>&1
  fi
}

provider_live_stage_campaign_is_allowed() {
  local account
  if [[ -z "$larger_model_mode" ]]; then
    return 0
  fi
  if ! account="$(run_provider_command 15 runpodctl user)"; then
    return 1
  fi
  jq -e \
    --arg baseline "$campaign_baseline_balance_usd" \
    --arg budget "$campaign_authorized_budget_usd" \
    --arg pilot_reserve "$campaign_future_pilot_reserve_usd" \
    --arg storage_reserve "$campaign_storage_reserve_usd" \
    --argjson allocation_cap "$maximum_total_cost" \
    --argjson storage_hourly_cap "$maximum_storage_only_hourly_spend" \
    '
      (.clientBalance | tonumber) as $current_balance
      | (.currentSpendPerHr | tonumber) as $current_hourly
      | ($baseline | tonumber) as $baseline_balance
      | ($budget | tonumber) as $authorized_budget
      | ($pilot_reserve | tonumber) as $future_pilot
      | ($storage_reserve | tonumber) as $storage
      | $current_balance >= 0
        and $current_balance <= $baseline_balance
        and $current_hourly >= 0
        and $current_hourly <= $storage_hourly_cap
        and (
          ($baseline_balance - $current_balance)
          + $allocation_cap
          + $future_pilot
          + $storage
        ) <= $authorized_budget
    ' >/dev/null 2>&1 <<<"$account"
}

provider_idle_state_is_safe() {
  provider_has_no_pods || return 2
  if [[ -n "$larger_model_mode" ]] &&
    ! provider_network_volume_inventory_matches; then
    return 3
  fi
  provider_current_spend_is_allowed || return 4
  provider_has_no_pods || return 2
}

provider_managed_volume_is_absent() {
  local volumes
  [[ -n "$larger_model_mode" ]] || return 1
  volumes="$(provider_network_volumes)" &&
    jq -e --arg volume_id "$network_volume_id" \
      'all(.[]; .id != $volume_id)' \
      >/dev/null 2>&1 <<<"$volumes"
}

provider_has_zero_spend() {
  local spend
  spend="$(provider_current_spend)" &&
    jq -en --argjson spend "$spend" '$spend == 0' >/dev/null 2>&1
}

provider_market_price_attestation() {
  python3 - \
    "$gpu_id" \
    "$maximum_hourly_cost" \
    "$cloud_type" \
    "$network_volume_data_center_id" <<'PY'
import json
import os
import pathlib
import re
import stat
import sys
import urllib.parse
import urllib.request
from datetime import datetime, timezone

gpu_id, maximum_text, cloud_type, data_center_id = sys.argv[1:]
config_path = pathlib.Path.home() / ".runpod" / "config.toml"
fixture = os.environ.get("EQUINOX_RUNPOD_MARKET_PRICE_FIXTURE")
fixture_mode = bool(fixture and os.environ.get("PYTEST_CURRENT_TEST"))
try:
    if fixture_mode:
        api_key = "test-only-market-fixture-key"
        api_url = "https://api.runpod.io/graphql"
    else:
        metadata = config_path.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or stat.S_IMODE(metadata.st_mode) & 0o077
            or metadata.st_size <= 0
            or metadata.st_size > 16 * 1024
        ):
            raise ValueError
        source = config_path.read_text(encoding="utf-8")
        values = {}
        for line in source.splitlines():
            match = re.fullmatch(
                r'\s*([A-Za-z][A-Za-z0-9_]*)\s*=\s*"([^"\\]*)"\s*',
                line,
            )
            if match:
                values[match.group(1).lower()] = match.group(2)
        api_key = values.get("apikey")
        api_url = values.get("apiurl", "https://api.runpod.io/graphql")
    maximum = float(maximum_text)
    if (
        not api_key
        or not re.fullmatch(r"[A-Za-z0-9_-]{20,256}", api_key)
        or api_url != "https://api.runpod.io/graphql"
        or not maximum > 0
        or cloud_type != "SECURE"
        or not re.fullmatch(r"[A-Z]{2}-[A-Z0-9-]{2,32}", data_center_id)
    ):
        raise ValueError
    query = (
        "query LowestPrice($input: GpuLowestPriceInput!) { gpuTypes { "
        "lowestPrice(input: $input) { gpuTypeId stockStatus "
        "uninterruptablePrice availableGpuCounts } } }"
    )
    if fixture_mode:
        payload = json.loads(pathlib.Path(fixture).read_text(encoding="utf-8"))
    else:
        request = urllib.request.Request(
            api_url + "?api_key=" + urllib.parse.quote(api_key, safe=""),
            data=json.dumps(
                {
                    "query": query,
                    "variables": {
                        "input": {
                            "gpuCount": 1,
                            "secureCloud": True,
                            "dataCenterId": data_center_id,
                        }
                    },
                },
                separators=(",", ":"),
            ).encode(),
            headers={"content-type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(request, timeout=15) as response:
            if response.status != 200:
                raise ValueError
            payload = json.load(response)
    if set(payload) != {"data"} or not isinstance(payload["data"], dict):
        raise ValueError
    gpu_types = payload["data"].get("gpuTypes")
    if not isinstance(gpu_types, list):
        raise ValueError
    offers = [
        gpu.get("lowestPrice")
        for gpu in gpu_types
        if isinstance(gpu, dict)
        and isinstance(gpu.get("lowestPrice"), dict)
        and gpu["lowestPrice"].get("gpuTypeId") == gpu_id
    ]
    if len(offers) != 1:
        raise ValueError
    offer = offers[0]
    price = offer.get("uninterruptablePrice") if isinstance(offer, dict) else None
    counts = offer.get("availableGpuCounts") if isinstance(offer, dict) else None
    stock = offer.get("stockStatus") if isinstance(offer, dict) else None
    if (
        offer.get("gpuTypeId") != gpu_id
        or isinstance(price, bool)
        or not isinstance(price, (int, float))
        or not 0 < price <= maximum
        or not (
            counts is None
            or (
                isinstance(counts, list)
                and all(isinstance(count, int) and not isinstance(count, bool) for count in counts)
                and 1 in counts
            )
        )
        or stock not in {"Low", "Medium", "High"}
    ):
        raise ValueError
    print(
        json.dumps(
            {
                "schema_version": 1,
                "revision": "runpod-jit-market-price-attestation@1",
                "gpu_id": gpu_id,
                "cloud_type": cloud_type,
                "gpu_count": 1,
                "data_center_id": data_center_id,
                "stock_status": stock,
                "available_gpu_counts": counts,
                "uninterruptable_price_usd_per_hour": price,
                "maximum_hourly_cost_usd": maximum,
                "attested_at": datetime.now(timezone.utc)
                .isoformat(timespec="seconds")
                .replace("+00:00", "Z"),
            },
            allow_nan=False,
            separators=(",", ":"),
            sort_keys=True,
        )
    )
except Exception:
    print("RunPod market-price attestation failed closed.", file=sys.stderr)
    raise SystemExit(1)
PY
}

persist_network_volume_deletion_state() {
  if [[ "$operator_lock_acquired" != true ||
    ! -f "$operator_lock_directory/lease.json" ]]; then
    return 0
  fi
  jq \
    --argjson deletion_attempted "$network_volume_deletion_attempted" \
    --argjson deletion_confirmed "$network_volume_deletion_confirmed" \
    --argjson deletion_deadline_met "$network_volume_deletion_deadline_met" \
    --arg deleted_at "$network_volume_deleted_at" \
    '. + {
      network_volume_deletion_attempted: $deletion_attempted,
      network_volume_deletion_confirmed: $deletion_confirmed,
      network_volume_deletion_deadline_met: $deletion_deadline_met,
      network_volume_deleted_at: (
        if $deleted_at == "" then null else $deleted_at end
      )
    }' \
    "$operator_lock_directory/lease.json" |
    durable_write_stdin "$operator_lock_directory/lease.json"
}

confirm_managed_network_volume_deletion() {
  local force_deletion="${1:-false}"
  local volume
  local delete_attempt
  local retry_deadline_epoch
  local current_epoch
  local consecutive_safe=0
  if [[ "$force_deletion" != true ]] &&
    [[ "$network_volume_deletion_required" != true ||
      "$pod_create_attempted" != true ]]; then
    return 0
  fi
  if [[ "$network_volume_deletion_deadline_epoch" -le 0 ||
    -z "$network_volume_deletion_deadline" ]]; then
    return 1
  fi

  if volume="$(
    run_provider_command 15 runpodctl network-volume get "$network_volume_id" 2>/dev/null
  )"; then
    if ! jq -e \
      --arg volume_id "$network_volume_id" \
      --arg data_center_id "$network_volume_data_center_id" \
      --argjson volume_size "$network_volume_verified_size_gb" \
      '
        (.networkVolume // .) as $volume
        | ($volume.id // $volume.networkVolumeId) == $volume_id
          and $volume.dataCenterId == $data_center_id
          and $volume.size == $volume_size
      ' >/dev/null 2>&1 <<<"$volume" ||
      ! provider_network_volume_inventory_matches; then
      return 1
    fi
    for delete_attempt in 1 2 3; do
      network_volume_deletion_attempted=true
      persist_network_volume_deletion_state || true
      if run_provider_command 15 \
        runpodctl network-volume delete "$network_volume_id" >/dev/null 2>&1; then
        break
      fi
      if ((delete_attempt < 3)); then
        sleep 2
      fi
    done
  elif ! provider_managed_volume_is_absent; then
    return 1
  fi

  retry_deadline_epoch=$(($(date +%s) + network_volume_deletion_retry_seconds))
  while (( $(date +%s) < retry_deadline_epoch )); do
    current_epoch="$(date +%s)"
    if provider_has_no_pods &&
      provider_managed_volume_is_absent &&
      provider_has_zero_spend; then
      consecutive_safe=$((consecutive_safe + 1))
    else
      consecutive_safe=0
    fi
    if ((consecutive_safe >= 3)); then
      network_volume_deletion_confirmed=true
      network_volume_deleted_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      if ((current_epoch <= network_volume_deletion_deadline_epoch)); then
        network_volume_deletion_deadline_met=true
      fi
      persist_network_volume_deletion_state || true
      disarm_volume_expiry_guard_service
      return 0
    fi
    sleep 5
  done
  persist_network_volume_deletion_state || true
  return 1
}

write_volume_expiry_guard_state() {
  local phase="$1"
  local owner_pid="$2"
  local owner_proof_id="$3"
  local guarded_pod_id="${4:-}"
  local now_epoch
  local now
  if [[ "$volume_expiry_guard_active" != true ||
    -z "$volume_expiry_guard_state_path" ]]; then
    return 0
  fi
  now_epoch="$(date +%s)"
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  jq -cnS \
    --arg guard_id "$volume_expiry_guard_id" \
    --arg phase "$phase" \
    --argjson owner_pid "$owner_pid" \
    --arg proof_id "$owner_proof_id" \
    --arg pod_id "$guarded_pod_id" \
    --argjson heartbeat_epoch "$now_epoch" \
    --arg updated_at "$now" \
    '{
      schema_version: 1,
      revision: "runpod-network-volume-expiry-state@1",
      guard_id: $guard_id,
      phase: $phase,
      owner_pid: $owner_pid,
      proof_id: $proof_id,
      pod_id: (if $pod_id == "" then null else $pod_id end),
      heartbeat_epoch: $heartbeat_epoch,
      updated_at: $updated_at
    }' |
    durable_write_stdin "$volume_expiry_guard_state_path"
  volume_expiry_guard_phase="$phase"
}

touch_volume_expiry_guard() {
  if [[ "$volume_expiry_guard_active" == true &&
    "$volume_expiry_guard_phase" =~ ^(screen-running|pilot-running)$ ]]; then
    write_volume_expiry_guard_state \
      "$volume_expiry_guard_phase" "$$" "$proof_id" "$pod_id"
  fi
}

disarm_volume_expiry_guard_service() {
  if [[ -n "$volume_expiry_guard_service_label" ]]; then
    launchctl bootout \
      "gui/$(id -u)/$volume_expiry_guard_service_label" \
      >/dev/null 2>&1 || true
  fi
  if [[ -n "$volume_expiry_guard_service_plist" ]]; then
    python3 - "$volume_expiry_guard_service_plist" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
parent = pathlib.Path.home() / "Library" / "LaunchAgents"
if path.parent != parent or not path.name.startswith("io.equinox.runpod-volume-guard."):
    raise SystemExit("refusing to remove an unexpected launch agent")
path.unlink(missing_ok=True)
PY
  fi
}

start_volume_expiry_guard_process() {
  local pid_path="$volume_expiry_guard_directory/guard-process.json"
  local ready_path="$volume_expiry_guard_directory/guard-ready.json"
  local service_mode="${EQUINOX_RUNPOD_VOLUME_GUARD_SERVICE_MODE:-launchd}"
  local service_target
  local ready_deadline
  if [[ ! -x "$volume_expiry_guard_program_path" ]]; then
    echo "The network-volume expiry guard is not executable." >&2
    return 1
  fi
  rm -f -- "$ready_path"
  if [[ "$service_mode" == "process" ]]; then
    if [[ -z "${PYTEST_CURRENT_TEST:-}" ]]; then
      echo "The process-only volume guard is restricted to the test harness." >&2
      return 1
    fi
    nohup /usr/bin/python3 "$volume_expiry_guard_program_path" \
      "$volume_expiry_guard_directory" \
      >>"$volume_expiry_guard_directory/guard.log" 2>&1 </dev/null &
    volume_expiry_guard_pid="$!"
  elif [[ "$service_mode" == "launchd" && "$(uname -s)" == "Darwin" ]]; then
    volume_expiry_guard_service_label="io.equinox.runpod-volume-guard.$network_volume_id"
    volume_expiry_guard_service_plist="$(
      python3 - "$volume_expiry_guard_service_label" <<'PY'
import pathlib
import sys

print(pathlib.Path.home() / "Library" / "LaunchAgents" / f"{sys.argv[1]}.plist")
PY
    )"
    mkdir -p "$(dirname "$volume_expiry_guard_service_plist")"
    python3 - \
      "$volume_expiry_guard_service_plist" \
      "$volume_expiry_guard_service_label" \
      /usr/bin/python3 \
      "$volume_expiry_guard_program_path" \
      "$volume_expiry_guard_directory" <<'PY'
import os
import pathlib
import plistlib
import sys
import tempfile

destination = pathlib.Path(sys.argv[1])
label, interpreter, program, guard_directory = sys.argv[2:]
payload = {
    "Label": label,
    "ProgramArguments": [interpreter, program, guard_directory],
    "RunAtLoad": True,
    "KeepAlive": {"SuccessfulExit": False},
    "ProcessType": "Background",
    "ThrottleInterval": 10,
    "StandardOutPath": str(pathlib.Path(guard_directory) / "guard.log"),
    "StandardErrorPath": str(pathlib.Path(guard_directory) / "guard.log"),
}
descriptor, pending_name = tempfile.mkstemp(prefix=".equinox-guard-", dir=destination.parent)
try:
    os.fchmod(descriptor, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        plistlib.dump(payload, handle, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(pending_name, destination)
finally:
    try:
        os.unlink(pending_name)
    except FileNotFoundError:
        pass
PY
    service_target="gui/$(id -u)/$volume_expiry_guard_service_label"
    launchctl bootout "$service_target" >/dev/null 2>&1 || true
    if ! launchctl bootstrap "gui/$(id -u)" "$volume_expiry_guard_service_plist" ||
      ! launchctl kickstart -k "$service_target"; then
      echo "The restartable network-volume guard service could not be loaded." >&2
      return 1
    fi
    volume_expiry_guard_pid=0
  else
    echo "A restartable launchd volume guard is required on the operator host." >&2
    return 1
  fi
  ready_deadline=$(($(date +%s) + 15))
  while (( $(date +%s) < ready_deadline )); do
    if [[ -f "$ready_path" ]] &&
      jq -e --arg guard_id "$volume_expiry_guard_id" \
        '.guard_id == $guard_id and .ready == true and (.pid | type) == "number"' \
        "$ready_path" >/dev/null 2>&1; then
      volume_expiry_guard_pid="$(jq -r '.pid' "$ready_path")"
      break
    fi
    sleep 1
  done
  if [[ ! "$volume_expiry_guard_pid" =~ ^[1-9][0-9]*$ ]] ||
    ! kill -0 "$volume_expiry_guard_pid" 2>/dev/null; then
    echo "The network-volume expiry guard did not acknowledge readiness." >&2
    return 1
  fi
  jq -cnS \
    --arg guard_id "$volume_expiry_guard_id" \
    --argjson pid "$volume_expiry_guard_pid" \
    --arg started_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    '{
      schema_version: 1,
      revision: "runpod-network-volume-expiry-process@1",
      guard_id: $guard_id,
      pid: $pid,
      started_at: $started_at
    }' |
    durable_write_stdin "$pid_path"
  if [[ "$service_mode" == "process" ]]; then
    disown "$volume_expiry_guard_pid" 2>/dev/null || true
  fi
}

arm_screen_volume_expiry_guard() {
  local retention_seconds
  local runpodctl_path
  local created_at
  if [[ "$larger_model_mode" != "screen" ]]; then
    return 0
  fi
  retention_seconds="$(
    python3 - \
      "$campaign_storage_reserve_usd" \
      "$maximum_storage_only_hourly_spend" <<'PY'
from decimal import Decimal, InvalidOperation, ROUND_FLOOR
import sys

try:
    reserve = Decimal(sys.argv[1])
    hourly = Decimal(sys.argv[2])
except InvalidOperation as error:
    raise SystemExit("invalid storage reserve") from error
if reserve <= 0 or hourly <= 0:
    raise SystemExit("storage reserve and hourly cap must be positive")
seconds = int((reserve * Decimal(3600) / hourly).to_integral_value(rounding=ROUND_FLOOR))
if seconds < 60:
    raise SystemExit("storage handoff reserve is too small")
print(seconds)
PY
  )"
  volume_expiry_guard_deadline_epoch="$(($(date +%s) + retention_seconds))"
  volume_expiry_guard_deadline="$(
    python3 - "$volume_expiry_guard_deadline_epoch" <<'PY'
from datetime import UTC, datetime
import sys

print(
    datetime.fromtimestamp(int(sys.argv[1]), UTC)
    .isoformat(timespec="seconds")
    .replace("+00:00", "Z")
)
PY
  )"
  network_volume_deletion_deadline_epoch="$volume_expiry_guard_deadline_epoch"
  network_volume_deletion_deadline="$volume_expiry_guard_deadline"
  volume_expiry_guard_id="$(
    python3 -c 'import secrets; print(secrets.token_hex(32))'
  )"
  runpodctl_path="$(command -v runpodctl)"
  if [[ "$runpodctl_path" != /* ||
    ! "$volume_expiry_guard_id" =~ ^[0-9a-f]{64}$ ]]; then
    echo "The network-volume expiry guard identity is invalid." >&2
    return 1
  fi
  mkdir -p "$volume_expiry_guard_root"
  chmod 700 "$volume_expiry_guard_root"
  volume_expiry_guard_directory="$volume_expiry_guard_root/$network_volume_id"
  if ! mkdir -m 700 "$volume_expiry_guard_directory"; then
    echo "An unresolved expiry guard already owns this exact network volume." >&2
    return 1
  fi
  volume_expiry_guard_contract_path="$volume_expiry_guard_directory/contract.json"
  volume_expiry_guard_state_path="$volume_expiry_guard_directory/state.json"
  volume_expiry_guard_program_path="$volume_expiry_guard_directory/guard-program.py"
  if ! install -m 500 \
      "$repository_root/scripts/runpod-volume-expiry-guard" \
      "$volume_expiry_guard_program_path"; then
    echo "The immutable private volume-guard program could not be installed." >&2
    return 1
  fi
  volume_expiry_guard_program_digest="$(
    python3 - "$volume_expiry_guard_program_path" <<'PY'
import hashlib
import pathlib
import sys

print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())
PY
  )"
  volume_expiry_guard_active=true
  created_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if ! jq -cnS \
      --arg guard_id "$volume_expiry_guard_id" \
      --arg screen_proof_id "$proof_id" \
      --arg volume_id "$network_volume_id" \
      --arg data_center_id "$network_volume_data_center_id" \
      --argjson size_gb "$network_volume_verified_size_gb" \
      --argjson storage_hourly_cap_usd "$maximum_storage_only_hourly_spend" \
      --argjson storage_reserve_usd "$campaign_storage_reserve_usd" \
      --arg created_at "$created_at" \
      --arg expires_at "$volume_expiry_guard_deadline" \
      --argjson expires_at_epoch "$volume_expiry_guard_deadline_epoch" \
      --arg runpodctl_path "$runpodctl_path" \
      --arg guard_program_path "$volume_expiry_guard_program_path" \
      --arg guard_program_digest "$volume_expiry_guard_program_digest" \
      '{
        schema_version: 1,
        revision: "runpod-network-volume-expiry@1",
        guard_id: $guard_id,
        screen_proof_id: $screen_proof_id,
        volume_id: $volume_id,
        data_center_id: $data_center_id,
        size_gb: $size_gb,
        storage_hourly_cap_usd: ($storage_hourly_cap_usd + 0),
        storage_reserve_usd: ($storage_reserve_usd + 0),
        created_at: $created_at,
        expires_at: $expires_at,
        expires_at_epoch: $expires_at_epoch,
        runpodctl_path: $runpodctl_path,
        guard_program_path: $guard_program_path,
        guard_program_digest: $guard_program_digest
      }' |
      durable_create_stdin "$volume_expiry_guard_contract_path" ||
    ! write_volume_expiry_guard_state "screen-running" "$$" "$proof_id" "" ||
    ! start_volume_expiry_guard_process; then
    echo "The exact cross-process network-volume expiry lease could not be armed." >&2
    return 1
  fi
  fsync_directory "$volume_expiry_guard_directory"
  fsync_directory "$volume_expiry_guard_root"
}

attach_pilot_volume_expiry_guard() {
  local verified_guard
  if [[ "$larger_model_mode" != "pilot" ]]; then
    return 0
  fi
  volume_expiry_guard_directory="$volume_expiry_guard_root/$network_volume_id"
  volume_expiry_guard_contract_path="$volume_expiry_guard_directory/contract.json"
  volume_expiry_guard_state_path="$volume_expiry_guard_directory/state.json"
  if ! verified_guard="$(
    python3 - \
      "$volume_expiry_guard_directory" \
      "$source_screen_publication_id" \
      "$network_volume_id" \
      "$network_volume_data_center_id" \
      "$network_volume_verified_size_gb" <<'PY'
import hashlib
import json
import os
import pathlib
import stat
import sys
import time

root = pathlib.Path(sys.argv[1])
screen_id, volume_id, data_center_id, size_gb = sys.argv[2:]


def load(name, fields):
    path = root / name
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0),
    )
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or not 0 < metadata.st_size <= 64 * 1024:
            raise SystemExit("guard evidence is not a bounded regular file")
        payload = os.read(descriptor, metadata.st_size + 1)
    finally:
        os.close(descriptor)
    value = json.loads(payload)
    canonical = (
        json.dumps(
            value,
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        ).encode()
        + b"\n"
    )
    if not isinstance(value, dict) or set(value) != fields or payload != canonical:
        raise SystemExit("guard evidence contract mismatch")
    return value


contract = load(
    "contract.json",
    {
        "schema_version",
        "revision",
        "guard_id",
        "screen_proof_id",
        "volume_id",
        "data_center_id",
        "size_gb",
        "storage_hourly_cap_usd",
        "storage_reserve_usd",
        "created_at",
        "expires_at",
        "expires_at_epoch",
        "runpodctl_path",
        "guard_program_path",
        "guard_program_digest",
    },
)
state = load(
    "state.json",
    {
        "schema_version",
        "revision",
        "guard_id",
        "phase",
        "owner_pid",
        "proof_id",
        "pod_id",
        "heartbeat_epoch",
        "updated_at",
    },
)
if (
    contract["schema_version"] != 1
    or contract["revision"] != "runpod-network-volume-expiry@1"
    or contract["screen_proof_id"] != screen_id
    or contract["volume_id"] != volume_id
    or contract["data_center_id"] != data_center_id
    or contract["size_gb"] != int(size_gb)
    or contract["expires_at_epoch"] <= int(time.time())
    or pathlib.Path(contract["guard_program_path"]) != root / "guard-program.py"
    or not pathlib.Path(contract["guard_program_path"]).is_file()
    or hashlib.sha256(
        pathlib.Path(contract["guard_program_path"]).read_bytes()
    ).hexdigest()
    != contract["guard_program_digest"]
    or state["schema_version"] != 1
    or state["revision"] != "runpod-network-volume-expiry-state@1"
    or state["guard_id"] != contract["guard_id"]
    or state["phase"] != "awaiting-pilot"
):
    raise SystemExit("pilot network-volume guard handoff mismatch")
print(
    json.dumps(
        {
            "guard_id": contract["guard_id"],
            "expires_at": contract["expires_at"],
            "expires_at_epoch": contract["expires_at_epoch"],
            "guard_program_path": contract["guard_program_path"],
            "guard_program_digest": contract["guard_program_digest"],
        },
        separators=(",", ":"),
        sort_keys=True,
    )
)
PY
  )"; then
    echo "The pilot could not take over the exact screened volume-expiry lease." >&2
    return 1
  fi
  volume_expiry_guard_id="$(jq -r '.guard_id' <<<"$verified_guard")"
  volume_expiry_guard_deadline="$(jq -r '.expires_at' <<<"$verified_guard")"
  volume_expiry_guard_deadline_epoch="$(jq -r '.expires_at_epoch' <<<"$verified_guard")"
  volume_expiry_guard_program_path="$(jq -r '.guard_program_path' <<<"$verified_guard")"
  volume_expiry_guard_program_digest="$(jq -r '.guard_program_digest' <<<"$verified_guard")"
  network_volume_deletion_deadline="$volume_expiry_guard_deadline"
  network_volume_deletion_deadline_epoch="$volume_expiry_guard_deadline_epoch"
  volume_expiry_guard_active=true
  # Start a fresh recovery watcher rather than trusting a persisted PID that
  # may have been reused. Multiple watchers share the same immutable contract
  # and may only delete the same exact volume after the same deadline/failure.
  if ! start_volume_expiry_guard_process; then
    return 1
  fi
  write_volume_expiry_guard_state "pilot-running" "$$" "$proof_id" ""
}

