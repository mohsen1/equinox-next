  )"
  larger_model_source_contract_digest="$(
    jq -r '.source_contract_digest' <<<"$verified_source_contract"
  )"
  if [[ ! "$larger_model_source_contract_digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
