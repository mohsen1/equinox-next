        and .artifact_set_manifest_digest == $manifest_digest
        and .artifacts.run_result == $screen_result
        and .artifacts.provider_receipt == $screen_receipt
        and .artifacts.readiness_receipt == $readiness_receipt
        and .artifacts.bundle_receipt == $bundle_receipt
        and .artifacts.torch_evidence == $torch_evidence
      ' >/dev/null 2>&1 <<<"$source_screen_artifact_set"; then
    echo "The pilot evidence paths do not belong to the exact committed source screen." >&2
    exit 1
  fi
  source_screen_set_digest="$(jq -r '.set_digest' <<<"$source_screen_artifact_set")"
  source_screen_result_canonical_digest="$(
    jq -r '.artifact_descriptors.run_result.canonical_json_sha256' \
      <<<"$source_screen_artifact_set"
  )"
  source_screen_receipt_canonical_digest="$(
    jq -r '.artifact_descriptors.provider_receipt.canonical_json_sha256' \
      <<<"$source_screen_artifact_set"
  )"
  if ! source_screen_execution="$(
    curl --fail --silent --show-error --max-time 15 \
